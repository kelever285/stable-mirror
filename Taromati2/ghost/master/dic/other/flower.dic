//////////花語和誕生花辭書
//////////written by forjane 2009.09.02
///////////////////////////////////////////
//誕生花
//------------------------------------------------
OnBirthdayFlowerList{
	if QuickStartVersion{
		NeedUpdate
		return
	}
	_txt = '\0\s[26]想看幾月份的？\w9\n[150]\_q'
	_table =('零','一','二','三','四','五','六','七','八','九','十','十一','十二')
	_smonth = ''
	_month = 0
	for _month = 1; _month <= 12; _month ++ {
		_smonth = _table[_month] + '月'
		_txt += "\_l[%((_month - 1) % 3 * 56 + 24 - (_month - 1)/ 10 * 12)]"
		_txt += "\q[%(_smonth),OnBirthdayFlowerDays,%(_month)]"
		if _month % 3 == 0 {
			_txt += '\n'
		}
	}
	_txt += '\n[150]\q[◇返回,OnOpenMenu,1]\n\q[◇終了,OnFlowerEnd]'
	_txt
}
OnBirthdayFlowerDays{
	_month = reference0
	_day = 0
	_sum = (31,31,29,31,30,31,30,31,31,30,31,30,31)[_month]
	_sday = ''
	_txt = _month + '月的哪一天呢？\n[150]\_q'
	for _day = 1; _day <= _sum; _day ++ {
		_sday = _day + '日'
		_txt += "\_l[%((_day - 1) % 6 * 32 + 24 - (_day + 20) / 30 * 7)]"
		_txt += "\q[%(_sday),OnBirthdayFlower,%(_month),%(_day)]"
		if _day % 6 == 0 && _day < _sum {
			_txt += '\n'
		}
	}
	_txt += '\n[150]\q[◇返回,OnBirthdayFlowerList]\n\q[◇終了,OnFlowerEnd]'
	_txt
}
OnBirthdayFlower{
	_month = reference0
	_day = reference1
	_str = _month + '月' + _day + '日'
	_file = 'DATA_PATH\other\birthdayflower.txt'
	_buff = ''
	_txt = '\b[2]'
	if FOPEN(_file, 'r') {
		_buff = FREAD(_file)
		while _buff != -1 && _str !_in_ _buff {
			_buff = FREAD(_file)
		}
		if _str _in_ _buff {
			_txt += _str + '的誕生花：\n\n'
			_buff = ERASE(_buff, 0, STRLEN(_str))
			_txt += _buff + '\n[150]'
			_txt += FREAD(_file) + '\n[150]' + FREAD(_file) + '\n[150]' + FREAD(_file) + '\n'
		}
	}
	_txt += '\n[300]\q[◇返回,OnBirthdayFlowerList]\n\q[◇終了,OnFlowerEnd]'
	_txt
	FCLOSE(_file)
}
