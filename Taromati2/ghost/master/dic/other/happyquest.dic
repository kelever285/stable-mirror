///////////////////////////////////////////
//////////開心知識問答遊戲辭書
//////////written by forjane 2009.09.02
///////////////////////////////////////////
OnQuestBegin{
	if QuickStartVersion
		NeedUpdate
	else{
		CountQuests
		questcount = 1
		_txt = '\0\s[40]要來挑戰一下開心知識問答嗎？\w9\n'
		if ISVAR('questrecord') > 0 {
			_txt += "現在連續回答正確的最高紀錄是%(questrecord)題喔～\w9\w9\w9"
		}
		_txt += '\c' + ShowQuest(RAND(questnum))
		_txt
	}
}
ShowQuest{
	_txt = '\0\b[1]第' + questcount + '題：\n[150]'
	_temp = LoadQuest(_argv[0])
	_quest =_temp[0, '#']
	_answer = _temp[1, '#']
	_txt += _quest + '\n\n\_q'
	for _i = 2; _temp[_i, '#'] != ''; _i++ {
		_txt += '\q[◇' + _temp[_i, '#'] + ',OnQuestAnswered,' + SUBSTR(_temp[_i, '#'], 0, 1) + ',' + _answer + ']\n'
	}
	_txt += '\![set,choicetimeout,0]'
	_txt
}
OnQuestAnswered{
	if reference0 == reference1 {
		questcount ++
		ShowQuest(RAND(questnum))
	}
	else {
		if questcount > 10 {
			intimacy ++
		}
		if questrecord < questcount - 1 {
			questrecord = questcount - 1
			'\0\s[2]哇！\w9\w9你創造了新的記錄…\w9…\w9\w9'
			"\0\s[2]新的記錄喔，\w9你連續答對了%(questrecord)題耶！\w9"
			--
			'\1\s[12]不要太得意。\w9\s[10]'
			'\1\s[12]下次就沒這麼好運了。\w9\s[10]'
			''
		}
		elseif questrecord == questcount - 1 {
			'\0\s[5]不錯喔，\w9平了你的最好成績呢。\w9'
			'\0\s[5]可惜了，\w9差一點破紀錄…\w9…\w9'
			--
			'\1\s[12]下次就沒這麼好運了。\w9\s[10]'
			''
		}
		elseif questcount - 1 > questrecord / 2 {
			'\0\s[35]好可惜喔…\w9…\w9'
			'\0\s[35]啊…\w9…\w9'
			--
			"還差%(questrecord + 1 - questcount)題就成功了。\w9"
			"離最好成績還差%(questrecord + 1 - questcount)題而已。\w9"
			--
			'\1\s[11]這種稀奇古怪的題目，\w9能答對才怪。\w9\s[10]\0\s[8]\n[150]果然還是太難了點嗎？\w9'
			'\1\s[11]你不要太為難他啦。\w9\s[10]'
		}
		elseif questcount < 2 {
			'\0\s[8]不是吧，\w9一上來就錯了…\w9…\w9'
			'\0\s[8]…\w9…\w9你有認真在想嗎？\w9\1\s[11]才怪。\w9\s[10]'
			'\0\s[8]這題目…\w9…\w9對你來說，\w9太難了嗎？\w9'
			'\0\s[8]…\w9…\w9\1\s[11]這種稀奇古怪的題目，\w9能答對才怪。\w9\s[10]\0\s[8]\n[150]果然還是太難了點嗎？\w9'
		}
		else {
			'\0\s[2]你確定是這個答案嗎？\w9\w9'
			'\0\s[2]那個…\w9…\w9雖然不願意說，\w9答案不是這個喔。\w9'
			'\0\s[2]再仔細想想看…\w9…\w9'
			'\0\s[26]別灰心！\w9'
		}
		--
		'\0\n[450]\q[◇重來,OnQuestBegin]\n[150]\q[◇返回上一層,OnOpenMenu,2]\n\q[◇終了,OnQuestEnd]\n\![set,choicetimeout,0]'
	}
}
OnQuestEnd{
	'\0\s[2]不玩了嗎？\w9好可惜喔…\w9…'
}
CountQuests{
	_file = 'DATA_PATH\other\happyquest.txt'
	questnum = 0
	_buff = ''
	FCHARSET(1)
	if FOPEN(_file,'r') {
		_buff = FREAD(_file)
		while _buff != -1 && SUBSTR(_buff, 0, 1) != '#' {
			_buff = FREAD(_file)
		}
		while _buff != -1 {
			_buff = FREAD(_file)
			_buff = FREAD(_file)
			questnum ++
			_buff = FREAD(_file)
			while _buff != -1 && SUBSTR(_buff, 0, 1) != '#' {
				_buff = FREAD(_file)
			}
		}
		FCLOSE(_file)
	}
	FCHARSET.default
	questnum
}
LoadQuest{
	_file = 'DATA_PATH\other\happyquest.txt'
	_quest = ''
	_buff = ''
	FCHARSET(1)
	if FOPEN(_file,'r') {
		_buff = FREAD(_file)
		while _buff != -1 && SUBSTR(_buff, 0, 1) != '#' {
			_buff = FREAD(_file)
		}
		for _i = 0; _i < _argv[0]; _i++ {
			_buff = FREAD(_file)
			_buff = FREAD(_file)
			_buff = FREAD(_file)
			while _buff != -1 && SUBSTR(_buff, 0, 1) != '#' {
				_buff = FREAD(_file)
			}
		}
		_buff = FREAD(_file)
		_quest = _buff + FREAD(_file)
		FCLOSE(_file)
	}
	FCHARSET.default
	_quest
}
