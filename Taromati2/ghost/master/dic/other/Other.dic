OnAutoShortcut{
	_InProcess='千千靜聽|ttplayer.exe*QQ|qq.exe*QQ遊戲|qqgame.exe*KMPlayer|kmplayer.exe*金山詞霸|xdict.exe*迅雷|thunder.exe*記事本|notepad.exe*記事本|notepad2.exe*UltraEdit|uedit32.exe*Microsoft Visual Studio|devenv.exe*IE流覽器|iexplore.exe*photoshop|photoshop.exe*Dreamweaver|dreamweaver.exe*Flash|flash.exe*Fireworks|fireworks.exe*酷狗音樂|kugoo.exe*飛信|fetionfx.exe*快車|flashget.exe*快車|flashget3.exe*計算器|calc.exe*系統畫圖|mspaint.exe*虛擬光碟機|daemon.exe*steam|steam.exe*Notepad++|notepad++.exe*'
	_x=10//初始
	_y=58//初始
	_w=''
	_FullData=''
	_NoclueonN=''
	void CALLSAORI('Process')
	_ProcessData=TOLOWER(valueex0)
	SETDELIM(_ProcessData,'*')
	SETDELIM(_InProcess,'*')
	foreach _InProcess; _s {
		_Name=_s[1,'|']
		if "|%(_Name)|" !_in_ shortcutdata && "%(_Name)*" !_in_ NoclueonProcess && "%(_Name)|" _in_ _ProcessData {
			foreach _ProcessData; _p {
				if _Name==_p[0,'|'] && _Name !_in_ _NoclueonN {
					_N=_s[0,'|']
					_Path=_p[2,'|']
					_FullData+="%(_N)|%(_Name)|%(_Path)*"
					_NoclueonN+="%(_Name)*"
					_w+="\_l[%(_x),%(_y)]\__q[OnShortcutName,AutoShortcut,%(_N)|%(_Name)|%(_Path)]\_b[%(CHR(34))%(_Path),0%(CHR(34)),inline%(ICOMode)]\_l[%(_x+35),%(_y)]\![*]軟體: 【%(_N)】\__q\_l[%(_x+35),%(_y+20)]%(_Path)"
					_y+=45
				}
			}
		}
	}
	if _w!=''
		"\![set,windowstate,stayontop]\![set,choicetimeout,60000]\0\s[26]\b[2]\_n橘花檢測到下面的軟體哦！\n要把軟體添加到橘花的快顯功能表上嗎？\_q\n[140]　\![*]\q[全部添加,OnAllShortcutAdd,%(_FullData)]　\![*]\q[不再提示下面的軟體,OnNoclueonProcess,%(_NoclueonN)]　\![*]\q[暫時不,OnShortcutOver]%(_w)\![set,windowstate,!stayontop]"
}
OnAllShortcutAdd{
	shortcutdata+=reference0
	_w=''
	SETDELIM(reference0,'*')
	_x=10//初始
	_y=25//初始
	foreach reference0; _s {
		_p=_s[2,'|']
		_N=_s[0,'|']
		if _N
			_w+="\_l[%(_x),%(_y)]\_b[%(CHR(34))%(_p),0%(CHR(34)),inline%(ICOMode)]\_l[%(_x+35),%(_y)]軟體：【%(_N)】\_l[%(_x+35),%(_y+20)]路徑為：%(_p)"
		_y+=45
	}
	"\b[2]\_n橘花已經記住下面軟體的快捷了哦！\_q%(_w)\n[160]　\![*]\q[返回,OnShortcutMenu]　\![*]\q[退出,OnShortcutOver]"
