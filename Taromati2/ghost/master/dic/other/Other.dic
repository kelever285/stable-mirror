Onautojeachday{
	days=daysfromdate(year-1,12,31)
	_i=days%210
	autojeachday(_i)
}
autojeachday{
	_i=_argv[0]
	_str = _i + '.'
	_next = _i + 1 + '.'
	_file = 'DATA_PATH\vocabulary\Japanese\動漫日語每天一句.txt'
	_buff = ''
	_txt = '\1\s[10]\0\s[40]'
	FCHARSET(1)
	if FOPEN(_file, 'r') {
		_buff = FREAD(_file)
		while _buff != -1 && _str !_in_ _buff {
			_buff = FREAD(_file)
		}
		if _str _in_ _buff {
			_txt +="動漫日語每天一句\n/
			%(year)年第%(days)天、第%(_i)句\n\n"
			_buff = FREAD(_file)
			while _buff != -1 && _next !_in_ _buff {
				_txt += _buff + '\n'
				_buff = FREAD(_file)
			}
		}
		FCLOSE(_file)
		_txt
	}
	FCHARSET.default
}
Onacjeachday{
	_i=reference0
	if _argv[0]
		_i=_argv[0]
	if _i==NULL || !ISINTEGER(_i)
		_i=1
	_str = _i + '.'
	_next = _i + 1 + '.'
	_file = 'DATA_PATH\vocabulary\Japanese\動漫日語每天一句.txt'
	_buff = ''
	_txt = '\C\_q\c\b[2]\![quicksession,true]\![set,choicetimeout,0]\![set,autoscroll,false] '
	_txt+='\q[◇今天的句子,Ondaysentence]\n'
	_txt+=Onautojeachday
	_txt+='\n[300]'
	FCHARSET(1)
	if FOPEN(_file, 'r') {
		_buff = FREAD(_file)
		while _buff != -1 && _str !_in_ _buff {
			_buff = FREAD(_file)
		}
		if _str _in_ _buff {
			_txt +="第%(_i)句的內容\n\n"
			_buff = FREAD(_file)
			while _buff != -1 && _next !_in_ _buff {
				_txt += _buff + '\n'
				_buff = FREAD(_file)
			}
		}
	}
	FCLOSE(_file)
	FCHARSET.default
	if _i==1{
		_txt += "\_l[-,250]\n\n\_l[120,-]\![*]\q[第%(_i)句,Oninputsentence,%(_i)]\_l[240,-]\![*]\q[下一句,Onnextsentence,%(_i)]"
	}
	elseif _i>=250{
		_txt += "\_l[-,250]\n\n\![*]\q[上一句,Onlastsentence,%(_i)]\_l[120,-]\![*]\q[第%(_i)句,Oninputsentence,%(_i)]"
	}
	elseif _i>1{
		_txt +=  "\_l[-,250]\n\n\![*]\q[上一句,Onlastsentence,%(_i)]\_l[120,-]\![*]\q[第%(_i)句,Oninputsentence,%(_i)]\_l[240,-]\![*]\q[下一句,Onnextsentence,%(_i)]"
	}
	_txt += '\n[300]\q[◇返回上一層,japanesestudy]\n\q[◇終了,OnOpenMenu,1]'
	_txt
}
Oninputsentence{
	"\![set,choicetimeout,0]共有210句，要看第幾句？\![open,sliderinput,Onacjeachday,-1,%(reference0),1,210]\n/
	\n[150]/
	\q[◇返回,Onacjeachday,%(reference0)]"
}
Onnextsentence{
	Onacjeachday(reference0+1)
}
Onlastsentence{
	Onacjeachday(reference0-1)
}
Ondaysentence{
	days=daysfromdate(year-1,12,31)
	Onacjeachday(days%210)
}
On100SentencesInJapanese{
	if QuickStartVersion{
		NeedUpdate
		return
	}
	_str = ''
	_next = ''
	_buff = ''
	_i=1
	_j=1
	_b=''
	_v=''
	_file = 'DATA_PATH\vocabulary\Japanese\日本語100句.txt'
	_w='\C\![quicksession,true]\c\0\s[26]\b[2]\![set,choicetimeout,0]正在學習日語一百句，點擊試聽可以聽到語句哦\n'
	if reference0
		_i=reference0
	if reference1
		_j=reference1
	if _argv[1]
		_j=_argv[1]
	_mt = "\f[color,110,110,110] ◢ 只播放點擊(當前狀態)\_l[155,-]\f[color,100,10,220]\q[◥ 順序播放,On100SentencesInJapanese_X,%(_i),%(_j)]\_l[240,-]\f[color,250,0,0]\q[■ 停止,On100SentencesInJapanese_s,,%(_j)]\f[default] \n[150] "
	if reference0 {
		_v='\![sound,wait]'
		_b=reference0
	}
	if _argv[0] {
		_v='\![sound,wait]'
		_b=_argv[0]
		_mt= "\f[color,100,10,220]\q[◢ 只播放點擊,On100SentencesInJapanese_s]\_l[100,-]\f[color,110,110,110]◥ 順序播放(當前狀態)\_l[240,-]\f[color,250,0,0]\q[■ 停止,On100SentencesInJapanese_s,,%(_j)]\f[default] \n[150] "
	}
	_w+="%(_mt)"
	if FOPEN(_file, 'r'){
		_buff = FREAD(_file)
		while _buff != -1 && "%(_j)" !_in_ _buff{
			_buff += FREAD(_file)
		}
		for _i=_j;_i<_j+5;_i++{
			_str =_i + '.'
			_next =_i + 1 + '.'
			if "%(_str)" _in_ _buff{
				_w +="第%(_i)句的內容\f[color,194,243,99]\q[◇試聽,On100SentencesInJapanese_s,%(_i),%(_j)]\f[default]\n"
				if _b==_i
					_v="\![sound,play,DATA_PATH\LearnJapanese\100_sentences_in_Japanese\%(_b).mp3]%(_v)"
				_buff = FREAD(_file);  while _buff != -1 && "%(_next)" !_in_ _buff{
					if _b==_i
						_buff = '\f[color,194,243,99]' + _buff + '\f[default]'
					_w += _buff + '\n'
					_buff = FREAD(_file)
				}
			}
		}
	}
	_Page=''
	if _j!=1
		_Page+="\_l[0,320]\q[<<上一頁,On100SentencesInJapanese,,%(_j-5)]\n"
	if _j+7<64
		_Page+="\_l[60,320]\q[下一頁>>,On100SentencesInJapanese,,%(_j+5)]\n"
	_w += _Page + "\n\q[◇返回上一層,japanesestudy]\n\q[◇終了,OnOpenMenu,1]\![quicksession,false]%(_v)"
	FCLOSE(_file)
	_w
}
On100SentencesInJapanese_s{
	'\![sound,stop]'+On100SentencesInJapanese
}
On100SentencesInJapanese_X{
	_w='\![sound,stop]'
	_i=reference0
	_j=reference1
	if _argv[0]
		_i=_argv[0]
	if _argv[1]
		_j=_argv[1]
	while _i<=65{
		if _i>=_j+5
			_j+=5
		_w+=On100SentencesInJapanese(_i,_j)
		_i++
	}
	_w
}
OnPass{
	_argv[0]
}
