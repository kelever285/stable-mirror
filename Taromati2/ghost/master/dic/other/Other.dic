			//_w+="\_l[%(_x),%(_y)]\__q[OnShortcut,%(_Name),%(_Path),2]\_b[%(CHR(34))%(_Path),0%(CHR(34)),inline%(ICOMode)]\_l[%(_x+35),%(_y)]\![*]軟體%(_i): 【%(_Name)】\__q\q[◇複製,Ontemp111,%(_Name)]\_l[%(_x+35),%(_y+20)]%(_Path)"
			_y+=45
		}
