	elseif _w=='' && reference0=='ShortcutNew'
		_w="\n[200]\_q沒有需要更新的軟體快捷呢，\n[120]%(username)沒有把要更新路徑的軟體打開嗎？\1我看不是沒運行軟體，而是根本沒有要更新的吧……"
	if reference0=='ShortcutNew'
		"\![set,choicetimeout,60000]\_q\b[2]\![set,autoscroll,false]%(username)，橘花已經把下面的軟體快捷更新了哦！\n[150]　\![*]\q[返回,OnShortcutMenu]　\![*]\q[退出,OnShortcutOver]\_n%(_w)"
	else
		"\![set,choicetimeout,60000]\_q\b[2]\![set,autoscroll,false]請%(username)點擊需要設置快捷的軟體！沒有的話，%(username)先運行要設置快捷的軟體，再刷新一次看看！！也可以把要設快捷的檔直接拖給橘花哦！\n[130]　\![*]\q[刷新列表,OnShortcutAdd]　　\![*]\q[返回,OnShortcutMenu]　\![*]\q[退出,OnShortcutOver]\_n%(_w)"
}
