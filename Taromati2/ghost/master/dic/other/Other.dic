//----- On_balloon_tooltip ------------------------------------------------------------------------------------------
//注意，On_balloon_tooltip不能重複，如果你的橘花已經存在On_balloon_tooltip函數，請自行修改。
On_balloon_tooltip{
	if reference1=='OnCalendar'
		"%(reference2)"
	if reference1=='OnMonsterInfo'
		"%(怪物名字)屬性攻擊有效率：\n/
		水：%(TOINT(100*水有效率))\n/
		火：%(TOINT(100*火有效率))\n/
		土：%(TOINT(100*土有效率))\n/
		風：%(TOINT(100*風有效率))"
	if reference1=='OnLinkBar'
		"還剩%(reference2)秒"
	if reference1=='Oniteminfo'
		"%(reference3)"
	if reference1=='OnFriendBirthDay.Inform'
		"%(reference3)"
	if reference1=='OnLinkWndOption'{
		if reference2=='LinkBall'
			"%(reference4)"
	}
	if reference1=='OnUnoCardfollow'{
		"%(reference2)"
	}
	if reference1=='OnTest'{
		"%(reference0),%(reference1),%(reference2),%(reference3)"
	}
	//快顯功能表
	if reference1=='OnShortcut' || reference1=='OnShortcutMenuDel'||(reference1=='OnShortCutList'&&reference7=='fileorder'&&reference8=='order'){
		if reference3==reference5
			"%(reference3)\n%(reference2)"
		else
			"%(reference3)\n%(reference5)\n%(reference2)"
	}
	elseif reference1=='OnShortcutAdd' && reference2=='ShortcutNew'
		'如果某個軟體的路徑變了怎麼辦？\n先把那個軟體打開再點刷新吧！'
	elseif reference1=='OnICOMode'
		'可以設置圖示為透明或不透明模式！'
	if reference1=='OnSelectMusic'
		"%(reference3)"
	if reference1=='OnBookmarkLoad'
		"%(reference4)"
	if reference1=='OnAgendaEvent'||reference1=='OnEventSelect'
		"%(reference6)"
	if reference1=='OnAgendaMark'
		"%(reference5)"
	if reference1=='OnAgenda'&&reference5=='show'
		"%(reference8)"
	if reference1=='OnEventEdit'
		"%(reference9)"
	if reference1=='OnEventEditSet'&&(reference6=='soundmode'||reference6=='appmode')
		"%(reference8)"
	if reference1=='OnEventInput'
		"%(reference8)"
}
//---- 軟體快捷[2011-4-28]_by KikkaAIdb ------------------------------------------------------------------------------
//①可以先把要添加快捷的軟體打開，再到清單裡面添加快捷，不用知道軟體路徑；
//②也可以直接把exe檔直接拖到橘花身上添加快捷；
//③資料夾和硬碟各分區也是可以設置快捷的，只能以拖給橘花的方式設置，提供一些圖示供資料夾設置；
//④至於相同名稱的軟體，在清單裡不會重複出現，但可以用把軟體拖給橘花的方式設置，但刷新路徑的時候會都會更新吧；
//⑤可以自由設置軟體、資料夾的名稱；
//⑥一些常用軟體會自動檢測，不過只是做了這個功能，暫時記錄的常用軟體並不多……，需要的可以自行添加，很簡單的；
//⑦可以隨時刷新路徑改變的軟體，自動記錄新路徑；
//添加：可以從進程中獲取軟體路徑，從而添加軟體快捷；
//刪除：實現軟體快捷的單個刪除或全部刪除；
//刷新：軟體路徑改變後，先打開該軟體，再點擊刷新，可以自動記錄新路徑；
//模式：圖示是否透明，...
//Process.dll外掛程式請放到 saori 下...；
//調用OnShortcutMenu即可；
#define		CFGPATH       'PROFILE_PATH\shortcutdata.sccfg'
#define		DATPATH       'PROFILE_PATH\shortcutdata.scdat'
OnShortcutMenu{
	shortcut=1
	LoadShortCutCfg
	_w='\C\![quicksession,true]\c\![set,choicetimeout,0]\b[2]快顯功能表\n[140]\![*]\q[添加,OnShortcutAdd]　\![*]\q[刪除,OnShortcutMenu,ShortcutMenuDel]　\![*]\q[刷新,OnShortcutAdd,ShortcutNew]　\![*]\q[模式,OnICOMode]　\![*]\q[返回,OnOpenMenu,3]　\![*]\q[退出,OnShortcutOver]'
	_w+='\n'
	_xc=5//初始
	_y=45//初始
	_x=_xc
	_windowshortcut='/
	我的文件|::{450D8FBA-AD25-11D0-98A8-0800361B1103}|15|a*/
	我的電腦|::{20D04FE0-3AEA-1069-A2D8-08002B30309D}|16|a*/
	網上鄰居|::{208D2C60-3AEA-1069-A2D7-08002B30309D}|17|a*/
	回收站|::{645FF040-5081-101B-9F08-00AA002F954E}|18|a*/
	Internet Explorer|::{871C5380-42A0-1069-A2EA-08002B30309D}|19|a*/
	控制台|::{20D04FE0-3AEA-1069-A2D8-08002B30309D}\::{21EC2020-3AEA-1069-A2DD-08002B30309D}|20|a*/
	工作管理員|taskmgr.exe*/
	記事本|notepad.exe*/
	畫圖|mspaint.exe*/
	'
	_path = CALLSAORI('advanced_sysinfo','get_special_folder_path','Windows')
	_file = REPLACE(_path,'\','\\') + '\\explorer.exe'
	//_Icofile = REPLACE(_path,'\','\\') + '\\system32\\shell32.dll'
	_Icofile = _path+'\System32\imageres.dll'
	_mode=0
	_OSMX='OnShortcut'
	_OSCL='load'
	_OSOD=''
	_OSEX=''
	SETDELIM(_windowshortcut,'*')
	for _i=0;_windowshortcut[_i]!='';_i++{
		_s=_windowshortcut[_i]
		_Name=_s[0,'|']
		_Ref=_s[1,'|']
		if '::' !_in_ _Ref{
			_file = REPLACE(_path,'\','\\') +'\\system32\\'+_Ref
			_mode=1
		}
		_Path=_file
		_Ico=TOINT(_s[2,'|'])
		if _Ico>0
			_w+="\__q[%(_OSMX),%(_Path),%(_Name),%(_mode),%(_Ref),%(_i),%(_OSEX)]\_b[%(CHR(34))%(_Icofile),%(_Ico)%(CHR(34)),inline%(ICOMode)]\__q"
		else
			_w+="\__q[%(_OSMX),%(_Path),%(_Name),%(_mode),%(_Ref),%(_i),%(_OSEX)]\_b[%(CHR(34))%(_Path),0%(CHR(34)),inline%(ICOMode)]\__q"
	}
	_w+='\n[half]\![*]\q[添加文件,OnShortCutListAdd,file]   \![*]\q[導入配置,OnShortCutListAdd,openlist]   \![*]\q[匯出配置,OnShortCutListAdd,savelist]   \![*]\q[匯出項目,OnShortCutListAdd,savemenu]\n\![*]\q[新建項目,OnShortCutListAdd,newmenu]   \![*]\q[添加項目,OnShortCutListAdd,addmenu]   \![*]\q[打開項目,OnShortCutListAdd,openmenu]   \![*]\q[檔排序,OnShortCutList,fileorder] \n[150]'
	if reference0=='ShortcutMenuDel' {
		_w="\C\![quicksession,true]\c\b[2]請%(username)點擊需要刪除的快捷！\n[150]　\![*]\q[全部刪除,OnShortcutMenuDel,AllShortcutDel,會把快捷全部刪掉哦！]　\![*]\q[返回,OnShortcutMenu]　\![*]\q[退出,OnShortcutOver]\n"
		_OSMX='OnShortcutMenuDel'
		_OSCL='ShortcutMenuDel'
	}
	elseif reference0=='fileorder' {
		_t='昇冪,降冪'[shortcutfileorder]
		_w="\C\![quicksession,true]\c\b[2]請%(username)點擊需要排序的快捷！\n[150]　\![*]當前為\q[%(_t),OnShortCutList,fileorder,shortcutfileorder]　\![*]\q[返回,OnShortcutMenu]　\![*]\q[退出,OnShortcutOver]\n"
		_OSCL='fileorder'
		_OSMX='OnShortCutList'
		_OSOD='load'
		_OSEX='fileorder,order'
	}
	if shortcutlist==''
		_w+='\n[200]沒有資料哦！……'
	else {
		_xc=_x//初始
		_y=45//初始
		_x=_xc
		_TabItemCount=ARRAYSIZE(shortcutlistname)
		for _i=0;_i<_TabItemCount;_i++{
			if _i==shortcutlistdat
				_w+="\__q[OnShortCutList,%(_OSCL),%(_i),%(_OSOD)]\f[color,238,50,95]"+shortcutlistname[_i]+'\f[color,default]\__q'
			else
				_w+="\__q[OnShortCutList,%(_OSCL),%(_i),%(_OSOD)]"+shortcutlistname[_i]+'\__q'
			_w+= "\_l[195]\__q[OnShortCutList,renamelist,%(_i)]重命名\_l[240]\__q[OnShortCutList,listup,%(_i)]\[↑\__q\__q[OnShortCutList,listdown,%(_i)]↓\__q\__q[OnShortCutList,listdelete,%(_i)]刪]\__q\f[color,default]\n"
		}
		_w+='\n[half]'
		SETDELIM(shortcutdata,'*')
		for _i=0;shortcutdata[_i]!='';_i++ {
			_s=shortcutdata[_i]
			_Name=_s[0,'|']
			_Name2=_s[1,'|']
			_Path=_s[2,'|']
			_fileext = TOLOWER(SPLITPATH(_Path)[3])
			_Ico=TOINT(_s[3,'|'])
			_Mode=_s[4,'|']
			_mode=1
			if _Mode=='url'
				_mode=3
			if _fileext=='.txt'&&quickbookread
				_mode=4
			if _Ico>0
				_w+="\__q[%(_OSMX),%(_Path),%(_Name),%(_mode),%(_Name2),%(_i),%(_OSEX)]\_b[%(CHR(34))%(_Icofile),%(_Ico)%(CHR(34)),inline%(ICOMode)]\__q"
			else
				_w+="\__q[%(_OSMX),%(_Path),%(_Name),%(_mode),%(_Name2),%(_i),%(_OSEX)]\_b[%(CHR(34))%(_Path),0%(CHR(34)),inline%(ICOMode)]\__q"
			_x+=40
		}
	}
	_w
}
OnShortCutList{
	_i=reference1
	if reference0=='load'||reference0=='ShortcutMenuDel'||reference2=='load'{
		shortcutlistdat=_i
