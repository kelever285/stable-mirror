//----------------------稱呼-----------------------------------------
//first time
OnGetUsernameFirst{
	_name = reference.raw[0]
	if OnUserName.IsMazo || OnUserName.IsTooClose || OnUserName.IsCharacterName || OnUserName.IsTooLong {
		"\0\s[2]\w9欸\w9.\w9.\w9.\s[8]那樣的稱呼、\w8我做不到。\w9\w9\n/
		如果可以的話、\w8請讓我用其他的稱呼方式吧。\n/
		\q[◇跳過,Cancel,with_sakura,%(SakuraScriptArgConverter('\![close,inputbox,OnGetUsernameFirst]'))]/
		\![set,balloontimeout,0]\![open,inputbox,OnGetUsernameFirst,-1,%(SakuraScriptArgConverter(username))]"
	}
	if !_name{
		if username
			"那麼日後就稱呼為“%(username)”了哦。"
		else
			'\0\s[6]這樣啊…\w9\w9\s[100]\n那請您想說時再告訴我喔。'
		--
		OnGetUsernameFirst.End
	}
	elseif (_t = OnUserName.SpecialCheck)!='' {
		OnUserName.Set(_name)
		"\0\s[0]『%(username)』是嗎。"
		--
		_t
		--
		OnGetUsernameFirst.End
	}
	else{
		OnUserName.Set(_name)
		"\0\s[0]『%(username)君』\w4這樣可以嗎？\n\n\q[◇可以,OnGetUsernameFirst.Addkeigo]\n\q[%(SakuraScriptArgConverter('◇『'+username+'』就行了')),OnGetUsernameFirst.Fin]"
	}
}
OnGetUsernameFirst.Addkeigo{
	OnUserName.Set("%(username)君")
	--
	OnGetUsernameFirst.Fin
}
OnGetUsernameFirst.Fin{
	"\0\s[0]『%(username)』是嗎。"
	--
	OnGetUsernameFirst.End
}
OnGetUsernameFirst.End{
	'\w9\w9\w9\n[150]\0\s[6]那麼再一次…\w9\s[26]\n[150]橘花和斗和、以後請多多指教。\1\s[10]多指教啦。\w9\0\s[30]\n[150]…終於開口了。\w9\w9\c'
}
GetSteamUserName{
	CALLSAORI('steam_api','GetMostRecentUserPersonaName')
}

//common
OnUserNameChange{
	"\0\s[26]那麼、該怎麼稱呼呢？\![open,inputbox,OnUserNameInput,-1,%(SakuraScriptArgConverter(username))]"
}
OnUserNameInput{
	_name = reference.raw[0]
	if OnUserName.IsCharacterName{
		_simplified_name = TOLOWER(TOSIMPLIFIED(_name))
		case _simplified_name{
			when '橘花','kikka'{
				'\0\s[0]橘花嗎\w9…\w9…\w9…？\w9\n/
				\s[8]和我重名可是不行的哦？\w9\w9\n/
				\1\s[10]會讓人分不清是在叫哪個人所以禁止。\w9\w9\w9\n/
				\0\s[0]請您想一個其他的名字吧。\w9\n[150]'
			}
			when '斗和','towa'{
				'\0\s[0]斗和嗎\w9…\w9…\w9…？\w9\n\s[8]和她重名會讓我們在談話時很困擾\w9，可以想一個其他的名字嗎？\w9\n[150]'
				if nurturance.Darkness >= 200
					'\0\s[20]兩個斗和啊\w9，會叫混唉？\n\w9\w9\1\s[12]換一個不行嗎？\w9\w9\n/
					\0\s[32]說的有道理。\w9\w9\w9\n/
					\1\s[11]\w9是說換一個名字不是換一個人的意思\w9\n/
					\0\s[2]啊\w9\s[20]、是這個意思嗎？\w9\w9\n/
					\1\s[10]你這傢伙明明很清楚啊\w9\n/
					\0\n[half]'
			}
			others
				BUGNow('未對應的角色名稱'+_name)
		}
		--
		'\q[◇返回上一層,OnOpenMenu,4]\n/
		\q[◇終了,OptionEnd]'
		return
	}
	if _name == username {
		'\0\s[0]………？\s[26]\n不用改變也可以嗎？\n[150]/
		\q[◇返回上一層,OnOpenMenu,4]\n/
		\q[◇終了,OptionEnd]'
	}
	elseif !_name {
		"\0\s[6]好的。\w9\s[0]\n那麼、往後就用\w9\s[26]\n『無名氏』\w9來稱呼喔。\w9\w9\n[150]/
		\s[5]…\w9開玩笑的。\n/
		\w9\s[0]\n繼續稱呼『%(username)』就可以了嗎\w9？\n[150]/
		\q[◇返回上一層,OnOpenMenu,4]\n/
		\q[◇終了,OptionEnd]"
	}
	elseif OnUserName.IsTooLong {
		'\0\s[0]'
		--
		if STRLEN(_name) < 30 //太長不念
			"『%(_name)』嗎。\n[150]"
		--
		'\s[8]這個名字'
		--
		if STRLEN(_name) > 50
			'有點太……\w9長了吧？'
		elseif STRLEN(_name) > 30
			'有點長呢。'
		else
			'稍微有點長呢。'
		--
		'\n/
		\w9\s[20]\n可以換一個短一點的名字嗎\w9？\n[150]/
		\q[◇返回上一層,OnOpenMenu,4]\n/
		\q[◇終了,OptionEnd]'
	}
	elseif _name==GetSteamUserName && !(IsUsername.Mazo(_name) || IsUsername.TooClose(_name)) {
		"\0\s[0]『%(_name)』是嗎。\n[150]/
		\s[5]以steam用戶名來稱呼也不錯呢。\n"
		--
		OnUserName.Set(_name)
		--
		'\n/
		\q[◇返回上一層,OnOpenMenu,4]\n/
		\q[◇終了,OptionEnd]'
	}
	elseif INARRAY(UsualUserName,_name){
		_index=ARRAY.GetIndex(UsualUserName,_name)
		//_longest=ARRAY.GetlongestContinuousPresence(UsualUserName,_name)
		_size=ARRAYSIZE(UsualUserName)
		_month=_size-_index
		_year=_month/12
		//if _longest > 13{

		//}
		if _name==UsualUserName[_size-1]
			"\0\s[0]%(_name).\w9.\w9.\w9\n/
			\s[26]果然還是叫回來更順口呢？"
		elseif _year
			"\0\s[0]%(_name).\w9.\w9.\w9\n/
			\s[21]讓我回想起了%(_year)年前呢，\s[6]那段時光\w9\n/
			\1\s[11]什麼，不都是混吃等死嗎。\w9\w9\n/
			\0\s[32]\1\s[13]\0/
			.\w9.\w9.\w9"
		elseif _month
			"\0\s[0]%(_name).\w9.\w9.\w9\n/
			\s[21]讓我回想起了%(_month)月前呢，\s[6]那段時光\w9\n/
			\1\s[11]什麼，不都是混吃等死嗎。\w9\w9\n/
			\0\s[32]\1\s[13]\0/
			.\w9.\w9.\w9"
		--
		OnUserName.Set(_name)
		--
		'\n/
		\q[◇返回上一層,OnOpenMenu,4]\n/
		\q[◇終了,OptionEnd]'
	}
	elseif (_t = OnUserName.SpecialCheck)!='' {
		if OnUserName.IsTooClose && nurturance.Closeness<100
			'\0\s[2]\w9欸\w9.\w9.\w9.\s[8]那樣的稱呼、\w8我做不到。\w9\w9\n/
			如果可以的話、\w8請讓我用其他的稱呼方式吧。\n/
			'
		else{
			OnUserName.Set(_name)
			_t
		}
		--
		'\q[◇返回上一層,OnOpenMenu,4]\n/
		\q[◇終了,OptionEnd]'
	}
	elseif OnUserName.IsMazo {
		if nurturance.Closeness>=100{
			"\0\s[2]\w9欸\w9.\w9.\w9.\s[8]真的想讓我這樣稱呼你嗎？\w9不是在開玩笑嗎？\w9\w9\n/
			…\w9\s[6]如果你想被這樣稱呼的話、\w8也不是不可以。\w9\n/
			\s[0]但是、\w8\s[26]請不要討厭我哦。\n/
			\n/
			\q[◇確認,OnUserNameConfirmed,%(SakuraScriptArgConverter(_name))]\n/
			\q[◇還是算了,OnUserNameCancel]"
		}else{
			'\0\s[2]\w9欸\w9.\w9.\w9.\s[8]那樣的稱呼、\w8我做不到。\w9\w9\n/
			如果可以的話、\w8請讓我用其他的稱呼方式吧。\n/
			'
			--
			'\q[◇返回上一層,OnOpenMenu,4]\n/
			\q[◇終了,OptionEnd]'
		}
	}
	else{
		"\0\s[26]『%(REPLACE(_name,'\','\\'))君』\w4這樣可以嗎？\n\n/
		\q[◇可以,OnUserNameConfirmed,%(SakuraScriptArgConverter(_name+'君'))]\n/
		\q[%(SakuraScriptArgConverter('◇『'+_name+'』就行了')),OnUserNameConfirmed,%(SakuraScriptArgConverter(_name))]\n[150]/
		\q[◇還是算了,OnUserNameCancel]"
	}
}
OnUserNameCancel{
	"\0\s[0]那麼、仍然叫『%(username)』…\n[150]"
	"\0\s[6]好的。\w9\s[0]\n那麼、就跟目前一樣用\w9\s[26]\n『%(username)』\w9來稱呼喔。\n[150]"
	--
	'\q[◇返回上一層,OnOpenMenu,4]\n/
	\q[◇終了,OptionEnd]'
}
OnUserNameConfirmed{
	_name = reference.raw[0]
	OnUserName.Set(_name)
	"\0\s[6]好的。\w9\s[0]\n[150]那麼、往後就用\w9\s[26]\n『%(username)』\w9來稱呼喔。\n[150]"
	--
	'\q[◇返回上一層,OnOpenMenu,4]\n/
	\q[◇終了,OptionEnd]'
}

//base
OnUserName.Set:void{
	username = REPLACE(_argv[0],'\','\\')
}
//用戶名判定
IsUsername.Empty{
	_simplified_name = TOLOWER(TOSIMPLIFIED(_argv[0]))
	case _simplified_name{
		when 'administrator','user','guest','system','admin','管理員','root','autobvt','microsoft','test',''{
			1
		}
		others{
			0
		}
	}
}
IsUsername.Mazo{
	_simplified_name = TOLOWER(TOSIMPLIFIED(_argv[0]))
	case _simplified_name {
		when '垃圾','豚','豬','垃圾蟲','クズ','クソムシ','笨蛋','白癡','呆子','蠢豬','傻逼','廢物','蠢貨','陽痿','陽痿男','醜男','豬頭男','豬頭','二愣子','二傻子','弱智','腦殘'{
			1
			return
		}
	}
	0
}
IsUsername.TooClose{
	_simplified_name = TOLOWER(TOSIMPLIFIED(_argv[0]))
	case _simplified_name {
		when '親愛的','老公','老公大人','相公','寶貝','爸爸','父','父親','爸','マスター','主人大人','主人','ごしゅじんさま','honey','だぁりん','寶寶','小寶寶','baby','little baby','darling'{
			1
			return
		}
	}
	0
}
IsUsername.TooLong{
	STRLEN(_argv[0])>17
}
IsUserName.Special{
	IsUsername.Empty(_argv[0]) || IsUsername.Mazo(_argv[0]) || IsUsername.TooClose(_argv[0]) || IsUsername.TooLong(_argv[0])
}
OnUserName.IsMazo{
	_name = reference.raw[0]
	IsUsername.Mazo(_name)
}
OnUserName.IsTooClose{
	_name = reference.raw[0]
	IsUsername.TooClose(_name)
}
OnUserName.IsCharacterName{
	_simplified_name = TOLOWER(TOSIMPLIFIED(reference.raw[0]))
	case _simplified_name {
		when '橘花','kikka','斗和','towa'{
			1
			return
		}
	}
	0
}
OnUserName.IsTooLong{
	_name = reference.raw[0]
	IsUsername.TooLong(_name)
}
OnUserName.SpecialCheck{
	_name = reference.raw[0]
	if (_t = OnUserName.SpecialCheck.base)!='' {
		"\0\s[6]好的。\w9\s[0]\n[150]那麼、往後就用\w9\s[26]\n『%(_name)』\w9來稱呼喔。\n[150]\w9\w9"
		--
		_t
		--
		'\w9\0\n\n'
	}
}
OnUserName.SpecialCheck.base{
	_name = reference.raw[0]
	_simplified_name = TOLOWER(TOSIMPLIFIED(_name))
	case _simplified_name {
		when '哥哥','大哥哥','哥','兄長大人','歐尼醬','にぃに','にぃ','兄さま','兄様','あに様'
			"\s[3]\w9我、\w9雖然沒有陪我長大的兄弟姐妹。\w9\s[6]\w9但是你能像疼愛妹妹一樣疼愛我，\w9真的很開心。\w9\w9\n/
			\s[1]\w9\w9%(_name)。"
		when '親愛的'
			'\s[21]親・愛・的…♡。'
		when '老公','老公大人','相公','寶貝'
			"\s[21]%(_name)…♡"
		when '爸爸','父','父親','爸'
			'\s[8]已經把我當成女兒了嗎。\n/
			\1\s[11]\w9呦，\w9可喜可賀可喜可賀\w9\n/
			\0\s[32]\w9.\w9.\w9.\1\4'
		when '醫生','醫師','大夫','郎中','センセー'
			'\1\s[12]喂，\w9這可不是TeachingF⭕⭕⭕ing啊，\w9給我注意點。\w9\w9\0\s[8]什麼啊？'
		when '先輩','前輩','センパイ'
			'\s[20]…是做什麼的前輩呢？'
		when 'マスター','主人大人','主人','ごしゅじんさま'
			'\s[21]主僕play？\1\s[11]\w9.\w9.\w9.你在期待些什麼啊。\w9'
		when '客人','客戶','客官'
			'\s[8]…聽起來怪怪的？'
		when '經紀人','Pさん','プロデューサーさん'
			'\s[8]…偶像？\1\s[12]？\0很抱歉、我不是很清楚這些'
		when '爺爺','爺','大爺'
			'\s[8]感覺把你稱呼的這麼老是不是不太好呢…。'
		when 'honey','だぁりん','darling'
			'\s[1]愛人…\w9\1在街上的話，\w9叫的出來嗎。'
		when '博士','教授','はかせ','きょうじゅ'
			'\s[2]…做什麼研究的嗎？'
		when '隊長','captain'
			'\s[20]難道、曾經在軍隊裡呆過什麼的…？'
		when '寶寶','小寶寶','baby','little baby'
			'\1意外的，\w9最近流行母性蘿莉這種存在啊。\w9\w9\n/
			\0\s[8]欸？\w9\w9\n/
			\1\s[11]你有母性嗎？\w9\w9\w9\n/
			\0就算這樣說\w9.\w9.\w9.'
		when '菊花'
			'\1\s[11]我說，\w9\w9\0\s[30]怎麼了？\w9\w9\n/
			\1\s[13]真的有人的自稱諧音肛門嗎？\0\s[20]\w9.\w9.\w9.\1\4\0\s[32]\n/
			想死是嗎？\1\s[-1]\w9\w9'
		when '用戶名','username'
			'\1\s[12]上一次聽到這樣的名字還是在上一次\w9\0\s[8]？'
		when '索娜·馬薩卡','馬薩卡','nani','娜妮','都系得·哇卡拉奶'
			'\1\s[13]草\w9\0\s[8]？'
	}
}

