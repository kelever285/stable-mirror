///////////////////////////////////////////
//////////鬧鐘功能辭書
//////////written by forjane 2009.09.23
///////////////////////////////////////////
//**** 時間イベント ***************************************************************************************************
OnSecondChange{
	if Speech_Recognition{
		if (_t=VoiceToTxt)!=temp&&(j++)%2==0{
			temp=_t
			_t=AIGet(_t)
			TxtToVoice(_t,voicename)+_t
			j=0
		}
	}
	if mode == '0'{
		if mikireflag == 1 && reference1 == 0{
			EndMikireTalk
		}
		mikireflag = reference1
		if headpatflag == 1{
			if headpattime >= 30{
				headpatcount = 0
				headpatflag = 0
				headpattime = 0
			}
			else{
				headpattime++
			}
		}
		if bustpatflag == 1{
			if bustpattime >= 30{
				bustpatcount = 0
				bustpatflag = 0
				bustpattime = 0
			}
			else{
				bustpattime++
			}
		}
		if bustclickflag == 1{
			if bustclicktime >= 30{
				bustclickcount = 0
				bustclickflag = 0
				bustclicktime = 0
			}
			else{
				bustclicktime++
			}
		}
	}
}
OnHourChange{
}
OnMinuteChange{
	if UsualUserName.Time<=GETSECCOUNT{
		if UsualUserName.InPush!=username
			UsualUserName.InPush=username
		else{//連續一個月使用同一個用戶名
			UsualUserName,=UsualUserName.InPush
			ERASEVAR('UsualUserName.InPush')
			if ARRAYSIZE(UsualUserName) > 960//記錄近80年內的常用用戶名
				UsualUserName[TOINT(SQRT(1.0/RAND(990))*990-30)] = IARRAY//[1,960]，數值越低出現概率越大
		}
		UsualUserName.Time=GETSECCOUNT+1314871
	}
	CloseTime = GETSECCOUNT//防止在OnClose事件中GETSECCOUNT錯誤返回0
	elapsedtimetotal += 1//計算人格起動總時間/單位分
	elapsedtime = elapsedtimetotal * 60
	KikkaGrow
	--
	ClassMonitor
	--
	AlarmMonitor
	--
	ShutdownMonitor
	--
	if specialmode == 'mealtime' && mealendtime < ghostuptime{
		Onmealfin
		return
	}
	--
	if InNotify
		return
	if SHIORI_FW.DebugMode && !SHIORI_FW.EmergencyMode{
		if GETERRORLOG{
			OnErrorLog
			return
		}
	}
	if InSessionLock
		return
	if mode == '0'{
		_boottime = ghostuptime
		if !specialmode{
			if minute == 0{
				if timerm == 0{
					Hourlychime
				}
			}
			elseif hour == 7 && minute == 30{
				"\0\s[5]早晨%(hour)點%(minute)分了，\w4該吃早餐了哦。\n%(Onbreakfast)"
			}
			elseif hour == 12 && minute == 10{
				"\0\s[5]已經%(hour)點%(minute)分了，\w4該吃午餐了哦。\n%(Onlunch)"
			}
			elseif hour == 18 && minute == 10{
				"\0\s[5]已經%(hour)點%(minute)分了，\w4該吃晚餐了哦。\n%(Onsupper)"
			}
			elseif hour == 23 && minute == 30{
				"\0\s[5]現在是%(hour)點%(minute)分，\w9\w4要不要考慮吃個宵夜呢。\n%(Onlatesupper)"
			}
			elseif (_boottime % 3600 <= 60) && _boottime >= 3600{//每啟動滿一小時時開頭一分鐘，第一小時除外
				{
					_worktime = _boottime / 3600
					"\1\s[10]我們連續工作了%(_worktime)小時啊。\w9\s[12]\n把薪水交出來。\w9\w9\0\s[30]不是什麼都沒做嗎。"
					--
					''
					'\w9\w9\1\s[10]\n[150]裝可愛就是貓的工作啊。\w9\w9\0\s[6]\n[150]既然如此、快點開始工作吧。\w9\w9\1\n[150]…\w9…\w9…'
				}
				'\1\s[11]啊゛啊゛啊゛呀─────！！\w9\0\s[30]怎麼了？\w9\w9\1\s[12]\n[150]那個斷掉了─────！！\w9\w9\1\s[-1]\b[-1]\w9\w9\0\s[30]\n[150]…\w9…\w9…\w9\w9\w9\w9\1\s[10]\c呼～～～。\w9\w9\n呃、\w9見笑了。\w9\w9\0\s[8]\n[150]…\w9…\w9…'
				'\![raise,OnSmokingPlace]'
			}
			elseif (memoryload>=80&&TOINT(memorybusyrm[1])==0||memoryload>=TOINT(memorybusyrm[1])&&TOINT(memorybusyrm[1])!=0)&&TOINT(memorybusyrm[0])==0{
				'\0\v\s[33]電腦卡死了，\w9\w9少開點窗口。\n\q[◇打開工作管理員,OnOpenTaskmgr]\![set,trayballoon,--icon=info,--timeout=10,--title=任務繁忙,--text=電腦卡死了，少開點窗口。]'
			}
			elseif minute == 13 && !InUpdate && AutoUpdate == 1{//電腦不卡的情況下每時13分四分之一概率自動更新//選13是因為13不吉利:)
				if QuickStartVersion && !FullDataPackInstalled
					do_nothing
				elseif !RAND(4)
					OnSilentUpdate
			}
			elseif RAND(60)==0 || hitokoto==''
				OnHitokotoUpdate//更新一言
			elseif setting.WeatherReminder && (RAND(60*3)==0)
				OnWeatherUpdate//更新天氣
		}
		elseif specialmode == 'smoking' && _boottime%3600/60 > 4{//最短4
			if !RAND(4) || _boottime%3600/60 > 20//最多20分
				'\![raise,OnSmokingEnd]'
		}
		elseif mikireflag == 1{
			MikireTalk//---- 分 != 0 、かつ見切れていたら見切れ中のトークを行う
		}
		elseif reference2 == 1{
			if kasanariswitch{
				Kasanari//重疊反應
			}
		}
		--
		AgendaMonitor
		--
		if AutoShellChange[0]{
			if TOINT(AutoShellChange[1])==2{
				OnAutoChangeShell
			}
		}
	}
}
ClassMonitor{
	_classrm=OnClassDetailTimeCheck
	if _classrm{
		if InNotify
			OnPlayAlarm
		_classrm+'\n/
		\q[◇稍後提醒,Cancel]\n/
		\q[◇我知道了,OnClassMonitorTempClose]\n/
		'
		--
		_trayballoon="\![set,trayballoon,--icon=info,--timeout=10,--title=課程提醒,--text=%(_classrm),--text=（點擊氣泡稍後提醒）]"
		if InNotify
			SHIORI_FW.MakeValueNotify(_trayballoon)
		else
			_trayballoon
	}
}
AlarmMonitor{
	if alarmset[0] == 'ON' && TOINT(alarmhour) == hour && TOINT(alarmmin) == minute {
		alarmstart = 1
		if alarmset[1] == '當天' {
			alarmset[0] = 'OFF'
		}
	}
	if alarmstart > 0 {
		if alarmset[2] == '聲音' {
			OnPlayAlarm(alarmfile)
			_tmp = "%(username)設定的時間到了"
			if alarmstart > 1 {
				_tmp = "已經超過%(username)設定的時間%(alarmstart - 1)分鐘了"
			}
			alarmstart ++
			"\c\f[bold,true]鬧鐘提醒\f[bold,default]\n[150]現在是%(hour)點%(minute)分\n%(_tmp)！\n（點擊對話方塊關閉提醒）"
		}
		elseif alarmset[2] == '氣泡' {
			_tmp = "%(username)設定的時間到了"
			if alarmstart > 1 {
				_tmp = "已經超過%(username)設定的時間%(alarmstart - 1)分鐘了"
			}
			alarmstart ++
			_trayballoon="\![set,trayballoon,--icon=info,--timeout=10,--title=鬧鐘提醒,--text=現在是%(hour)點%(minute)分,--text=%(_tmp)！,--text=（點擊氣泡關閉提醒）]"
			if InNotify
				SHIORI_FW.MakeValueNotify(_trayballoon)
			else
				_trayballoon
		}
	}
}
OnBalloonClose{
	if alarmstart && '鬧鐘提醒' _in_ reference0 {
		alarmstart = 0
		OnAlarmEnd
	}
}
OnTrayBalloonClick{
	if reference0 == '鬧鐘提醒' {
		alarmstart = 0
		'鬧鐘已關閉'
	}
	elseif reference0 == '關機提醒' {
		shutdownstart = 0
		'關機已取消'
	}
	elseif reference0 == '日程提醒' {
		agendastart = 0
		eventtemp=NULL
	}
	elseif reference0 == '整點報時' {
		if minute>=5 {
			username
			--
			'剛才去哪裡了呢？'
			'剛才在做什麼呢？'
			'終於注意到了啊？'
			--
			'\1呐,不知道...'
			''
		}
		else {
			'嗯嗯～'
			'好的～'
		}
	}
	elseif reference0 == '課程提醒' {
		OnAlarmEnd
		'嗯嗯～'
		'好的～'
	}
	elseif SHIORI_FW.DebugMode{
		"未註冊的氣泡標題“%(reference0)”被觸發了"
	}
	else{
		'嗯嗯～'
		'好的～'
	}
}
OnAlarmMenu{
	AlarmMenu
}
AlarmMenu{
	if !ISVAR('alarmset') {
		alarmset = IARRAY
		alarmset[0] = 'OFF'
		alarmset[1] = '當天'
		alarmset[2] = '聲音'
		alarmhour = 0
		alarmmin = 0
		alarmfile = 'UN_SAORI_path\SOUND_PATH\Ring.mp3'
	}
	'\f[bold,true]\0鬧鐘功能\f[bold,default]\n[150]/
	\![quicksession,1]\![set,choicetimeout,0]'
	--
	"\n[50]鬧鐘時間：\f[color,34,100,200]%(alarmhour)點%(alarmmin)分\f[color,default]\_l[128]\q[◇設定鬧鐘,OnAlarmSetTime]\n[150]"
	--
	if alarmset[0] == 'ON' {
		'鬧鐘開關：\q[◎ON,OnAlarmSet,0,ON]   \q[○OFF,OnAlarmSet,0,OFF]\n'
	}
	else {
		'鬧鐘開關：\q[○ON,OnAlarmSet,0,ON]   \q[◎OFF,OnAlarmSet,0,OFF]\n'
	}
	--
	if alarmset[1] == '當天' {
		'提醒頻率：\q[◎當天提醒,OnAlarmSet,1,當天]   \q[○每天提醒,OnAlarmSet,1,每天]\n'
	}
	else {
		'提醒頻率：\q[○當天提醒,OnAlarmSet,1,當天]   \q[◎每天提醒,OnAlarmSet,1,每天]\n'
	}
	--
	if alarmset[2] == '聲音' {
		'提醒模式：\q[◎播放聲音,OnAlarmSet,2,聲音]   \q[○工作列氣泡,OnAlarmSet,2,氣泡]\n'
	}
	else {
		'提醒模式：\q[○播放聲音,OnAlarmSet,2,聲音]   \q[◎工作列氣泡,OnAlarmSet,2,氣泡]\n'
	}
	--
	"鬧鐘鈴聲：\__q[OnSetAlarmFile]%(SPLITPATH.roughly(alarmfile)[1])\__q"
	--
	'\n[150]\q[◇返回上一層,OnOpenMenu]    \q[◇終了,Cancel]'
}
OnSetAlarmFile{
	'\![open,dialog,open,--id=alarmfile,--title=請選擇音樂檔,--dir=__system_mymusic__,--filter=音樂檔(mid;wav;mp3;au;ogg;wma)|*.mid;*.wav;*.mp3;*.au;*.ogg;*.wma]'
}
DialogSetAlarmFile{
	alarmfile = _argv[0]
	AlarmMenu
}
OnPlayAlarm:void{
	_argv[0]=_argv[0]
	if !_argv[0]
		_argv[0]='UN_SAORI_path\SOUND_PATH\Ring.mp3'
	CALLSAORI('mciaudior', 'stop')
	CALLSAORI('mciaudior', 'load',_argv[0])
	CALLSAORI('mciaudior', 'play')
}
OnAlarmEnd:void{
	CALLSAORI('mciaudior', 'stop')
}
OnAlarmSet{
	alarmset[reference0] = reference1
	AlarmMenu
}
OnAlarmSetTime{
	"\0\s[2]要在什麼時候提醒%(username)呢？"
	--
	"\![open,timeinput,OnAlarmSetComplete,60000,%(hour),%(minute),%(second)]"
}
OnAlarmSetComplete{
	'在'
	--
	if alarmset[1] == '每天'
		'每天的'
	--
	"\f[color,34,100,200]%(reference0[0])點%(reference0[1])分\f[color,default]\w9以%(alarmset[2])的方式提醒。\n\w9這樣可以嗎？\n[200]/
	\_q\q[◆確定,OnAlarmSetConfirmed,1,%(reference0)]    \q[◇取消,OnAlarmSetConfirmed,0]\_q\n"
}
OnAlarmSetConfirmed{
	if reference0 == 1 {
		alarmhour = reference1
		alarmmin = reference2
		alarmset[0] ='ON'
	}
	AlarmMenu
}
//------ 整點報時\[2008-09_by KikkaAIdb] ---------------------------------------------------------------------
Hourlychime{
	'\0\s[0]'
	--
	_trayballoon="\![raise,OnPlayBell]%(Hourlychime.Text)\![set,trayballoon,--timeout=0,--title=整點報時,--text=%(Hourlychime.Text)]"
	if InNotify
		SHIORI_FW.MakeValueNotify(_trayballoon)
	else
		_trayballoon
}
OnTrayBalloonTimeout{
	if reference0 == '課程提醒' {
		do_nothing
	}
	else {
		"%(username)不理橘花呢？"
		"%(username)？"
		"%(username)在做別的事嗎？"
	}
}
OnPlayBell:void{
	CALLSAORI('mciaudior', 'stop')
	CALLSAORI('mciaudior', 'load', 'UN_SAORI_path\SOUND_PATH\bell.wav')
	CALLSAORI('mciaudior', 'play')
}
OnPlayRing:void{
	CALLSAORI('mciaudior', 'stop')
	CALLSAORI('mciaudior', 'load', 'UN_SAORI_path\SOUND_PATH\Ring.mp3')
	CALLSAORI('mciaudior', 'play')
}
Hourlychime.Text{
	Hourlychime.Special
	Hourlychime.Common
}
Hourlychime.Common{
	ANY('', '', '', "%(username).", GreetingPhrase + '..' )
	--
	"現在時間%(Timejud)%(hour12ex)點喔"
	"現在時間已經%(hour)點了喔"
	"已經%(Timejud)%(hour12ex)點了"
	"現在%(hour)點了"
	--
	'？'
}
Hourlychime.Special{
	case hour{
		when 0{
			'淩晨12點'
			--
			'了呢'
			'了'
			''
			--
			'，'
			--
			'又是新的一天～'
			'熬夜這種事也不要一直做哦？'
		}
		when 1-4{
			"%(hour)點了.%(username)"
			--
			'還不睡嗎？'
			'不睡嗎.熬夜會變笨的喔？'
		}
		when 5-6{
			"%(hour)點了..要去看日出嗎？"
			"呼哈～唔..%(hour)點了？"
		}
		when 7-8{
			"%(hour)點了.還沒清醒的話趕快打起精神喔？"
		}
		when 9-11{
			"%(hour)點了..據說是人一天中記憶能力最好的時段呢，要好好利用喔？"
		}
		when 12{
			'12點了.午餐時間～'
		}
		when 13-14{
			"下午%(hour12)點了…總是很想睡的時間呢？"
		}
		when 15-16{
			"%(hour)點了.要不要來杯下午茶呢？"
		}
		when 17-18{
			"下午%(hour12)點.晚餐時間～"
		}
		when 19-23{
			"%(hour)點了.."
			"晚上%(hour12)點了呢.."
			--
			'接下來該做什麼事呢？'
			"%(username)在做什麼呢？"
			"這個時間%(username)應該都在電腦前吧？"
		}
	}
}
GreetingPhrase{
	if hour < 4 || hour > 16	{'晚安';}
	elseif  hour < 10			{'早安';}
	else						{'午安';}
}
//----- 時間判斷 -------------------------------------
Timejud{
	if !_argc
		_argv[0] = hour
	case _argv[0] {
		when 0-4	{ '淩晨'; '半夜'; }
		when 5-7	{ '清晨';'早上'; }
		when 8-10	{ '上午'; }
		when 11-13	{ '中午'; }
		when 14-17	{ '下午'; }
		when 18-19	{ '傍晚'; }
		when 20-22	{ '晚上'; }
		when 23		{ '深夜'; }
	}
}
Seasonjud{
	if !_argc
		_argv[0] = month
	case _argv[0] {
		when 1-2	{ '冬天';}
		when 3-5	{ '春天';}
		when 6-8	{ '夏天';}
		when 9-11	{ '秋天';}
		when 12		{ '冬天';}
	}
}
//---- 啟動天數[2009-3_by KikkaAIdb]★ ---------------------------------------------------------------------------------------------
//其實用GETSECCOUNT來做的話更容易,不過那樣存的參數就不能一目了然了...
daysfromfirstboot{
	_days=0
	_mon=(31,28,31,30,31,30,31,31,30,31,30,31)
	_fy=TOINT(firstboottime[0])
	_fm=TOINT(firstboottime[1])
	_fd=TOINT(firstboottime[2])
	while _fy<=year {
		if _fy%4==0
			_mon[1]=29
		if year==_fy {
			while _fm<month {
				_days+=_mon[_fm-1]
				_fm++
			}
			_days+=day-_fd
		}
		elseif _fy==TOINT(firstboottime[0]) {
			while _fm<=12 {
				_days+=_mon[_fm-1]
				_fm++
			}
			_fm=1
		}
		else {
			if _fy%4==0
				_days++
			_days+=365
		}
		_fy++
	}
	_days
}
//計算日期天數
daysfromdate{
	_days=0
	_mon=(31,28,31,30,31,30,31,31,30,31,30,31)
	_fy=TOINT(_argv[0])
	_fm=TOINT(_argv[1])
	_fd=TOINT(_argv[2])
	while _fy<=year {
		if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
			_mon[1]=29
		if year==_fy {
			while _fm<month {
				_days+=_mon[_fm-1]
				_fm++
			}
			_days+=day-_fd
		}
		elseif _fy==year-1 {
			while _fm<=12 {
				_days+=_mon[_fm-1]
				_fm++
			}
			_fm=1
		}
		else {
			if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
				_days++
			_days+=365
		}
		_fy++
	}
	_fy=TOINT(_argv[0])
	_fm=TOINT(_argv[1])
	_fd=TOINT(_argv[2])
	while _fy>=year {
		if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
			_mon[1]=29
		if year==_fy {
			while _fm>month {
				_days-=_mon[_fm-1]
				_fm--
			}
		}
		elseif _fy==year+1 {
			while _fm>=1 {
				_days-=_mon[_fm-1]
				_fm--
			}
			_fm=12
		}
		else {
			if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
				_days--
			_days-=365
		}
		_fy--
	}
	_days
}
daystodate{
	_days=0
	_mon=(31,28,31,30,31,30,31,31,30,31,30,31)
	_fy=TOINT(_argv[0])
	_fm=TOINT(_argv[1])
	_fd=TOINT(_argv[2])
	_todays=TOINT(_argv[3])
	while _days<_todays{
		if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
			_mon[1]=29
		_fd++
		_days++
		if _fd>_mon[_fm-1]{
			_fd=1
			_fm++
		}
		if _fm>12{
			_fy++
			_fm=1
		}
	}
	_days=0
	while _days>_todays{
		if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
			_mon[1]=29
		_fd--
		_days--
		if _fd<1{
			_fd=_mon[_fm-1]
			_fm--
		}
		if _fm<1{
			_fy--
			_fm=12
		}
	}
	(_fy,_fm,_fd)
}
daysbetweendate{
	_days=0
	_mon=(31,28,31,30,31,30,31,31,30,31,30,31)
	_fy=TOINT(_argv[0])
	_fm=TOINT(_argv[1])
	_fd=TOINT(_argv[2])
	_FY=TOINT(_argv[3])
	_FM=TOINT(_argv[4])
	_FD=TOINT(_argv[5])
	while _fy<=_FY {
		if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
			_mon[1]=29
		if _FY==_fy {
			while _fm<_FM {
				_days+=_mon[_fm-1]
				_fm++
			}
			_days+=_FD-_fd
		}
		elseif _fy==_FY-1 {
			while _fm<=12 {
				_days+=_mon[_fm-1]
				_fm++
			}
			_fm=1
		}
		else {
			if _fy%4==0 && _fy % 100 != 0 || _fy % 400 == 0
				_days++
			_days+=365
		}
		_fy++
	}
	_days
}
GetGMTDateTime{
	_Value=TOINT(_argv[0])
	_Year = 1970; _Month = 1; _Day = 1
	_Hour = 8;_Min = 0;_Sec = 0
	//臨時變數
	_iYear = 0;_iDay = 0
	_iHour = 0;_iMin = 0;_iSec = 0
	//計算文件創建的年份
	_iYear = _Value / (365 * 24 * 60 * 60)
	_iYear = _Year + _iYear
	//計算檔除創建整年份以外還有多少天
	_iDay = (_Value % (365 * 24 * 60 * 60)) / (24 * 60 * 60)
	//把閏年的年份數計算出來
	_RInt = 0
	for _i = 1970; _i < _iYear; _i++{
		if _i % 4 == 0&&_i % 100 != 0 || _i % 400 == 0
			_RInt = _RInt + 1
	}
	//計算檔創建的時間(幾時)
	_iHour = ((_Value % (365 * 24 * 60 * 60)) % (24 * 60 * 60)) / (60 * 60)
	_iHour = _Hour + _iHour
	//計算檔創建的時間(幾分)
	_iMin = (((_Value % (365 * 24 * 60 * 60)) % (24 * 60 * 60)) % (60 * 60)) / 60
	_iMin = _Min + _iMin
	//計算檔創建的時間(幾秒)
	_iSec = (((_Value % (365 * 24 * 60 * 60)) % (24 * 60 * 60)) % (60 * 60)) % 60
	_iSec = _Sec + _iSec
	_t=daystodate(_iYear,_Month,_Day,_iDay-_RInt)
	_t,=(_iHour,_iMin,_iSec)
	_t
	//_iDay+_RInt
	//_Value / (365 * 24 * 60 * 60)
	//GetGMTDateTime(GETSECCOUNT)
}
OnAnalogClock{
	'\0\s[5]打開時鐘'
	--
	void CALLSAORI('AnalogClock2_0\AnalogClock','show','clock',100,-200,'sakura')
}
OnClockTime{
	"\0\s[5]現在是%(reference0):%(reference1):%(reference2)"
}
OnClockClose{
	AnalogClock=0
	'\0\s[5]關閉時鐘'
}
//**** 設定關機時間 ***********************************************************************************
OnSetShutdownMenu:all{
	if !ISVAR('shutdownset') {
		shutdownset = IARRAY
		shutdownset[0] = 'OFF'
		shutdownset[1] = '當天'
		shutdowntime=(0,0)
		shutdowndata=(0,0,0,0,0)
	}
	"\![quicksession,1]\![set,choicetimeout,0]\f[bold,true]\0自動關機\f[bold,default]\n[150]/
	自動關機時間：\f[color,34,100,200]%(shutdowntime[0])點%(shutdowntime[1])分\f[color,default]\_l[180]\q[◇設定自動關機時間,OnSetShutdown]\n/
	計畫關機時間：\f[color,34,100,200]%(shutdowndata[0])年%(shutdowndata[1])月%(shutdowndata[2])日%(shutdowndata[3])點%(shutdowndata[4])分\f[color,default]\n/
	\q[◇設定計劃關機時間,OnShutdownPlan]\n/
	\q[◇關閉關機對話方塊,OnCancelSetShutdown]\n/
	\q[◇倒計時關機,OnCountShutdown]\n"
	--
	if shutdownset[0] == 'ON' {
		'自動關機開關：\q[◎ON,OnShutdownSet,0,ON]\_l[180]\q[○OFF,OnShutdownSet,0,OFF]\n'
	}
	else {
		'自動關機開關：\q[○ON,OnShutdownSet,0,ON]\_l[180]\q[◎OFF,OnShutdownSet,0,OFF]\n'
	}
	--
	if shutdownset[1] == '當天' {
		'自動關機頻率：\q[◎當天自動關機,OnShutdownSet,1,當天]\_l[180]\q[○每天自動關機,OnShutdownSet,1,每天]\n'
	}
	else {
		'自動關機頻率：\q[○當天自動關機,OnShutdownSet,1,當天]\_l[180]\q[◎每天自動關機,OnShutdownSet,1,每天]\n'
	}
	--
	'\n[half]\q[◇返回上一層,OnOpenMenu,3]    \q[◇終了,Cancel]'
}
OnShutdownSet{
	shutdownset[reference0] = reference1
	OnSetShutdownMenu
}
OnSetShutdown{
	'\0\s[2]要在什麼時候自動關機呢？'
	--
	"\![open,timeinput,OnSetShutdownComplete,60000,%(hour),%(minute),%(second)]"
}
OnSetShutdownComplete{
	shutdownset[0] = 'ON'
	shutdowntime = SPLIT(reference0,',')
	"\0\s[6]在%(shutdowntime[0])點%(shutdowntime[1])分的時候自動關機。\1\s[15]任務接受！"
}
OnCountShutdown{
	'\0要在多少秒後自動關機呢？'
	--
	'\![open,inputbox,OnCountShutdownComplete]'
}
OnCountShutdownComplete{
	"收到，%(reference0)秒後自動關機"
	--
	_path = CALLSAORI('advanced_sysinfo','get_special_folder_path','Windows')
	_file = REPLACE(_path,'\','\\') + '\\system32\\Shutdown.exe'
	"\![open,file,%(_file),-s -t %(reference0)]"
	--
	"\_w[%(TOINT(reference0)*1000/3)]\n"+OnClose
}
OnShutdownPlan{
	'\0請先輸入計畫關機的日期'
	--
	"\![open,dateinput,OnShutdownPlanTime,60000,%(year),%(month),%(day)]"
}
OnShutdownPlanTime{
	shutdowndata[0]=reference0[0]
	shutdowndata[1]=reference0[1]
	shutdowndata[2]=reference0[2]
	"\0要在%(shutdowndata[0])年%(shutdowndata[1])月%(shutdowndata[2])日的什麼時候關機？"
	--
	"\![open,timeinput,OnShutdownPlanComplete,60000,%(hour),%(minute),%(second)]"
}
OnShutdownPlanComplete{
	shutdowndata[3]=reference0[0]
	shutdowndata[4]=reference0[1]
	"\0\s[6]在%(shutdowndata[0])年%(shutdowndata[1])月%(shutdowndata[2])日%(shutdowndata[3])點%(shutdowndata[4])分的時候關機。\1\s[15]任務接受！"
}
ShutdownMonitor{
	if shutdownset[0] == 'ON' && TOINT(shutdowntime[0]) == hour && TOINT(shutdowntime[1]) == minute{
		shutdownstart = 1
		infomode=0
		'\c\![sound,stop]'
		if shutdownset[1] == '當天' {
			shutdownset[0] = 'OFF'
		}
	}
	--
	if shutdowndata[0]==year && shutdowndata[1]==month && shutdowndata[2]==day && shutdowndata[3] == hour && shutdowndata[4] == minute{
		shutdownstart = 1
		infomode=0
		'\c\![sound,stop]'
	}
	--
	if shutdownstart > 0{
		_txt="即將自動關機，請%(username)保存資料"
		_txt
		--
		_trayballoon="\![set,trayballoon,--icon=info,--timeout=10,--title=關機提醒,--text=現在是%(hour)點%(minute)分,--text=%(_txt)！,--text=（點擊氣泡關閉提醒）]"
		if InNotify
			SHIORI_FW.MakeValueNotify(_trayballoon)
		else
			_trayballoon
		--
		'\w9\w9\w9\w9\w9'+OnClose
		--
		RUNCMD('Shutdown -s')
	}
}
OnCancelSetShutdown{
	shutdownstart=0
	_path = CALLSAORI('advanced_sysinfo','get_special_folder_path','Windows')
	_file = REPLACE(_path,'\','\\') + '\\system32\\Shutdown.exe'
	"\![open,file,%(_file),-a]"
}
AgendaMonitor{
	_eventtemp=''
	_events=OnEventRead(,,,'all')
	SETDELIM(_events,'|')
	foreach _events;_event{
		_eventrepeat=TOINT(_event[19,'	'])
		if _eventrepeat
			_eventtemp+=_event+'|'
	}
	for _i=0;_i<30;_i++{
		_year=daystodate(year,month,day,_i)[0]
		_m=daystodate(year,month,day,_i)[1]
		_d=daystodate(year,month,day,_i)[2]
		_eventtemp+=OnEventRead(_year,_m,_d)
	}
	SETDELIM(_eventtemp, '|')
	_n=0
	foreach _eventtemp;_event{
		if _event==''
			continue
		_s=EventRemindCheck(_event)
		_start=_s[0]
		_Ta=_s[1]
		_Tb=_s[2]
		if _start{
			_t=GetGMTDateTime(_Ta)
			_T=GetGMTDateTime(_Tb)
			eventtemp=_event
			eventtemp[1,'	']=_t[0]
			eventtemp[2,'	']=_t[1]
			eventtemp[3,'	']=_t[2]
			eventtemp[4,'	']=_t[3]
			eventtemp[5,'	']=_t[4]
			eventtemp[7,'	']=_T[0]
			eventtemp[8,'	']=_T[1]
			eventtemp[9,'	']=_T[2]
			eventtemp[10,'	']=_T[3]
			eventtemp[11,'	']=_T[4]
		}
		_n++
	}
	if agendastart{
		_event=eventtemp
		_eventsort=_event[0,'	']
		_eventtitle=_event[12,'	']
		_eventbegindate=(_event[1,'	'],_event[2,'	'],_event[3,'	'],_event[4,'	'],_event[5,'	'])
		_eventenddate=(_event[7,'	'],_event[8,'	'],_event[9,'	'],_event[10,'	'],_event[11,'	'])
		_eventplace=_event[13,'	']
		_eventagenda=_event[14,'	']
		_eventasakura=_event[17,'	']
		_eventsound=_event[18,'	']
		_event[25,'	']=REPLACE(_event[25,'	'],'/','\\')
		_eventapp=_event[25,'	']
		_w=''
		_w+='日程提醒：\n'
		_w+='事件種類：'+_eventsort+'\n'
		_w+='標題：'+_eventtitle+'\n'
		_w+='時間開始：'+_eventbegindate[0]+'年'+_eventbegindate[1]+'月'+_eventbegindate[2]+'日'+_eventbegindate[3]+'時'+_eventbegindate[4]+'分'+'\n'
		_w+='時間結束：'+_eventenddate[0]+'年'+_eventenddate[1]+'月'+_eventenddate[2]+'日'+_eventenddate[3]+'時'+_eventenddate[4]+'分'+'\n'
		_w+='地點：'+_eventplace+'\n'
		_w+='備忘：'+_eventagenda+'\n'
		_w+=_eventasakura+'\n'
		'\0\![quicksession,true]\![set,choicetimeout,0]'//加在這裡，否則人物表情無法復原
		--
		_w
		--
		"\q[◇查看日程,OnEventCheck,%(_eventbegindate[0]),%(_eventbegindate[1]),%(_eventbegindate[2])]\n/
		\q[◇知道了，不再提醒,OnEventOver]\n/
		\![set,trayballoon,--icon=info,--timeout=10,--title=日程提醒,--text=%(_eventasakura),--text=（點擊氣泡關閉提醒）]/
		\![open,file,%(_eventapp)]\![sound,play,%(_eventsound)]"
	}
}
EventRemindCheck{
	_start=0
	_event=_argv[0]
	_eventsort=_event[0,'	']
	_eventbegindate=(TOINT(_event[1,'	']),TOINT(_event[2,'	']),TOINT(_event[3,'	']),TOINT(_event[4,'	']),TOINT(_event[5,'	']))
	_eventenddate=(TOINT(_event[7,'	']),TOINT(_event[8,'	']),TOINT(_event[9,'	']),TOINT(_event[10,'	']),TOINT(_event[11,'	']))
	_eventrange=TOINT(_event[6,'	'])
	_eventtitle=_event[12,'	']
	_eventplace=_event[13,'	']
	_eventagenda=_event[14,'	']
	_eventremind=TOINT(_event[15,'	'])
	_eventseremind=TOINT(_event[16,'	'])
	_eventasakura=_event[17,'	']
	_eventsound=_event[18,'	']
	_eventrepeat=TOINT(_event[19,'	'])
	_eventrepeatend=TOINT(_event[20,'	'])
	_eventrepeatenddate=(_event[21,'	'],_event[22,'	'],_event[23,'	'])
	_ta=GETSECCOUNT(_eventbegindate[0],_eventbegindate[1],_eventbegindate[2],0,hour,minute,0)
	_tb=GETSECCOUNT(_eventenddate[0],_eventenddate[1],_eventenddate[2],0,hour,minute,0)
	_tc=GETSECCOUNT(year,month,day,0,hour,minute,0)
	_td=GETSECCOUNT(year,month,day,0,hour,minute,0)
	if _eventrepeatend
		_td=GETSECCOUNT(_eventrepeatenddate[0],_eventrepeatenddate[1],_eventrepeatenddate[2],0,hour,minute,0)
	_TA=GETSECCOUNT(_eventbegindate[0],_eventbegindate[1],_eventbegindate[2],0,_eventbegindate[3],_eventbegindate[4],0)
	_TB=GETSECCOUNT(_eventenddate[0],_eventenddate[1],_eventenddate[2],0,_eventenddate[3],_eventenddate[4],0)
	_TC=GETSECCOUNT(year,month,day,0,hour,minute,0)
	_T=(0,0,5*60,15*60,30*60,60*60,2*60*60,24*60*60,2*24*60*60,7*24*60*60,14*24*60*60,28*24*60*60)//提醒
	_Th=0
	_Tflag=6
	if _eventrange{
		_T=(0,0,24*60*60,2*24*60*60,7*24*60*60)
		_Th=GETSECCOUNT(year,month,day,0,_eventbegindate[3],_eventbegindate[4],0)-GETSECCOUNT(year,month,day,0,8,30,0)
		_Tflag=1
	}
	_t=(0,1,7,14,GETSECCOUNT(year,month,_eventbegindate[2],0,hour,minute,0),GETSECCOUNT(year,_eventbegindate[1],_eventbegindate[2],0,hour,minute,0))[_eventrepeat]//重複
	_Tt=0
	_Ta=_TA
	_Tb=_TB
	if _argv[1]=='getrepeat'{
		if _eventrepeat<4
			_Ta=_tc+_t*24*60*60-(_tc-_TA)%(_t*24*60*60)
		else{
			_t=(GETSECCOUNT(_eventbegindate[0],_eventbegindate[1],_eventbegindate[2],0,hour,minute,0),GETSECCOUNT(_eventbegindate[0],_eventbegindate[1],_eventbegindate[2],0,hour,minute,0))[_eventrepeat-4]
			_x=GETSECCOUNT(year,month+1,_eventbegindate[2],0,hour,minute,0)
			if month==12
				_x=GETSECCOUNT(year+1,1,_eventbegindate[2],0,hour,minute,0)
			_tt=(_x,GETSECCOUNT(_eventbegindate[0]+1,_eventbegindate[1],_eventbegindate[2],0,hour,minute,0))[_eventrepeat-4]
			_Ta=_tc+_tt-_t-(_tc-_TA)%(_tt-_t)
		}
		(_start,_Ta,_Tb)
		return
	}
	if _eventremind<=_Tflag&&_eventrepeat<4&&(_tc-_ta)%(_t*24*60*60)==0&&_tc-_ta>=0&&_tc<=_td{//提醒時間小於1天前重複模式在每月前
		_Ta=_TA+_tc-_ta
		_Tb=_TB+_tc-_ta
	}
	elseif _eventrepeat<4&&(_tc-_ta+_T[_eventremind])%(_t*24*60*60)==0&&_tc-_ta>=0&&_tc<=_td{//提醒時間大於等於1天前
		_Ta=_TA+_tc-_ta+_T[_eventremind]
		_Tb=_TB+_tc-_ta+_T[_eventremind]
	}
	else{//重複模式在每月後
		if _eventremind<=_Tflag&&_tc>=_ta&&(_tc==_t)&&_tc<=_td{//提醒時間小於1天前
			_Ta=_TA+_tc-_ta
			_Tb=_TB+_tc-_ta
		}
		elseif _tc>_ta&&(_tc+_T[_eventremind]==_t)&&_tc<=_td{//提醒時間大於1天前
			_Ta=_TA+_tc-_ta+_T[_eventremind]
			_Tb=_TB+_tc-_ta+_T[_eventremind]
		}
	}
	if _eventremind
		_Tt=_TC+_T[_eventremind]+_Th
	if _Ta==_Tt{
		agendastart=1
		_start=1
	}
	if _eventseremind<=6&&_eventrepeat<4&&(_tc-_ta)%(_t*24*60*60)==0&&_tc-_ta>0&&_tc<=_td{
		_Ta=_TA+_tc-_ta
		_Tb=_TB+_tc-_ta
	}
	elseif _eventrepeat<4&&(_tc-_ta+_T[_eventseremind])%(_t*24*60*60)==0&&_tc-_ta>0&&_tc<=_td{
		_Ta=_TA+_tc-_ta+_T[_eventseremind]
		_Tb=_TB+_tc-_ta+_T[_eventseremind]
	}
	else{
		if _eventseremind<=6&&_tc>_ta&&(_tc==_t)&&_tc<=_td{
			_Ta=_TA+_tc-_ta
			_Tb=_TB+_tc-_ta
		}
		elseif _tc>_ta&&(_tc+_T[_eventseremind]==_t)&&_tc<=_td{
			_Ta=_TA+_tc-_ta+_T[_eventseremind]
			_Tb=_TB+_tc-_ta+_T[_eventseremind]
		}
	}
	if _eventseremind{
		_Tt=_TC+_T[_eventseremind]+_Th
	}
	if _Ta==_Tt{
		agendastart=1
		_start=1
	}
	(_start,_Ta,_Tb)
}
OnEventCheck{
	agendastart=0
	OnAgenda(reference0,reference1,reference2,'inter')
}
OnEventOver{
	agendastart=0
	'好的'
}
