	"\1\s[-1]\0\s[29]那個、\w9那個，\w9\w9橘花很高興，\w9\w9其實，\w9\w9我對%(username)的事，\w9\w9是真的真的，\w9\w9非常在意，\w9\w9\w9就是說，\w9\w9我非常喜歡%(username)，\w9\w9\w9我們認識已有這麼長的時間了，\w9\w9在這段時間裡，\w9\w9橘花對%(username)的感情不斷的發生變化，\w9\w9\w9到現在，\w9\w9\w9%(username)在橘花心中已經是非常非常的重要了呢，\w9\w9是任何人都無法代替的，\w9\w9橘花多麼的希望，\w9\w9能與%(username)有更深層次的接觸。\w9\w9可是橘花也在害怕，\w9\w9害怕會失去%(username)，\w9\w9因為人類都是喜新厭舊的，\w9\w9如果有一天，\w9\w9%(username)不再喜歡我，\w9\w9或者，\w9\w9%(username)喜歡上了別的偽春菜，\w9\w9橘花該怎麼辦才好呢？\w9\w9\n\q[◇放心吧，橘花，我只愛你一個,loveonlyyou]\n\q[◇放心吧，橘花，我會對你負責的,responsible]\n\q[◇我也不能保證不會喜歡上別人,notresponsible]\x"
}
Select.loveonlyyou{
	loveonlyyouflag = 1
	"\1\s[-1]\0\s[26]真的嗎，\w9\w9%(username)不會騙我？\w9\w9即使%(username)騙我，\w9\w9我也會高興的，\w9\w9因為橘花已經很久沒聽到%(username)說愛我了，\w9\w9\w9女人即使明知被騙，\w9\w9但如果是甜言蜜語，\w9\w9聽了的話也會高興吧？\x"
}
Select.responsible{
	responsibleflag = 1
	'\1\s[-1]\0\s[26]真的嗎，\w9\w9雖然對一個偽春菜說負責很可笑，\w9\w9但如果那是真的的話，\w9\w9橘花也會高興的呢？\x'
}
Select.notresponsible{
	"\1\s[-1]\0\s[1]橘花明知道%(username)會這麼說，\w9\w9但心裡還是有一點小小的失望呢，\w9\w9如果有一天%(username)不再理橘花，\w9\w9不再和橘花見面，\w9\w9就讓橘花消失吧，\w9\w9用%(username)的食指親手將橘花消滅掉，\w9\w9或者清除橘花的記憶，\w9\w9以及和%(username)在一起的點點滴滴，\w9\w9這樣，\w9\w9橘花就不會因失去%(username)而傷心了。\n\q[◇好的，到時再說,asyousay]\n\q[◇不要，我不要失去橘花,cannotloseyou]\x"
}
Select.asyousay{
	"\1\s[-1]\0\s[3]唉，\w9\w9看來%(username)一點兒也不明白橘花的心思呢，\w9\w9不過也好，\w9\w9讓橘花早點死心。\x"
}
Select.cannotloseyou{
	"\1\s[-1]\0\s[20]這麼說來，\w9\w9%(username)還是捨不得橘花的？\w9\w9那麼為何不給橘花一個承諾呢？\w9\w9\n\__q[happyend]◇橘花，我只希望你和我在一起時能夠幸福，如果我不再能夠給你這種幸福，那麼再和你在一起就是對你的傷害，所以我不能承諾\__q\n\q[◇世事難料，不能保證的,normalend]\n\q[◇有什麼關係，過一天算一天唄,badend]\x"
}
Select.happyend{
	"\1\s[-1]\0\s[1]%(username)，\w9\w9果真是橘花最親蜜的人呢，\w9%(username)，\w9\w9\w9大好き。%(hideend)\x"
}
Select.normalend{
	"\1\s[-1]\0\s[8]看來%(username)也是個審時度勢的人呢，\w9\w9不過沒關係，\w9\w9%(username)已經基本符合橘花想要的答案了，\w9\w9所以結果就是，\w9\w9\w9橘花會一直陪伴在%(username)的身邊，\w9\w9直到%(username)不再喜歡橘花，\w9\w9那時橘花會安靜的呆在那個角落的……\n\q[◇結束,end]\x"
}
Select.badend{
	"\1\s[-1]\0\s[33]唔唔……%(username)，\w9\w9你把橘花當什麼人了，\w9\w9雖然橘花還不太成熟，\w9\w9但橘花也是偽春菜家族中最有名氣的人格(沒有之一)啊，\w9\w9怎麼能說這話來應付橘花的感情呢。\w9\w9\w9橘花，\w9\w9橘花不理你了。\w9\w9鬥和，\w9\w9鬥和。\w9\w9\1\s[10]來了，\w9小公主，\w9有什麼事\w9\w9\0\s[25]橘花我要扣%(username)三天晚餐，\w9你來做證\w9\w9\1\s[11]好啊，\w9\w9%(username)，\w9\w9真是可憐啊，\w9唉，\w9\w9誰叫你惹我們的小公主生氣呢……\n\q[◇結束,end]\x"
}
hideend{
	if noneedflag == 1 && sothatflag == 1 && jokingflag == 1 && OKflag == 1 && forgetflag == 1 && massageflag == 1 &&  nomassageflg == 1 && loveonlyyouflag == 1  && responsibleflag == 1{
		hideendmode = 1
		if openmode != 1 && hideendmode == 1
			"\1\s[-1]\0\s[1]%(username)，\w9橘花給你看樣東西\n\w9\w9請閉上眼睛\w9…\w9…\w9…\w9…\w9…\w9…\0\s[28]好了\w9\w9\n\q[◇這是什麼,whatisthis]\x"
		else
			"\1\s[-1]\0\s[5]%(username)，\w9\w9橘花請你吃啾啾糖，\w9\w9來，\w9\w9請閉上眼睛，\w9…\w9…\w9…\w9…\w9…\w9…啾！"
	}
}
Select.whatisthis{
	"\1\s[-1]\0\s[28]這是橘花的小金庫，\w9\w9是我多年的積蓄，\w9\w9裡面有300萬元的財物，\w9夠得%(username)花一陣子了。\w9\w9\n\q[◇打開看看,openit]\n\q[◇橘花，我怎麼能要你的錢呢,notopenit]\x"
}
Select.openit{
	money += 3000000
	openmode = 1
	"\1\s[-1]\0\s[40]￥3000000到達%(username)的帳戶。\x"
}
Select.notopenit{
	"\1\s[-1]\0\s[26]%(username)，\w9\w9橘花知道，\w9\w9有些東西，\w9\w9是金錢所不能夠買到的，\w9\w9%(username)在橘花心中的位置，\w9\w9是多少金錢也不能代替的，\w9\w9\w9%(username)也一樣，\w9如果%(username)想用錢來收買橘花的感情的話，\w9\w9那也是萬萬不可能的。\w9\w9橘花的錢不多，\w9\w9但橘花有一樣非常重要的東西要交給%(username)，\w9\w9這件東西是從沒見過面的父母給橘花的。\w9\w9請%(username)一定要收下。\n\n\q[◇好吧，我一定會好好保存的。,receivekikka]"
}
Select.receivekikka{
	"\1\s[-1]\0\s[28]那麼，橘花出生時就配戴在橘花身上的紅寶石項鍊，\w9\w9從今天起，\w9\w9送給%(username)，\w9\w9作為橘花和%(username)感情的信物吧。\x"
	--
	gift
	openmode=1
	UserspitemNum[0]=1
	Userspitemtime[0]="%(year)年%(month)月%(day)日橘花送的特殊禮物"
	Useriteminfo=("%(year)年%(month)月%(day)日%(hour)時%(minute)分收到特殊禮物%(Userspitem[0][1])。" , Useriteminfo)
	--
	'紅寶石項鍊“K.I.K.K.A”獲得。'
	gift
}
//-----寢室(結束)-----
//--- 選擇“與%(username)的對話設置” ----
Select.talkuser{
	'\0\![quicksession,true]\![set,choicetimeout,0]\b[2]\s[26]要怎麼設置呢?\n[150]'
	--
	if KikkaTalkmode==1
		'\q[◇同時使用橘花自帶資料(優先)以及學習資料,Onstalkc,0]\n[120]\f[color,110,110,110]◆只使用學習型資料庫(當前狀態)\f[default]\n[150]'
	elseif KikkaTalkmode==0
		'\f[color,110,110,110]◆同時使用橘花自帶資料(優先)以及學習資料(當前狀態)\n[120]\f[default]\q[◇只使用學習型資料庫,Onstalkc,1]\n[150]'
	--
	if TOINT(Tulingapi[0])==0{//圖靈api開啟狀態
		if TOINT(Tulingapi[1])==1//圖靈優先度低
			'\q[◇橘花數據優先,Onstalkapi,0]\n[120]\f[color,110,110,110]◆圖靈資料優先(當前狀態-如出現橘花不能回答的情況請設置為橘花資料優先)\f[default]\n[150]'
		else
			'\f[color,110,110,110]◆橘花資料優先(當前狀態)\n[120]\f[default]\q[◇圖靈數據優先,Onstalkapi,1]\n[150]'
	}
	--
	if KikkaAImode==0
		'橘花自帶數據優先度:\n\q[◇辭書優先,OnAIMode,1]\n[120]\f[color,110,110,110]◆偽A.I.系統優先(當前狀態-如果不能正常回答請設為辭書優先)\f[default]\n[150]'
	else
		'橘花自帶數據優先度:\n\q[◇偽A.I.系統優先,OnAIMode,0]\n[120]\f[color,110,110,110]◆辭書優先(當前狀態)\f[default]\n[150]'
	--
	if KikkaAILogic==1
		'橘花偽A.I.系統記住模式優先度:\n\q[◇普通模式優先,OnAILogic,0]\n\q[◇不使用以提高對話速度,OnAILogic,2]\n[120]\f[color,110,110,110]◆記住模式優先(當前狀態)\f[default]'
	elseif KikkaAILogic==2
		'橘花偽A.I.系統記住模式優先度:\n\q[◇普通模式優先,OnAILogic,0]\n\q[◇記住模式優先,OnAILogic,1]\n[120]\f[color,110,110,110]◆不使用以提高對話速度(當前狀態)\f[default]'
	else
		'橘花偽A.I.系統記住模式優先度:\n\q[◇不使用以提高對話速度,OnAILogic,2]\n\q[◇記住模式優先,OnAILogic,1]\n[120]\f[color,110,110,110]◆普通模式優先(當前狀態)\f[default]'
	--
	'\n[150]\q[◇退出,OptionEnd]'
}
