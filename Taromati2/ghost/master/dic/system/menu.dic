///////////////////////////////////////////
//////////菜單相關辭書
///////////////////////////////////////////
//******* 主菜單 ************************************************
OnOpenMenu{
	click=NULL
	if reference0 != '' {
		OpenMenu(reference0,reference1)
	}
	else {
		OpenMenu
	}
}
OpenMenu{
	if battlemode!=0{
		OnRpgGame
		return
	}
	RunningReset
	_submenu = 0
	_submenuex=0
	if _argc > 0 {
		_submenu = _argv[0]
		_submenuex=_argv[1]
	}
	else {
		temp=OpenMenuTalk
	}
	menu=_submenu
	menuex=_submenuex
	_sub = '◆,◇,◇,◇,◇,◆,◇,◇,◇,◇,◆,◇,◇,◇,◇,◆,◇,◇,◇,◇,◆'
	'\![quicksession,true]\0'+temp+"\b[2]/
	\_l[0,22]\q[%(_sub[_submenu])常用功能,OnSubMenu,0,%(_submenuex)]/
	\_l[68]\q[%(_sub[_submenu + 4])休閒,OnSubMenu,1,%(_submenuex)]/
	\_l[112]\q[%(_sub[_submenu + 8])遊戲,OnSubMenu,2,%(_submenuex)]/
	\_l[156]\q[%(_sub[_submenu + 12])便利功能,OnSubMenu,3,%(_submenuex)]/
	\_l[224]\q[%(_sub[_submenu + 16])設定,OnSubMenu,4,%(_submenuex)]/
	\_l[0,180]\q[◇沒什麼事,MenuCancel]\_l[200]\q[◇任務管理,Multitask]"
	--
	SubMenu(_submenu,_submenuex)
	--
	KikkaMenu
	--
	if _submenu==0 && MenuMode!=2{
		NotePadShow(178,44,4)//座標x，座標y，顯示條數
	}
}
OnSubMenu{
	temp=RandomMenuMessage
	click=NULL
	OpenMenu(reference0,reference1)
}
RandomMenuMessage{
	hitokoto
	if weather.lastcity && Weather.Talks
		SHIORI_FW.RemoveAllTags(Weather.Talks)
}
SubMenu{
	_submenu = _argv[0]
	_submenuex=_argv[1]
	_sub = '◆,◇,◇,◇,◇,◆,◇,◇,◇,◇,◆,◇,◇,◇,◇,◆,◇,◇,◇,◇,◆'
	'\C\![set,choicetimeout,30000]\_l[0,30]--------------------------------------------\n'
	--
	case _submenu {
		when 0 {
			'\q[◇播放音樂,OnMusicPlayer]	\_l[100,-]\q[◇魔法時鐘,OnAnalogClock]\n/
			\q[◇鬧鐘,OnAlarmMenu]			\_l[100,-]\q[◇課程表,OnClassTable] \n/
			\q[◇記事本,Onnotebook]			\_l[100,-]\q[◇截屏,OnScreenShot]\n/
			\q[◇更換壁紙,OnWallPaper]		\_l[100,-]\q[◇清空垃圾箱,OnTrashClean]\n/
			\q[◇英漢互查字典,dictionary]	\_l[100,-]\q[◇日曆,OnCalendar]\n/
			\q[◇天氣預報,OnCheckWeather]	\_l[100,-]\q[◇日程提醒,OnAgenda]\n/
			\q[◇IP查詢,OnCheckIp]			\_l[100,-]\q[◇計算器,OnCalculator]\n/
			\q[◇放大鏡,OnMagnify]			\_l[100,-]\q[◇答錄機,OnRecorder]\n/
			'
		}
		when 1 {
			_heart='\f[color,238,50,95]\&[hearts]\f[default]'
			"\q[◇話題,ForcedTalk]			\_l[100,-]\q[◇自我介紹,Introduction]			\_l[200,-]\q[◇說笑話,Story]\n/
			\q[◇與橘花說話,Communicate]		\_l[100,-]\q[◇教學,Teaching]					\_l[200,-]\q[◇剛才說了什麼,OnLastTalk]\n/
			\q[◇五十音,Onjap_v]				\_l[100,-]\q[◇秘密服務,SecretService]%(_heart)	\_l[200,-]\q[◇外語學習,japanesestudy]\n/
			\q[◇花語,OnFlowers]				\_l[100,-]\q[◇誕生花,OnBirthdayFlowerList]		\_l[200,-]\q[◇塔羅占卜,OnFUT]\n/
			\q[◇趣味測試,Ontestmenu]		\_l[100,-]\q[◇橘花題庫,OnExamTest]				\_l[200,-]\q[◇和橘花談心,talktoheart]\n/
			\q[◇查找詩歌,OnResearchPoesy]	\_l[100,-]\q[◇唐詩默寫♪,OnPoesywrite]			\_l[200,-]\q[◇準備晚餐,Cookingtonight]\n/
			\q[◇動漫列表,OnDHs]				\_l[100,-]\q[◇咖啡廳,get_some_tea]				\_l[200,-]%(Onmeal)\n/
			"
			--
			if specialmode == 'smoking' || ( smoker=='1' && towaflag )
				'\q[◇吸煙室,SmokingPlace]\_l[100,-]'
			--
			"\q[◇試衣間,OnFittingRoom]		\_l[200,-]\q[◇進寢室,Bedroom]\n/
			\q[◇其它服務,otherserv]			\_l[100,-]\q[◇橘花知識庫,OnKikkaKnowl]			\_l[200,-]%(Onclosetouch)\n"
		}
		when 2 {
			'\q[◇猜拳,OnHandGame]			\_l[80,-]撲克遊戲：						\_l[168,-]\q[◇外出冒險,OnRpgGame] \n/
			\q[◇猜數字,OnGuessNumber]		\_l[80,-]\q[◇21點,OnBlackjack0]			\_l[168,-]\q[◇推箱子,OnBoxGame]\n/
			\q[◇開心問答,OnQuestBegin]		\_l[80,-]\q[◇紮金花,OnGoldenFlower]		\_l[168,-]\q[◇華容道,OnHuaRongDao]\n/
			\q[◇井字棋,OnPlayOX]			\_l[80,-]\q[◇UNO,OnUnoUserInit]			\_l[168,-]\q[◇五子棋,OnGobangInIt]\n/
															\_l[168,-]\q[◇連連看,OnLinkWnd] \n/
			\q[◇俄羅斯方塊,OnTetris.NewGame]										\_l[168,-]\q[◇數字漢諾塔,OnHanoi]\n/
			\q[◇貪食蛇,OnRetroSnaker]												\_l[168,-]\q[◇雙色球,OnDoubleColorBall]\n'
		}
		when 3 {
			case _submenuex{
				when 0{
					'\q[◇軟體快捷,OnShortcutMenu]			\_l[138,-]\q[◇計算器,OnCalculator] \n/
					\q[◇倒數計時,count]						\_l[138,-]\q[◇碼錶,OnSecondWatch,inter]\n/
					\q[◇磁片垃圾檔清理,ClearDisk]				\_l[138,-]\q[◇股票,OnKikkaStockMenu]\n/
					\q[◇簡繁轉換,OnChangeChineseCode]		\_l[138,-]\q[◇校準時間,OnSNTPmenu]\n/
					\q[◇收取郵件,ALLMAIL]					\_l[138,-]\q[◇開啟郵箱,OPENMAILER]\n/
					\q[◇RSS盒子,HEADLINE]					\_l[138,-]\q[◇資料備份,OnGhostBackup]\n/
					\q[◇自動關機,OnSetShutdownMenu]			\_l[138,-]\q[◇吃貨,OnReadyToEat]\n/
					\q[◇批量檔重命名,OnInterFileRename]	\_l[138,-]\q[◇橘花閱讀器,OnReadBook]\n'
					--
					if nurturance.Darkness>=200//死機功能by steve02081504
						'\q[◇註銷,OnLogOff]\_l[55,-]\q[◇重啟,OnRebootComputer]\_l[110,-]\q[◇關機,OnShutdown]\_l[165,-]\q[◇死機,OnSystemHalte]\_l[220,-]\q[◇待機,OnStandby]\n'
					else
						'\q[◇註銷,OnLogOff]\_l[73,-]\q[◇重啟,OnRebootComputer]\_l[147,-]\q[◇關機,OnShutdown]\_l[220,-]\q[◇待機,OnStandby]\n'
					--
					'\n'
				}
				when 1{
					'\q[◇鍵位碼測試,OnKeyCodeTest]\n/
					'
				}
			}
			--
			"\_l[90,180]\q[%(_sub[_submenuex])1,OnSubMenu,%(_submenu),0]    \q[%(_sub[_submenuex + 4])2,OnSubMenu,%(_submenu),1]"
		}
		when 4 {
			"\q[◇系統環境,System]				\_l[138,-]\q[◇我的電腦,OnMenuExplorer,mycomputer]\n/
			\q[◇選項設定,Option]				\_l[138,-]\q[◇控制台,OnMenuExplorer,control]\n[150]/
			\q[◇對話頻率,TalkInterval]			\_l[138,-]\q[◇與%(username)的對話設置,talkuser]\n/
			\q[◇使用者稱呼,ChangeUserName]		\_l[138,-]\q[◇使用者生日,birthday]\n/
			\q[◇選擇語言,OnLanguage]			\_l[138,-]\q[◇幫肋,help]\n/
			\q[◇總在最前,AlwaysOnTop] ｜ \q[◇恢復默認,NotOnTop] | \q[◇最小化,Trayicon]\n/
			\q[◇GhostExplorer,GhostExplorer]	\_l[138,-]\q[◇ShellExplorer,ShellExplorer]\n/
			\q[◇BalloonExplorer,BalloonExplorer]\_l[138,-]"
			--
			if AutoUpdate==0 && SHIORI_FW.DebugMode
				"\q[◇更新%(Baseware),"+'"script:\![update,platform]"'+']\n'
			else
				'\q[◇更新檢查,OnUpdateCheck]\n'
		}
	}
}
//---------- 打開功能表時的對話 ------------------------------------------
OpenMenuTalk{
	_phase = GetPhase
	if _phase >= 2 {
		click=TOINT(click)+1
		"\0\s[5]%(username)%(Timejud)好，什麼事呢"
		if _phase >= 3
			"\0\s[5]最喜歡%(username)了，什麼事呢"
		"\0\s[26]什麼事呢、%(username)？"
		'\0\s[41]啊…好的。'
		'\0\s[5]要做什麼呢？\s[40]'
		'\0\s[26]啊…是的。'
		if nurturance.Darkness>=200
			'\0\s[27]需要幫忙嗎。'
		if nurturance.Moeness>=200
			'\0\s[22]橘花待命。'
		if nurturance.Darkness>nurturance.Dependency
			'\0\s[32]礙事的東西通通見鬼去吧……'
		elseif nurturance.Darkness>=250
			"\0\s[27]%(username)要讓橘花消滅誰呢"
		if click>10{
			click=0
			"\0\s[21]討厭，%(username)點這麼快，當橘花是傻瓜嗎\e"
			if nurturance.Darkness>nurturance.Dependency
				"\0\s[27]討厭，%(username)想被鋸上一鋸嗎？\e"
		}
	}
	elseif _phase <= 0 {
		'\0\s[0]？'
		'\0\s[6]幹嘛'
		'\0\s[7]什麼事。'
		'\0\s[25]有何貴幹。'
		--
		if intimacy < -312
			'\e'
	}
	else {
		'\0\s[26]好的、什麼事呢？'
		"\0\s[26]什麼事呢、%(username)？"
		'\0\s[26]要做什麼呢？'
	}
}
Select.otherserv{
	'\0\s0啊、\w9有需要幫忙嗎?\s[40]\n[150]/
	\q[◇季節判斷與對話,Seasontest]\n/
	\q[◇告訴我一些事吧,something]\n/
	\q[◇我身體不舒服,notsogood]\n/
	\q[◇返回,OnOpenMenu,1]\n/
	\q[◇退出,OptionEnd]'
}
Select.help{
	"\0\s0啊、\w9有需要幫忙嗎?\s[40]\n[150]/
	\q[◇關於好感度,lovech]\n/
	\q[◇關於橘花的生日,birthdaykikka]		\_l[120,-]\q[◇修改更新源,MirrorChange]\n/
	\n/
	\q[◇錯誤記錄,OnErrorLog]\n/
	\q[◇關於快速鍵,shortcutkey]				\_l[120,-]\q[◇自優化,self_tuning]\n/
	\q[◇master目錄,OnOpenMasterMenu]\n/ \_l[120,-]\q[◇偽春菜wiki,OpenUkagakaWiki]\n/
	%(Onaccounting)/
	\q[◇返回,OnOpenMenu,4]\_l[120,-]\q[◇退出,OptionEnd]"
}
Select.NotOnTop{
	topmode=0
	'\0\s[6]……知道了。\n'
	--
	TopModeChanged
}
Select.AlwaysOnTop{
	topmode=1
	'\0\s[5]收到。\w6最前排確認。\n'
	--
	TopModeChanged
}
Select.Trayicon{
	topmode+=2
	TopModeChanged
	//回饋見OnWindowStateMinimize
}
TopModeChanged{
	if topmode<0
		topmode=0
	case topmode{
		when 0
			'\![set,windowstate,!stayontop]'
		when 1
			'\![set,windowstate,stayontop]'
		others
			'\![set,windowstate,minimize]'
	}
}
OnChoiceSelect.base{
	infomode=0
}
//---- 無用 -----------------------------------------------------------------------------------------------------------
Select.MenuCancel{
	'\0\b[0]'
	--
	_phase = GetPhase
	if _phase <= 0{
		'\0\s[0]嗯。'
	}
	elseif _phase >= 2{
		talkmemo = 'e_0'
		'\0\s[3]啊、好的。'
		'\0\s[3]…是這樣啊。'
		'\0\s[9]………'
		'\0\s[3]嗯，沒事了？'
		"\0\s[3]%(username)..？"
		'\0\s[3]唔，是麼？'
		'\0\s[9]找到想找的東西了嗎？'
		if nurturance.Dependency>=200{
			'\0\s[26]幫上忙了嗎？橘花會一直陪著你喔'
			'\0\s[6]好吧，有事再找我哦~'
		}
		if nurturance.Moeness>nurturance.Darkness
			'\0\s[3]啊，原來是這樣啊...沒有幫上你嗎？'
		if nurturance.Darkness>nurturance.Moeness
			"\0\s[3]%(username)是不是只是拿橘花尋開心呢……？"
	}
	else{
		talkmemo = 'e_0'
		'\0\s[0]好的。'
		'\0\s[0]…\s[7]怎麼了？'
		'\0\s[7]………'
		if nurturance.Dependency>=200
			'\0\s[0]…\s[7]咦？有什麼事嗎？'
	}
	--
	'\w9\w9\b[-1]'
}
RunningReset{
	eatfile=NULL
	//secondwatch=NULL
	shortcut=NULL
	mode='0'
	running=''
	option=NULL
	read=-1
	//Speech_Recognition=NULL
}
IgnoreChoiceTimeout{
	'\eb25jZSBzbyBkaXNwb3NhYmxl'
}
OnChoiceTimeout{
	if RE_GREP(reference0,"\%(IgnoreChoiceTimeout)$")
		return
	if playingtetris&&running=='playingtetris'
		OnTetris.Timer
	elseif playingGobang&&running=='playingGobang'{
		if aiturn==1
			ComputerThink
		else
			OnGobangShow
	}
	elseif playRetroSnaker&&running=='playRetroSnaker'
		OnRetroSnakerTimer
	elseif readbook&&running=='readbook'
		OnReadBook
	elseif kikkastock&&running=='kikkastock'{
		if kikkastock==1
			OnKikkaStockMenu
		elseif kikkastock==2
			OnKikkaStockSelect
		elseif kikkastock==3
			OnKikkaStockFound
	}
	elseif playingplane
		OnShowBackground
	elseif infomode
		AntiFlicker(OpenMenu(menu,menuex))
	elseif mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]…嘖。"
	else{
		talkmemo = 'e_0'
		'\0\s[7]…無視嗎？'
		'\0\s[0]…好的'
		if nurturance.Moeness>nurturance.Dependency{
			"\0\s[7]%(username)，你很忙嗎，都沒有聽我說什麼"
			'\0\s[7]有在聽我說嗎？心不在焉的哦'
			"\0\s[7]最討厭%(username)這一點了，都不聽人家說話"
			"\0\s[7]%(username)..？在幹什麼呢"
		}
	}
}
