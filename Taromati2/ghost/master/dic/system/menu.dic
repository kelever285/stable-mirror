//---- ごみ箱を空に ---------------------------------------------------------------------------------------------------
Init.RecycleBinStatus{
	RecycleBinStatus.Succees = 0
	RecycleBinStatus.FileNum = 0
	RecycleBinStatus.TotalSize = 0
}
UpdateRecycleBinStatus{
	RecycleBinStatus.FileNum = reference0
	RecycleBinStatus.TotalSize = reference1
}
OnRecycleBinStatusUpdate.Talk{
	_NumDiff = reference2
	_SizeDiff = reference3
	if _NumDiff > 9 || _SizeDiff > 1024*1024*1024*2
		"\0\s[0]嗯\w8，有%(_NumDiff)個文件\w9，共%(UNITSIZE(_SizeDiff))被添加到了回收站。"
	elseif _NumDiff > 0{
		if RecycleBinStatus.FileNum > 720
			"\0\s[8]嗯.\w8\w8.\w8.\n/
			回收站裡現在已經有%(RecycleBinStatus.FileNum)個文件了哦？"
		elseif RecycleBinStatus.TotalSize > 1024*1024*1024*2
			"\0\s[8]嗯.\w8\w8.\w8.\n/
			回收站裡現在已經有%(UNITSIZE(RecycleBinStatus.TotalSize))的文件了哦？"
	}
	elseif _NumDiff < 0 && RecycleBinStatus.TotalSize
		'\0\s[26]需要我幫忙嗎？'
}
OnRecycleBinStatusUpdate{
	if RecycleBinStatus.Succees{
		_t=OnRecycleBinStatusUpdate.Talk
		if _t
			_t+'\n/
				\q[◇清空回收站,OnTrashClean]\n/
				\q[◇無用,Cancel]\n/
				'
	}
	RecycleBinStatus.Succees = reference4
	UpdateRecycleBinStatus
}
OnTrashClean{
	DiscordCustomSet.CustomDetail('打掃衛生')
	--
	if RecycleBinStatus.FileNum == 0{
		if nurturance.Moeness>200||nurturance.Darkness>200||nurturance.Moeness>nurturance.Darkness{
			'\0\s[0]接受任務！！\w9\s[-1]\b[-1]\w9\w9\w9\w9\w9\w9\s[0]\c\w8\s[20]嗯，啊勒，無法確定敵人？\w9\n好像敵人已經被殲滅了哦~'
			'\0\s[0]嗯。\n那麼，橘花去消滅敵人！！\w9\s[-1]\b[-1]\w9\w9\w9\w9\w9\w9\s[0]\c目標、無法確認。\w9\w9\s[3]\n有點可惜呢。\w9\1\s[10]………'
		}
		else{
			'\0\s[0]任務接受。\w9\s[-1]\b[-1]\w9\w9\w9\w9\w9\w9\s[0]\c目標、無法確認。\w9\n好像已經空了呢。'
			'\0\s[0]好的。\n那麼、請稍微等一下。\w9\s[-1]\b[-1]\w9\w9\w9\w9\w9\w9\s[0]\c目標、無法確認。\w9\w9\s[3]\n有點可惜呢。\w9\1\s[10]………'
		}
	}
	elseif RecycleBinStatus.Succees{
		'\0\s[0]任務接受。\w9\s[-1]\b[-1]\w9\w9\w9'
		'\0\s[0]好的。\n那麼、請稍微等一下。\w9\s[-1]\b[-1]\w9\w9\w9'
		--
		if !silent
			'\![sound,play,SOUND_PATH\shot.wav]'
		--
		'\![execute,emptyrecyclebin]'
	}
	else{
		'\1\s[10]不…把自己像垃圾一樣的丟掉吧。\w9\0\s[8]………'
	}
}
OnRecycleBinEmpty{
	UpdateRecycleBinStatus
	if reference4 {
		_trashnum = -reference2
		_t=MIN(kikkamoodmax,LOG(nurturance.Darkness*_trashnum,2.718281)*kikkamood)
		if _t<=0
			_t=kikkamoodmax
		kikkamood=MIN(kikkamoodmax,_t+kikkamood)
		if nurturance.Moeness>200||nurturance.Darkness>200||nurturance.Moeness>nurturance.Darkness
			'\w9\w9\0\s[22]嗯，久等了，所有的敵人已清理完畢'
		else{
			'\w9\w9\0\s[22]好了、讓您久等了'
			'\w9\w9\0\s[34]…呼。\w9\w9\s[26]\n讓您久等了'
		}
		--
		if nurturance.Moeness>200||nurturance.Darkness>200||nurturance.Moeness>nurturance.Darkness
			'，討厭的垃圾都沒有了哦~~'
		else
			'。'
	}
	else{
		'\w9\w9\0\s[3]抱歉、失敗了。'
		'\w9\w9\0\s[3]意料外的狀況發生。\w9\n抱歉。'
	}
}
//更換壁紙
//----------------------------------------------------------------
OnWallPaper{
	'\C'
	--
	'\![open,dialog,open,--id=wallpaper,--dir=__system_mypictures__,--title=請選擇作為牆紙的圖片]'
}
DialogWallPaper{
	_filepath = SPLITPATH(_argv[0])
	_filename = _filepath[2]
	_fileext = TOLOWER(_filepath[3])
	case _fileext {
		when '.png', '.jpg', '.jpeg', '.bmp' {
			Wallpaperfile = _argv[0]
			"\1\s[11]\0\b[2]\s[2]影像檔\n\_q「%(_filename)%(_fileext)」\n[150]\_q要把這個設定為壁紙嗎？\n[150]/
			\![*]\q[居中,OnSetWallpaper,center]\n/
			\![*]\q[平鋪,OnSetWallpaper,tile]\n/
			\![*]\q[拉伸,OnSetWallpaper,stretch]\n[150]/
			\q[◇取消,Cancel]"
		}
		others {
			if nurturance.Moeness>200||nurturance.Moeness>nurturance.Darkness
				'格式好像不支持喲，確定沒有錯嗎？要不，再看看？……'
			else
				'抱歉，不支持這樣的檔案格式……'
		}
	}
}
OnSetWallpaper{
	'\0\s[0]似乎應該這樣……'
	--
	"\![set,wallpaper,%(Wallpaperfile),reference0]"
	ERASEVAR('Wallpaperfile')
}
ClearWallpaperVar{
	ERASEVAR('Wallpaperfile')
}
