//---------- 自我介紹 ----------------------------------------------------
Select.Introduction{
	'\0\s[0]想知道我們的事情嗎？\n\n/
	\q[◇橘花,Kikka]\n/
	\q[◇鬥和,Towa]\n[150]/
	\q[◇返回,OnOpenMenu,1]\n/
	\q[◇取消,TaromatiCancel]'
}
Select.Kikka{
	'\0\s[100]我嗎？\w9\s[2]\n\n/
	\q[◇名字,Kikka_name]\n/
	\q[◇年齡,Kikka_age]\n/
	\q[◇興趣,Kikka_interest]\n[150]/
	\q[◇返回,Introduction]'
}
Select.Kikka_name{
	'\0\s[8]那個…\w9\s[26]我叫做『橘花』\w9。\w9\w5\s[0]\n[150]『橘樹』的『花』、\n念做『Kikka』。\n[250]\q[◇返回,Kikka]'
}
Select.Kikka_age{
	'\0\s[0]我的年齡嗎？\w9\n嗯…\w9\s[3]對不起、我也不太清楚。\w9\s[26]\n[150]啊、不過大概、\n就跟外表看起來的年齡一樣吧。\w9\w9\s[8]\n雖然可能成長的比較慢…\n[250]\q[◇返回,Kikka]'
}
Select.Kikka_interest{
	'\0\s[20]興趣、是嗎？\w9\n[150]像是讀書…散步…\w9\n啊、\s[8]散步只有限定晚上呢…\w9\s[5]\n[150]還有、\w5我也喜歡打掃。\w5\s[21]\n把礙事的東西一掃而空\n感覺很舒服呢。\w9\1\s[13]…聽出不同意義的\w9該不會只有我吧。\0\n[250]\q[◇返回,Kikka]'
	'\0\s[20]興趣、是嗎？\w9\n[150]嗯…\w9\w9\1\s[11]不是花語嗎？\s[10]\n雖然非常不適合。\w9\0\s[6]\n[150]…說的也是呢。\w9\s[0]\n[150]我覺得、花是美麗與虛幻的代名詞。\w9\s[6]\n為那虛幻的美麗所附加的言語。\w9\w9\s[8]\n雖然不能表達的很清楚、\s[26]\n這樣想的話就覺得有點感興趣了。\w9\1\s[10]\n[150]唔。\0\n[250]\q[◇返回,Kikka]'
}
Select.Towa{
	'\0\s[30]\1\s[12]嗯。\0\n\n/
	\q[◇名字,Towa_name]\n/
	\q[◇年齡,Towa_age]\n/
	\q[◇興趣,Towa_interest]\n[150]/
	\q[◇返回,Introduction]'
}
Select.Towa_name{
	'\1\s[10]『鬥和』。\w9\n發音作『Towa』…\n名字只是同音的漢字拿來湊合。\w9\0\s[30]前任飼主取的嗎？\w9\1\s[10]\n[150]不、我沒有被飼養。\0\n[250]\q[◇返回,Towa]'
}
Select.Towa_age{
	'\1\s[10]因為最近沒在數、也搞不清楚了。\w9\s[13]\n就算去數、也沒什麼意義吧…\0\s[30]？\n[250]\q[◇返回,Towa]'
}
Select.Towa_interest{
	'\1\s[10]逃避現實吧。\w9\0\s[8]…那不是很糟糕嗎？\w9\1\s[10]\n[150]因為發生過很多事啊。\w9\0\n[150]唉…\n[250]\q[◇返回,Towa]'
}
Select.TaromatiCancel{
	'\0\s[0]好的。\w9\w9\1\s[10]總之、不管我們說什麼、\n最後、\w5\s[12]還是要看你怎麼想…\s[10]所以說啊。\w9\n[150]任誰都有秘密。\n想知道別人的一切是不可能的。\w9\0\s[8]\n[150]雖然這麼說、我也沒有特別去保密喔。'
}
//---------- 系統環境 ----------------------------------------------------
Select.System{
	Lunar
	_ampm = TimeName
	_hour=hour12ex
	if !TOINT(timehour[0]) {
		_ampm=''
		_hour=(hour+timehour[1])%24
	}
	_color = 'default'
	if weekday == 0 || weekday == 6 {
		_color = '238,50,95'
	}
	_sysname=CALLSAORI('cpuid','os.name')
	if InVM
		_sysname+='  虛擬機器'
	"\*\0\s[0]\b[2]像這個樣子。\n\_q\n/
	%(year)年%(month)月%(day)日  \f[color,%(_color)]星期%(lunardata[3])\f[color,default]   %(_ampm)%(_hour)點%(minute)分\n/
	農曆 %(lunardata[4])年 %(lunardata[5])月%(lunardata[6])    \f[color,238,50,95]%(lunardata[10])\f[color,default]\n[150]/
	\n[half]/
	ＣＰＵ：%(CPU_name)\n/
	ＯＳ：%(_sysname)\n/
	記憶體使用率：%(memoryload)\%\n/
	記憶體(全體)：%(memorytotalphys/1048576) MB\n/
	記憶體(空閒)：%(memoryavailphys/1048576) MB\n/
	ＯＳ起動時間：%(systemuphour)小時%(systemupminute)分\n/
	\n[half]/
	人格初始化日期：%(firstboottime[0])年%(firstboottime[1])月%(firstboottime[2])日 %(firstboottime[3])時%(firstboottime[4])分\n/
	人格起動時間：%(ghostuptime/3600)小時%(ghostuptime/60%60)分\n/
	人格總計起動時間：%(elapsedtime/3600)小時%(elapsedtime/60%60)分\n/
	\n[half]/
	螢幕尺寸：%(displaywidth) x %(displayheight)\n/
	螢幕深度：%(displaybpp)Bit\n/
	\n[half]/
	"
	--
	if NetworkStatus.Hostname
		"主機名稱：%(NetworkStatus.Hostname) \n"
	--
	"用戶呢稱：%(username)\n"
	--
	if NetworkStatus.IP
		"內網IP：%(NetworkStatus.IP)\n"
	--
	InternetIPShowing
	--
	'\n[150]\q[◇返回,OnOpenMenu,4]    \q[◇終了,Cancel]\_q'
}
DayofWeek_w{
	('日','一','二','三','四','五','六')[weekday]
}
