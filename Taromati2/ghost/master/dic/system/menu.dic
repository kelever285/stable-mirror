TheDefaultValue:void{
	_name=_argv[0]
	_argv[0]=IARRAY
	if _argc==2
		_argv=_argv[0]
	if !ISVAR(_name)
		LETTONAME(_name,_argv)
}
OnOptionSet:void{
	Select.Option
}
Select.Option{
	'\_q\b[2]'
	--
	_t = '○,●'
