		TheDefaultValue('setting.OnErrorLogAlarm',1)
		"錯誤記錄警告		\_l[120]\q[%(_t[TOINT(setting.OnErrorLogAlarm)]) ON,Onusage,setting.OnErrorLogAlarm,1]  ・  \_l[180]\q[%(_t[1 - TOINT(setting.OnErrorLogAlarm)]) OFF,Onusage,setting.OnErrorLogAlarm,0]\n"
