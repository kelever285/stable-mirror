//**************************************
//要顯示圖片必須shell的名字和shell的資料夾名字一樣,或者先切換一次該shell就可以了
//其實可以使用\![get,property,事件,currentghost.shelllist(外表名稱).path],路徑會在事件的reference0傳回,不過如果外表名稱中帶有括弧的話會無法實現...
//**************************************
//---- SHELL更替開始 -----------------------------------------------------------------
OnShellChanging{
	if NeedsUpdateSurfaceDump
		UpdateSurfaceDump
	--
	if IsHShell(reference0) && !CanH{
		"\0\s[7]真是的，%(username)都在想些什麼？\n我們的關係還沒有好到可以做H的事的程度吧\w[1000]"
		return
	}
	if HavingShell(reference3)
		OnChangeShellTalk(reference0)
	else
		'\0\s[-1]\b[-1]'
}
OnAutoChangeShell{
	if TOINT(AutoShellChange[1])==0&&month==AutoShellChangeflag[0]&&day==AutoShellChangeflag[1]//'每天初見更換'
		return
	elseif TOINT(AutoShellChange[1])==1//每次問好更換
		do_nothing
	elseif TOINT(AutoShellChange[1])==2{//每四小時更換
		if hour<AutoShellChangeflag[2]+4
			return
	}
	Lunartime
	SETDELIM(Haveshellinfo,'*')
	_shellid=''
	if GetPhase<1{
		OnSilentChangeShell('預設')
		return
	}
	if GetPhase==1 && shellID=='預設'{
		return
	}
	foreach Haveshellinfo;_i{
		_t=_i[0,'|']
		if lunartime[10] {
			case lunartime[10]{
				when '元旦'{
					if _t=='和服' || _t=='浴衣'{
						_shellid=_t+'|'
						break
					}
				}
				when '萬聖節'{
					if _t=='萬聖節'||_t=='ハロウィン'{
						_shellid=_t+'|'
						break
					}
				}
				when '耶誕節'{
					if _t=='聖誕服裝'||_t=='聖誕服裝'{
						_shellid=_t+'|'
						break
					}
				}
			}
		}
		if month==2&&day==22{//貓咪日
			if _t=='貓耳'||_t=='貓耳裝'{
				_shellid=_t+'|'
				break
			}
		}
		elseif month==3&&day==5{//巫女日
			if _t=='銀狐巫女'{
				_shellid=_t+'|'
				break
			}
		}
		elseif month==3&&day==9{//初音日
			if 'miku' _in_ _t{
				_shellid=_t+'|'
				break
			}
		}
		elseif month==3&&day==28||month==4&&day==29{//《朧村正》發行日
			if 'momohime' _in_ _t{
				_shellid=_t+'|'
				break
			}
		}
		elseif month==4&&day==8{//魂魄 妖夢生日
			if _t=='Youmu Konpaku'{//魂魄 妖夢
				_shellid=_t+'|'
				break
			}
		}
		elseif month==5&&day==2{//女僕日
			if _t=='女僕'||_t=='女僕裝'||_t=='Sakuya Izayoi'{
				_shellid=_t+'|'
				break
			}
		}
		elseif month==6&&day==10||month==8&&day==11||month==9&&day==27{//東方紅魔鄉發售
			if _t=='Sakuya Izayoi'{//十六夜 咲夜
				_shellid=_t+'|'
				break
			}
		}
		elseif month==8&&day==17{//東方風神錄發售
			if _t=='Momizi Inubashiri'{//犬走椛
				_shellid=_t+'|'
				break
			}
		}
		elseif month==9&&day==3{//小原節子生日
			if _t=='SETSUKO OHARA'{//小原節子 - 超級機器人大戰Z
				_shellid=_t+'|'
				break
			}
		}
		elseif month==10&&day==13{//世界保鍵日
			if _t=='白衣護士'||_t=='護士服裝'||_t=='ナース'{
				_shellid=_t+'|'
				break
			}
		}
		elseif month==10&&day==22{//win7發行日
			if _t=='WIN7'{
				_shellid=_t+'|'
				break
			}
		}
		elseif month==10&&day==25{//灣娘生日
			if 'taiwan' _in_ _t{
				_shellid=_t+'|'
				break
			}
		}
		else{
			if month==3||month==4||month==5{
				if (_t=='傳統衣著' || _t=='浴衣') && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='體操服'{
					_shellid+=_t+'|'
				}
				elseif _t=='女背心'{
					_shellid+=_t+'|'
				}
				elseif _t=='MeguMegu'{
					_shellid+=_t+'|'
				}
				elseif _t=='キャミソール'{
					_shellid+=_t+'|'
				}
				elseif _t=='ワンピース'{
					_shellid+=_t+'|'
				}
				elseif _t=='黒ワンピ'{
					_shellid+=_t+'|'
				}
				elseif _t=='ドイツ艦（艦これ）'{
					_shellid+=_t+'|'
				}
				elseif _t=='預設'{
					_shellid+=_t+'|'
				}
			}
			elseif month==6||month==7||month==8{
				if (_t=='傳統衣著' || _t=='浴衣') && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif '夏服' _in_ _t{
					_shellid+=_t+'|'
				}
				elseif _t=='吊帶裙-粉紅' && GetPhase>=4{
					_shellid+=_t+'|'
				}
				elseif _t=='旗袍' && GetPhase>=3{
					_shellid+=_t+'|'
				}
				elseif _t=='ワンピース' && GetPhase>=1{
					_shellid+=_t+'|'
				}
				elseif _t=='黒ワンピ'{
					_shellid+=_t+'|'
				}
				elseif _t=='裝甲削って高機動化'{
					_shellid+=_t+'|'
				}
				elseif _t=='膝隠して太腿隠さず'{
					_shellid+=_t+'|'
				}
				elseif _t=='キャミソール'{
					_shellid+=_t+'|'
				}
				elseif _t=='しましま水著' && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='水玉水著' && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='裸Yシャツ' && GetPhase>=4{
					_shellid+=_t+'|'
				}
				elseif _t=='預設'{
					_shellid+=_t+'|'
				}
			}
			elseif month==9||month==10||month==11{
				if (_t=='傳統衣著' || _t=='浴衣') && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='ワンピース' && GetPhase>=1{
					_shellid+=_t+'|'
				}
				elseif _t=='white base'{
					_shellid+=_t+'|'
				}
				elseif _t=='MeguMegu'{
					_shellid+=_t+'|'
				}
				elseif _t=='SETSUKO OHARA'{
					_shellid+=_t+'|'
				}
				elseif _t=='taiwan'{
					_shellid+=_t+'|'
				}
				elseif _t=='預設'{
					_shellid+=_t+'|'
				}
			}
			elseif month==12||month==1||month==2{
				if (_t=='傳統衣著' || _t=='浴衣') && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='毛衣'{
					_shellid+=_t+'|'
				}
				elseif _t=='犬耳裝' && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='貓耳裝' && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='長裙'{
					_shellid+=_t+'|'
				}
				elseif _t=='連身裙（紅）' && GetPhase>=2{
					_shellid+=_t+'|'
				}
				elseif _t=='Maetel'{
					_shellid+=_t+'|'
				}
				elseif _t=='預設'{
					_shellid+=_t+'|'
				}
			}
		}
	}
	if _shellid{
		SETDELIM(_shellid,'|')
		_n=ARRAYSIZE(_shellid)-1
		__shellid=_shellid[RAND(_n)]
		if _n>1{
			while __shellid==shellID{
				__shellid=_shellid[RAND(_n)]
			}
		}
		AutoShellChangeflag=(month,day,hour)
		if __shellid!=shellID{
			'\0\w9\w9\s[26]啊，\w8請稍等一下哦。\w9\w9\s[-1]\1\s[-1]'
			--
			OnSilentChangeShell(__shellid)
		}
	}
}
OnAutoChangeShell.boot{
	if AutoShellChange[0]
		OnAutoChangeShell
}
HaveShellCount{
	SETDELIM(Haveshellinfo,'*')
	MAX(ARRAYSIZE(Haveshellinfo)-1,0)
}
OnBuyShell{
	if money>=5000{
		BuyingShellID=reference0
		money-=5000
		"\1\s[10]\0\s[0]花費￥5000金錢啟動%(reference0)。\w9\w9\x\![change,shell,%(reference0)]"
	}
	else{
		'\1\s[10]\0\s[9]很遺憾，錢不夠啊。\w9\w9\w9'
		--
		OnSilentChangeShell(reference1)
	}
}
OnDressupChanged{
	NeedsUpdateSurfaceDump=1
}
UpdateSurfaceDump{
	_shellID=shellID
	if _argv[0]
		_shellID=_argv[0]
	else
		ERASEVAR('NeedsUpdateSurfaceDump')
	if (_dirname=GetShellIDbyName(_shellID))!=''{
		void MKDIR('VAR_PATH\surface_dumps')
		_surface_dump_dir='VAR_PATH\surface_dumps\'+_dirname
		void MKDIR(_surface_dump_dir)
		'\![execute,dumpsurface,'+_surface_dump_dir+',0,"0-3,5,7,20,21,22,23,26,30,32"]'
	}
}
HasSurfaceDump{
	_shellID=shellID
	if _argv[0]
		_shellID=_argv[0]
	_surface_dump_dir='VAR_PATH\surface_dumps\'+GetShellIDbyName(_shellID)
	FILEEXIST(_surface_dump_dir)
}
//---- SHELL更替完畢 -----------------------------------------------------------------
OnShellChanged{
	if IsHShell(reference0) && !CanH{
		if IsHShell(shellID)
			shellID='預設'
		"\0\s[-1]\![raise,OnSilentChangeShell,%(shellID)]"
		return
	}else{
		'\0\s[0]'
	}
	--
	_temp=shellID
	shellID = reference0
	if !HasSurfaceDump
		NeedsUpdateSurfaceDump=1
	--
	if AutoUpdate
		OnSilentUpdate.shell
	--
	if SilentShellChange{
		ERASEVAR('SilentShellChange')
		return
	}
	if BuyingShellID==shellID{
		SETDELIM(reference2,'/')
		_p=reference2[ARRAYSIZE(reference2)-2]
		Haveshellinfo+="%(reference0)|%(_p)*"
		ERASEVAR('BuyingShellID')
	}
	if HavingShell(_temp){
		if bedroom == '1'
			'\0\s[0]…嗯、\w9\w9\s[5]洗好了嗎？\n\n\q[◇洗好了,Choice9]\n\q[◇沒事了,Choice2]\x'
		else
			'\0\s[0]…嗯、\w9\w9\s[5]這樣子如何呢？'
	}
	else
		"\1\s[10]\0\s[0]…嗯、\w9\w9橘花還沒有啟動這套衣服呢,要給橘花購買能量水晶啟動嗎?花費￥30000金錢.\n\n\q[◇是的,OnBuyShell,%(shellID),%(_temp)]\n\q[◇不了,OnSilentChangeShell,%(_temp)]"
}
//**************************************************************************************************************
OnFittingRoom:all{
	if NeedsUpdateSurfaceDump
		UpdateSurfaceDump
	--
	_j=1
	_q=''
	_shellID=shellID
	if reference0 {
		_j=TOINT(reference0)
	}
	if IsHShell(reference1) && !CanH{
		_q='當前關係還不允許啟動這件衣服'
	}
	elseif reference1 && reference1!=shellID &&reference1==reference2{
		_q="\f[color,242,35,250]\![*]\q[確定 換裝為%(reference1),OnChangeShellWithTalk,%(reference1)]\f[default]"
		_shellID=reference1
	}
	elseif reference1!=reference2{
		_q="沒有啟動這件衣服\n\&[hearts]\q[◇購買啟動%(reference1)（￥5000）,OnBuyShell,%(reference1),%(_shellID)]"
		_shellID=reference1
	}
	_haveshellnum=0
	foreach shelllist; _i{
		if HavingShell(_i)
			_haveshellnum++
	}
	"\C\![quicksession,true]\c\![set,choicetimeout,0]\0\s[26]\b[2]橘花共有%(shellcount)件衣服哦"
	if shellcount!=_haveshellnum
		"，其中%(_haveshellnum)件已啟動"
	"，%(username)想讓橘花穿那件衣服呢？\n[140]"
	_surface_preview=''
	if (_t=GetShellIDbyName(_shellID))!=''{
		_Shellrand=ANY('0','1','2','3','5','7','20','21','22','23','26','30','32')
		_surface_preview="VAR_PATH/surface_dumps/%(_t)/surface%(_Shellrand).png"
		if !FILEEXIST(_surface_preview)
			_surface_preview=''
	}
	if !_surface_preview{
		if FILEEXIST('DATA_PATH/shell/surface_unknown.png')
			_surface_preview='DATA_PATH/shell/surface_unknown.png'
	}
	if _surface_preview
		"\_b[%(_surface_preview),40,30,--option=use_self_alpha]"
	_n=1
	_judge=''
	_haveshell=''
	_shelllist=''
	foreach shelllist; _i {
		if _n>=_j && _n<_j+15 {
			if !HavingShell(_i)
				_judge='\f[color,192,192,192]'+_i+'\f[color,default]'
			else{
				_judge=_i
				_haveshell=_i
			}
			if shellID==_i
				_shelllist += "\f[color,240,45,100]\&[hearts]\f[default]\__q[OnFittingRoom,%(_j),%(_i),%(_haveshell)]%(_judge)\__q\n[120]"
			elseif _shellID==_i
				_shelllist += "\f[color,24,98,250]\&[hearts]\f[default]\__q[OnFittingRoom,%(_j),%(_i),%(_haveshell)]%(_judge)\__q\n[120]"
			else
				_shelllist += "\f[color,168,168,168]\&[hearts]\f[default]\__q[OnFittingRoom,%(_j),%(_i),%(_haveshell)]%(_judge)\__q\n[120]"
		}
		_n ++
	}
	_shelllist
	'\n[30]'
	if shellcount>15{
		if _j!=1
			"\q[<<上一頁,OnFittingRoom,%(_j-15)]   "
		if _j+15<shellcount
			"\q[下一頁>>,OnFittingRoom,%(_j+15)]"
	}
	'\n[140]'
	_q
	'\_l[0,-]\n[150]/
	\![*]\q[返回上一層,OnOpenMenu,1]\n/
	\![*]\q[查看可下載shell,OnUrlOpen,https://github.com/kelever285/Taromati2/releases/tag/shell_list]\n/
	\![*]\q[取消,overchangeshell]/
	'
}
isDefaultHavingShell{
	_a=0
	_HaveshellList='預設,預設,聖誕服裝,聖誕服裝,萬聖節,ハロウィン,旗袍,浴衣,夏服,競泳水著,白スク水,スク水,裸Yシャツ,拘束衣,水玉水著,夏服2,長裙,護士服裝,tail,貓耳,バニーガール,銀狐巫女,女僕裝,女僕,キャミソール,背心,セーター,體操服,全裸'
	foreach _HaveshellList; _i {
		if _argv[0] == _i
			_a=1
	}
	_a
}
GetShellIDbyName{
	_a=''
	SETDELIM(Haveshellinfo,'*')
	foreach Haveshellinfo; _i {
		if _argv[0] ==  _i[0,'|']
			_a=_i[1,'|']
	}
	_a
}
HavingShell{
	if Userspitem[0][2]==1
		1
	elseif isDefaultHavingShell(_argv[0])
		1
	elseif BuyingShellID == _argv[0]
		1
	else
		NameInHaveShellInfo(_argv[0])
}
NameInHaveShellInfo{
	_a=0
	SETDELIM(Haveshellinfo,'*')
	foreach Haveshellinfo; _i {
		if _argv[0] ==  _i[0,'|']
			_a=1
	}
	_a
}
OnChangeShellTalk{
	case reference0 {
		when '預設','預設' {
			'還是穿平時的比較好嗎？\w9'
		}
		//此處可以添加不同衣著的特殊對話
		//------------------------------------------------------------------------
		when '聖誕服裝', '聖誕服裝'{
			if month == 12 && day == 24
				'\0\s[5]今天是聖誕前夜啊.\w9\w9是應該換上這套衣服的.\w9\w9\n'
			elseif month == 12 && day == 25
				'\0\s[5]今天耶誕節啊……\w9\w9嗯,\w9橘花馬上去換.\w9\w9\n'
			else
				"\0\s[20]%(username)為什麼要橘花現在換上這件衣服呢?\w9\n\1\s[10]也許是穿上這件衣服的橘花顯得比較可愛吧.\w9\w9\n\0\s[29]唔……\w9\w9\n"
		}
		when '萬聖節','ハロウィン' {
			if month == 10 && day == 31
				'\0\s[8]呃…\w9萬聖節…\w9\w9換上相應的衣服…\w9\w9也是應該的啊…\w9\w9\n\1\s[11]告訴你,\w9其實橘花很怕那東西的\w9\0\s[9]哪有…\w9\w9把你裝進南瓜燈裡面.\w9\1\s[12]嗚哇……\w9\w9\n\0'
			else
				"\0\s[20]%(username)為什麼要橘花現在換上這件衣服呢?\w9\n\1\s[10]也許是穿上這件衣服的橘花顯得比較可愛吧.\w9\w9\n\0\s[29]唔……\w9\w9\n"
		}
		when '旗袍','チャイナ' {
			"\0\s[5]中國傳統服飾哦,\w9%(username)應該很熟悉了吧\w9\w9"
		}
		when '浴衣' {
			"\0\s[23]這套是橘花洗完澡以後才穿的,\w9%(username)喜歡橘花這樣穿的樣子嗎?\w9\w9"
		}
		when '夏服' {
			'\0\s[0]這套,\w9是白色的夏裝哦\w9\w9\n因為容易弄髒,\w9\s[21]所以橘花很少穿啦\w9\w9\1\s[10]我對容易被什麼弄髒很感興趣\w9\w9\0'
		}
		when '競泳水著' {
			"\0\s[26]難道…\w9%(username)喜歡橘花在學校時穿的泳裝?\w9\n\1\s[11]總是會有那種人的嘛,\w9可以理解\w9\w9\0"
		}
		when '白スク水','スク水','裸Yシャツ','拘束衣' {
			'\0\s[33]嗚……\w9\w9好難為情的衣服啊\w9\n'
		}
		when '水玉水著' {
			"\0\s[9]明明在屋子裡,\w9%(username)為什麼要橘花穿這種衣服\w9\w9\n"
		}
		when '夏服2' {
			'\0\s[0]橘花夏天穿的衣服,\w9\w9\s[3]又輕又結實,\w9\w9\s[5]還不容易被血弄髒\w9\w9\n\1\s[13]說到什麼地方去了啊\w9\w9\0'
		}
		when '長裙' {
			"\0\s[1]這套,\w9是橘花根據經常穿的正裝自己改的說.\w9\w9\n/
			\s[26]不知道%(username)喜不喜歡\w9\w9\n\1\s[10]換上讓他看看不就知道了嗎\w9\w9\0"
		}
		when '護士服裝' {
			'\0\s[2]說起來,\w9\w9橘花\w9\s[5]也是學習過戰場救護的哦\w9\n\1\s[10]沒問你這個…\w9\w9\0'
		}
		when 'tail' {
			'\0\s[8]呃…\w9…\w9\w9鬥和沒問題吧.\w9\n\1\s[13]扯上我幹什麼\w9\w9\0'
		}
		when '貓耳','バニーガール','銀狐巫女' {
			'\0\s[8]這套…\w9\w9有點\w9\w9\s[21]難為情啊…\n\1\s[11]明明很期待的樣子.\w9\w9\w9\0'
		}
		when '女僕裝','女僕' {
			"\0\s[9]咦……\w9\w9原來%(username)是萌女僕的呀～\w9\w9\n可是…\w9\s[5]Ｈ是不行的唷～\w9\w9\n\n/
			\1\s[12]你想到哪裡去了啊……\w9\w9\n\n\0那橘花去換衣服咯～\w9\1\s[11]好好聽聽別人說話啦！\w9\0"
		}
		when 'キャミソール','背心' {
			'\0\s[5]橘花很喜歡這件背心，夏天穿很舒服呢～\w9\w9'
		}
		when 'セーター' {
			'\0\s[5]很暖和的樣子\w9\w9'
		}
		when '體操服' {
			"\0\s[26]難道…\w9%(username)喜歡橘花在學校時穿的體操服?\w9\n\1\s[11]總是會有那種人的嘛,\w9可以理解\w9\w9\0"
		}
		others {
			"\0\s[0]%(reference0)嗎?\w7\n"
			--
			'\s[6]好的,'
			''
			--
			'\w7\s[26]知道了\n'
			--
			'\w5\s[-1]那橘花去換衣服了哦'
			'\w5\s[-1]橘花換衣服了哦'
			--
			'~'
			",%(username)不許偷看哈♪"
		}
	}
	--
	'\s[-1]\b[-1]\w9'
}
Select.overchangeshell{
	"\0不用換也行嗎?\w6\n果然是%(shellID)好嗎～"
}
On_installedshellname{
	shelllist = reference
	shellcount = ARRAYSIZE(shelllist)
}
