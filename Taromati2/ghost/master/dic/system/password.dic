InitPassword : void{
	SQLite("UPDATE password SET password='void' WHERE ID=0")
}
OnChangePassword{
	"\0\s[5]那個...%(username)要把密碼改成什麼哦?\n\w8要容易記的,不能忘記哦~\w8\1忘記的話會怎麼樣呢?\0\w8\n......\![open,passwordinput,OnPasswordUpdate,-1]\n[300]\![set,choicetimeout,0]\q[◇不改了,overPasswordInput]\n/
	\q[◇返回,OnPasswordTrue]"
}
OnPasswordUpdate{
	_password = password
	_new_pass = reference.raw[0]
	if _new_pass == '' || _new_pass == _password {
		if !ISVAR('HaveNotGetPassword')
			'\0\s[20]那個...請輸入新密碼喔...\![open,passwordinput,OnPasswordUpdate,-1]\n[300]\q[◇不改了,overPasswordInput]'
	}
	elseif "'" _in_ _new_pass {
		"\0\s[21]那個...不可以使用英文『 ' 』哦！請重新輸入~\![open,passwordinput,OnPasswordUpdate,-1]\n[300]\q[◇不改了,overPasswordInput]"
	}
	else {
		_a = passwordUpdate(_new_pass)
		if !_a {
			'\0\s[29]'
			--
			if !HaveNotGetPassword
				'新'
			--
			"密碼:%(REPLACE(_new_pass,'\','\\'))\n橘花已經記下了哦,\w8%(username)也要記住喔~"
		}
		else {
			BUGNow('密碼更新失敗')
		}
	}
}
passwordUpdate{
	SQLite("UPDATE password SET password='%(_argv[0])' WHERE ID=0")
}
password{
	SQLite('-j','SELECT password FROM password WHERE ID=0')
}
Select.SecretService{
	"\0\s[40]阿啦阿啦~~\w6%(username)要進入秘密服務項啊..\w9\n嗯，那麼..\w9\s[22]\w9現在開始確認身份喔~\w5\![open,passwordinput,OnPasswordInput,-1]"
}
OnPasswordInput{
	_password = password
	_input = reference.raw[0]
	if _input == '' {
		"\0\s[34]那個..\w4要有密碼才能通過哦..\w9%(username)特別交代的哦~\1\s[11]拿著刀.........\0"
	}
	elseif _input == _password {
		"\0\s[5]身份確認完畢..\w8\真是%(username)哦~\w9那麼\w9沒什麼事了喔~\1\s[11]被玩了....\w9\w9\w9\w9\0\s[21]\n橘花開玩笑的啦，看下麵哦...\s[5]\w9\n[150]"
		--
		OnPasswordTrue
	}
	else {
		"\0\s[35]身份確認失敗....\w9\w9\1\s[11]...\0\s[32]\n那個....\w4有些事只能和%(username)做哦，外人就不行的說~~\1\s[11]\n也用不拿槍吧...."
	}
}
Select.overPasswordInput{
	'\0\s[5]密碼不用改也可以嗎,好的,橘花知道了喔~\![close,inputbox,OnPasswordUpdate]'
}
OnPasswordTrue{
	'/
	\q[◇來H吧,OnH]\f[color,238,50,95]\&[hearts]\f[default]\n/
	\q[◇資料庫管理,OnUserDatabase]\n/
	\q[◇導入備份,OnBackupLeadMenu]\n/
	\q[◇修改密碼,OnChangePassword]\n[250]/
	\q[◇取消,overjp]'
}
Select.overjp{
	'\0\s[5]這樣嗎,嗯嗯,好的'
}
