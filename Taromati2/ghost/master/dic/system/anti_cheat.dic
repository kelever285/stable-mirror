//by steve02081504
AntiCheatWatcher{
	_varname=_argv[0]
	_var=_argv[1]
	_CanaryValueName='CanaryValue.'+STRDIGEST(_varname)
	_CanaryValue=EVAL(_CanaryValueName)+72
	if _CanaryValue!=_var{
		if ISVAR(_CanaryValueName){
			if !EVAL('CheattedTrigging.'+_varname){
				LETTONAME('CheattedTrigging.'+_varname,1)
				SHIORI_FW.PushNoBreakNotifyResult("\![raise,OnValueCheatted,%(_varname),%(_CanaryValue),%(_var)]")
			}
			_CanaryValue
			return
		}
		else{
			LETTONAME(_CanaryValueName,(_var-72))
			_var
			return
		}
	}
	_CanaryValue
}
AntiCheatSetter{
	_varname=_argv[0]
	_var=_argv[1]
	_var_before=_argv[2]
	_CanaryValueName='CanaryValue.'+STRDIGEST(_varname)
	_CanaryValue=EVAL(_CanaryValueName)+72
	if _CanaryValue!=_var_before{
		if ISVAR(_CanaryValueName){
			if !EVAL('CheattedTrigging.'+_varname){
				LETTONAME('CheattedTrigging.'+_varname,1)
				SHIORI_FW.PushNoBreakNotifyResult("\![raise,OnValueCheatted,%(_varname),%(_CanaryValue),%(_var_before)]")
			}
			_CanaryValue//恢復值內容
			return
		}
	}
	LETTONAME(_CanaryValueName,(_var-72))
	_var
}
AntiCheat{
	_varname=_argv[0]
	FUNCDECL_READ(_varname,'AntiCheatWatcher')
	FUNCDECL_WRITE(_varname,'AntiCheatSetter')
	if ISVAR('CanaryValue.'+_varname){
		LETTONAME('CanaryValue.'+STRDIGEST(_varname),EVAL('CanaryValue.'+_varname))
		ERASEVAR('CanaryValue.'+_varname)
	}
}
Init.AntiCheatIniter{
	AntiCheat('money')
	AntiCheat('intimacy')
}
ClearAntiCheatVar{
	ERASEALLVARBEGINAS('CheattedTrigging.')
}
OnValueCheatted{
	_varname=reference0
	_var_should_have=reference1
	_var_cheatting_to=reference2
	case _varname{
		when 'money'{
			if _var_cheatting_to>_var_should_have{
				money-=MAX(_var_should_have/2,100)
				"\0\s[0]嗯，\s[26]\w9如果缺錢的話，\w9橘花覺得%(username)還是好好去工作比較好哦\w9\n/
				\s[22]作弊是要接受懲罰的哦？"
				// 哎？%(username)缺錢了嗎？
				// 嗯…………如果是這樣的話……
				// 稍等一下哦，橘花去跑一趟。
				// // 跑個外快什麼的
				// 等一下，你拿槍做什麼？給我回來！
			}
			else{
				'\0\s[8]把金錢改的更小\w9.\w9.\w9.\n/
				這是什麼新的懲罰項目嗎？\n'
				--
				if _var_cheatting_to < -200000
					'\1\s[10]也可能是改的數值過大結果溢出了啊，\w9\w9\s[12]對吧\w9\n/
					\0\s[8]啊哈哈'
			}
		}
		when 'intimacy'{
			if _var_cheatting_to>_var_should_have{
				intimacy=MIN(-10,-_var_should_have/2,_var_should_have*10)
				"\![enter,passivemode]\0\s[30]斗和，問你一個問題。\w9\n/
				\1\s[11]什麼？\w9\n/
				\0如果有人強行要把你和他的關係拉好\w9，而且不顧你的意願的話要怎麼辦呢？\w9\w9\n/
				\1這種人一般會被叫做渣男吧？\w9\n/
				\0\s[6]說得也是呢。\w9\n/
				\s[22]那就讓%(username)成為渣男好了，物理意義上的。\w9\n/
				\1啊，%(username)你最好快點道歉比較好哦。\w9\n/
				\0\s[32]遲了。\w9\n\![raise,OntriggerBSOD,0xc000007F]"
			}
			else{
				case GetPhase{
					when 4-5
						"\0\s[26]%(username)是不是討厭我了呢?\w9\w9\n/
						\s[3]可以的話直說就好\w9.\w9.\w9.\w9.\w9."
					when 3-2{
						'\0\s[20]唔\w9…\w9…\s[30]斗和，\w9人會在什麼樣的情況下要讓一個關係本來不錯的人關係變差呢？\w9\w9\n/
						\1\s[10]你是在說想要分手卻又不肯明說的人嗎？\n'
						--
						if !RAND(4){
							if intimacy >= 50
								intimacy=0
							else
								intimacy=-10
							'\0\s[2]啊\w9，原來是分手嗎？\w9\n/
							\s[0]原來如此，\s[5]橘花明白了，我聽過一個詞，\s[21]是分手炮來著？\w9\n/
							\s[22]那麼這是分手禮物，接下吧，橘花的炮，一定會很壯觀呢。\w9'
							--
							'\1\s[11]'
							--
							'等一下\w9，這個詞不是這麼用的！'
							'不對\w9，這個詞你是從哪聽來的！'
							--
							'\![raise,OntriggerBSOD,0xc000007F]'
						}
					}
					when 1
						'\0\s[26]啊，\w9那個\w9—\w9—\w9\n/
						\s[8]把好感改低，\w9是什麼意思呢？'
					when 0{
						intimacy-=2
						'\0\s[7]是抖m麼?\w9\w9\n/
						\s[6]真是沒救的陽痿豬頭男呢\w9'
					}
					when -1{
						intimacy-=3
						'\0\s[7]\w9\![raise,OntriggerBSOD,0xc000007F]'
					}
				}
			}
		}
	}
	ERASEVAR('CheattedTrigging.'+_varname)
}
