OnTest{
	'\![sound,play,SOUND_PATH\shot.wav]'
}
do_nothing{}
NeedRewrite:void{}

Taromati2.asciiArt{
	'/
	​ :::::,::::;                                                         ,:,,:::\n/
	​     :,                                                  :,         ::,   ::\n/
	​    ,,                                                  :,,              ,:\n/
	​    :                                             ::,                   :,\n/
	​   ,,     ,:,                  ,       ,  ,,,     ,::,:,,:            ,\n/
	​   :    :::::,  ::,:,  ::,    ,:::,,,:, ::::,,   ::  , ,,           :\n/
	​  ,        ,:   ::,   ::  ,,  ,:  :,       ,:   :,     ,           ,\n/
	​  ,     ,, ,,   ,,   ::   ,  ,:   ,  :  ,, ,,   ::    ,          :\n/
	​       ,:,:::  ,,     ,::,   ,,  :   , ,:,,::  ::     ,         ,:::,,,\n/
	​                                                ,     ,\n/
	'
}

Select.Cancel{
	if mode == '0'
		'\0\s[6]好的'
	elseif mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]哦。\n"
	--
	BaseSelect.base(_argv)
}
Select.Thanks{
	if mode == '0'
		'\0\s[2]啊\w9…\w9…\n/
		\s[1]謝謝。\n/
		'
	elseif mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]哦\w9，也好。\n"
	--
	BaseSelect.base(_argv)
}
BaseSelect.base{
	case _argv[0]{
		when 'with_sakura'
			_argv[1]
		when 'with_func'{
			_argv[0]=IARRAY
			_fname=_argv[0]
			_argv[0]=IARRAY
			EVAL("%(_fname)(%_argv)")
		}
	}
}
Select.UnFinished{
	UnFinished
}
UnFinished{
	'\0\s[3]很遺憾\w9\w9，這是一個未完成的機能。\n/
	\1\s[12]該好好努力啦\w9\n/
	自己動手才能豐衣足食哦\w9\n/
	\0/
	\q[◇協助專案開發,OnUrlOpen,https://github.com/kelever285/Taromati2#%E6%88%91%E8%AF%A5%E5%A6%82%E4%BD%95%E5%8F%82%E4%B8%8E%E5%BC%80%E5%8F%91]\n/
	\q[◇不了,Cancel]\n/
	'
}
BUGNow{
	'\0\s[8]失敗了...\n'
	_error_header=_argv[0]
	_error_detail=_argv[1]
	_error_header_for_show=REPLACE(_error_header,'\','\\')
	--
	if _error_header
		'原因是：'+_error_header_for_show+'\n'
	else
		'未知bug嗎?\n'
	--
	if _error_detail
		'/
		\q[◇複製錯誤記錄,OnCopy,'+SakuraScriptArgConverter(_error_detail)+']\n/
		\q[◇在github提交issue,OnUrlOpen,'+SakuraScriptArgConverter(/
			"https://github.com/kelever285/Taromati2/issues/new?labels=bug&template=bug-report.yaml&/
				title=%(ToUrlParam(_error_header))&/
				additional-context=%(ToUrlParam(_error_detail))"/
		)+']\n/
		'
	else
		'\q[◇前往彙報,OnUrlOpen,https://github.com/kelever285/Taromati2#bug%E5%8F%8D%E9%A6%88]\n'
	--
	'\q[◇不了,Cancel]\n'
}
OpenDocForRuntime.string{
	'\![open,browser,https://github.com/kelever285/Taromati2/blob/master/docs/runtime/'+_argv[0]+'.md]'
}
OpenDocForRuntime{
	SHIORI_FW.PushNoBreakNotifyResult(OpenDocForRuntime.string(_argv[0]))
}
OnEraseVar{
	ERASEVAR(reference0)
	'完成了'
}
OnSet{
	LETTONAME(reference0,reference1)
	'完成了'
}
AntiFlicker{
	'\C\![lock,balloonrepaint]\c'+_argv+'\![unlock,balloonrepaint]'
}
