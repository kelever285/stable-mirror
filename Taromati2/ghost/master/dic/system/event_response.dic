//平臺更新反應by steve02081504
OnBasewareUpdating{
	BasewareUpdating=1
	'\1\s[10]\0\s[6]嗯…\w9\w9\s[0]\n'
	--
	"/
	基礎平臺“%Baseware”\n/
	當前版本%Baseware.Version\w9\w9\n/
	開始更新\n/
	"
	--
	'\s[6]\w9\w9\w9'
}
OnBasewareUpdated{
	ERASEVAR('BasewareUpdating')
	OnSQLLoad.Fixer
	BaseGhostStart
	--
	'\0\s[5]我回來了\n\w9\w9'
	--
	'\s[0]'
	'\s[26]'
	--
	'讓您久等了。\n\w9\w9'
	--
	"/
	基礎平臺“%Baseware”\n/
	已更新至%Baseware.Version\n/
	"
	--
	if Baseware == 'SSP'
		'/
		\q[◇查看更新內容,OnUrlOpen,http://ponapalt.hatenablog.com/]\n/
		\q[◇無用,Cancel]\n/
		'
}
//Get自我資訊
OnNotifySelfInfo{
	ghostname=reference0
	selfname=reference1
	keroname=reference2
	if !HavingShell(reference3)
		OnSilentChangeShell('預設')
}
//缺省資訊補全&同步資訊更新 by steve02081504
OnNotifyUserInfo.WhenEmpty.username:void{
	if !IsUserName.Special(_argv[0]){
		OnUserName.Set(_argv[0])
	}
	else{
		_steam_name = GetSteamUserName
		if !IsUserName.Special(_steam_name)
			OnUserName.Set(_steam_name)
	}
}
OnNotifyUserInfo.WhenEmpty.birthday:void{
	if _argv[0]{
		void OnBirthdayInput(_argv[0])
	}
}
OnNotifyUserInfo{
	if !username{
		if GetPhase > 1 || !reference1
			OnNotifyUserInfo.WhenEmpty.username(reference0)
		else
			OnNotifyUserInfo.WhenEmpty.username(reference1)
	}
	if !birthday
		OnNotifyUserInfo.WhenEmpty.birthday(reference2)
	_name_changed = 0
	_username = ''
	if GetPhase > 1{
		_name_changed=username != reference0 && Baseware.Config.nickname != reference0 && reference0
		_username=reference0
	}else{
		_name_changed=username != reference1 && Baseware.Config.username != reference1 && reference1
		_username=reference1
	}
	_birthday_changed=birthday != reference2 && Baseware.Config.birthday != reference2 && reference2
	if IsUsername.Empty(_username)
		_name_changed = 0
	if _name_changed || _birthday_changed{
		"同步%Baseware設定中的"
		--
		if _name_changed{
			if GetPhase > 1
				'昵稱'
			else
				'用戶名'
			--
			"『%(REPLACE(_username,'\','\\'))』"
		}
		--
		if _birthday_changed{
			if _name_changed
				'和'
			--
			"生日“%(reference2)”"
		}
		--
		'?\n/
		\q[◇同步,'
		--
		if _name_changed&&_birthday_changed
			'OnNotifyUserInfo.bothUpdate'
		elseif _name_changed
			'OnUserNameInput'
		elseif _birthday_changed
			'OnBirthdayInput'
		--
		if _name_changed
			",%(SakuraScriptArgConverter(_username))"
		--
		if _birthday_changed
			",%(SakuraScriptArgConverter(reference2))"
		--
		']\n/
		\q[◇無用,Cancel]\n/
		'
	}
	--
	Baseware.Config.nickname = reference0
	Baseware.Config.username = reference1
	Baseware.Config.birthday = reference2
}
OnNotifyUserInfo.bothUpdate{
	void OnBirthdayInput(reference1)
	'生日已更新\w9\w9\n'
	--
	OnUserNameInput
}
//硬體接入by steve02081504
OneDeviceChange.GetDeviceUuid{
	_argv[0][4,CHR(1)]
}
OneDeviceChange.GetDeviceFile{
	_t=_argv[0][3,CHR(1)]
	if _t
		_t
	else
		'已卸載'
}
OneDeviceChange.GetDeviceMaker{
	_t=_argv[0][2,CHR(1)]
	if _t && !'相容 USB' _in_ _t
		_t
	else
		'未知廠商'
}
OneDeviceChange.GetDeviceName{
	_t=_argv[0][1,CHR(1)]
	if _t
		_t
	else
		'未知設備名'
}
OneDeviceChange.GetDeviceType{
	_argv[0][0,CHR(1)]
}
OneDeviceChange{
	'設備檔“'+OneDeviceChange.GetDeviceFile(_argv[0])+'”上\n'
	--
	'由“'+OneDeviceChange.GetDeviceMaker(_argv[0])+'”生產的“'+OneDeviceChange.GetDeviceName(_argv[0])+'”\n'
	--
	'已作為“'+OneDeviceChange.GetDeviceType(_argv[0])+'”'
	--
	if OnDeviceChangeNow == 'Arrival'
		'掛載'
	elseif OnDeviceChangeNow == 'Remove'
		'卸載'
	else
		'口口口'
	--
	'\n'
	--
	'\q[◇點此複製硬體uuid,OnCopy,'+SakuraScriptArgConverter(OneDeviceChange.GetDeviceUuid(_argv[0]))+']\n'
	--
	if OnDeviceChangeNow=='Arrival'&&OneDeviceChange.GetDeviceType(_argv[0])=='LogicalVolume'
		'\q[◇打開,OnOpenDirOrFile,'+SakuraScriptArgConverter(OneDeviceChange.GetDeviceFile(_argv[0])+'\')+']\n'
}
OnDeviceChange.Head{
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]唔…\w9\w9\n"
	else
		'\0\s[6]嗯…\w9\w9\s[0]\n'
}
OnDeviceChange.Body{
	_i=0
	_txt=''
	_uuid=''
	while reference.raw[_i]{
		_txt+=OneDeviceChange(reference.raw[_i])+'\n'
		_uuid+=OneDeviceChange.GetDeviceUuid(reference.raw[_i])+C_LF
		_i++
	}
	_txt
	--
	if _i>1
		'\q[◇複製全部uuid,OnCopy,'+SakuraScriptArgConverter(_uuid)+']\n'
	--
	'/
	\q[◇無用,Cancel]\n/
	'
}
OnDeviceArrival{
	if DeviceChangeAlert{
		OnDeviceChangeNow='Arrival'
		OnDeviceChange.Head
		--
		OnDeviceChange.Body
		ERASEVAR('OnDeviceChangeNow')
	}
}
OnDeviceRemove{
	if DeviceChangeAlert{
		OnDeviceChangeNow='Remove'
		OnDeviceChange.Head
		--
		OnDeviceChange.Body
		ERASEVAR('OnDeviceChangeNow')
	}
}
OnOpenDirOrFile{
	if _argv[0]
		reference0 = _argv[0]
	'\![open,file,'+SakuraScriptArgConverter(reference0)+']'
}
//文字拖拽處理 by steve02081504
OnTextDrop{
	infomode=0
	if reference.raw[0]
		temp = reference.raw[0]
	if !RE_GREP(temp,"(?!%(CHR(1)))%(CHR(1))(?!%(CHR(1)))")
		temp = REPLACE(temp,CHR(1)+CHR(1),CHR(1))
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')11]\b[2]唔？\n"
	else
		'\0\s[0]'
	--
	_t=CUTSPACE(temp)
	if SHIORI_FW.DebugMode && RE_GREP(_t,'^[\w.]+$'){
		if (__t=Get_AYA_Function_Info(_t))!=''
			'aya自帶底層函數\n'+__t+'\n/
			\q[◇打開線上文檔,OnUrlOpen,'+Get_AYA_Function_Doc(_t)+']\n/
			'
		elseif ISVAR(_t)
			"變數“%(_t)”\n/
			值：%(GetVarValue.SakuraScript(_t))\n/
			類型：%(GETTYPEEX.string((_t)))\n/
			"
		elseif ISGLOBALDEFINE(_t)
			"全域定義“%(_t)”\n/
			內容：%(GetGlobalDefine.SakuraScript(_t))\n/
			\q[◇複製定義內容,OnCopy,"+GetGlobalDefine.SakuraArg(_t)+']\n/
			'
		elseif Is_Defened_Event_Or_Func(_t)||Is_Defened_Event(_t+'Ex'){
			_EXfunc=!Is_Defened_Event_Or_Func(_t)
			if _EXfunc
				_t=_t+'Ex'
			_t=Get_Func_Or_Full_Defened_Event_Name(_t)
			_info=GETFUNCINFO(_t)
			_path=SPLITPATH(_info[0])
			if _path
				_path=_path[2]+_path[3]
			else
				_path=_info[0]
			"函數“%(_t)”\n"
			--
			if _EXfunc
				'（Ex版本事件）\n'
			--
			"起始於\q[◇%(_path) 第%(_info[1])行,OnOpenDicWithLineNum,%(SakuraScriptArgConverter(_info[0])),%(_info[1])]\n/
			"
		}
		elseif SUBSTR(_t,0,2) == 'On'
			'/
			這可能是一個還未定義的事件\n/
			\q[◇補充定義,OnEventAdd,'+_t+']\n/
			'
	}
	--
	if mode == '0'
		'請選擇處理方式\n'
	--
	if CHR(1) _in_ temp{
		if SHIORI_FW.DebugMode && RE_GREP(temp,"/%(CHR(1))\s*")
			'\q[◇aya形式換行剔除,OnTextDrop.ayaEndlineDelete]\n'
		--
		'\q[◇換行剔除,OnTextDrop.EndlineDelete]\n/
		\q[◇換行轉"\\n",OnTextDrop.EndlineForma]\n/
		'
	}
	--
	_text=REPLACE(temp,CHR(1),C_LF)
	_sakura_text=SakuraScriptArgConverter(_text)
	'/
	\q[◇普通文字回顯,OnTextDrop.CommonText]\n/
	'
	--
	if SHIORI_FW.DebugMode{
		if SUBSTR(CUTSPACE(temp),0,2) == 'On'
			"\q[◇查看事件文檔,OnUrlOpen,%(Get_UKADOC_ofEvent(CUTSPACE(temp)))]\n"
		--
		if IsSakuraScript(temp)
			'\q[◇Sakura Script執行,OnTextDrop.SakuraScript]\n'
		--
		if ISEVALUABLE(temp)
			'\q[◇運算式求值,OnTextDrop.EVAL]\n'
	}
	--
	'/
	\q[◇複製至粘貼板,OnCopy,'+_sakura_text+']\n/
	'
	--
	//若在temp中存在網頁連結
	if RE_SEARCH(temp,'(http|ftp|https):\/\/[\w\-_]+(\.[\w\-_]+)+([\w\-\.,@?^=%&amp;:/~\+#]*[\w\-\@?^=%&amp;/~\+#])?')
		'\q[◇打開網頁,OnUrlOpen,'+RE_GETSTR[0]+']\n'
	--
	if _text!=TOTRADITIONAL(_text)
		'\q[◇簡->繁轉換,OnCopyTS,traditional,'+_sakura_text+']\n'
	--
	if _text!=TOSIMPLIFIED(_text)
		'\q[◇繁->簡轉換,OnCopyTS,simplified,'+_sakura_text+']\n'
	--
	if _text!=TOUPPER(_text)
		'\q[◇全轉大寫,OnCopy,'+SakuraScriptArgConverter(TOUPPER(_text))+']\n'
	--
	if _text!=TOLOWER(_text)
		'\q[◇全轉小寫,OnCopy,'+SakuraScriptArgConverter(TOLOWER(_text))+']\n'
	--
	'/
	\q[◇無用,Cancel]\n/
	'
}
OnTextDrop.ayaEndlineDelete{
	temp=RE_REPLACE(temp,"/%(CHR(1))\s*",'')
	"\%(mode)已剔除\n"
	--
	OnTextDrop
}
OnTextDrop.EndlineDelete{
	temp=REPLACE(temp,CHR(1),'')
	"\%(mode)已剔除\n"
	--
	OnTextDrop
}
OnTextDrop.EndlineForma{
	temp=REPLACE(temp,CHR(1),'\n')
	"\%(mode)已轉換\n"
	--
	OnTextDrop
}
OnTextDrop.CommonText{
	temp=REPLACE(temp,'\','\\')
	temp=REPLACE(temp,CHR(1),'\n')
	temp
}
OnTextDrop.SakuraScript{
	OnSakuraScript(temp)
}
OnTextDrop.EVAL{
	OnCalculateVar(temp)
}
//**** インストール関連 *****************************************************************
//---- インストール中のメッセージ -------------------------------------------------------
OnInstallBegin{
	if mode == '0'
		'\0\s[20]'
	elseif mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]"
	--
	'嗯…'
	'唔…'
}
//---- インストール完了メッセージ -------------------------------------------------------
OnInstallComplete{
	if reference1 == 'Taromati2 full data pack'{
		if QuickStartVersion{
			FullDataPackInstalled=1
			DiscordCustomSet.CustomDetail('好耶')
			--
			'\0\s[6]追加檔案包完成，開始修復性更新\n'
			--
			OnSilentUpdate
		}
		else{
			DiscordCustomSet.CustomDetail('厘在贛什麼')
			--
			'\0\s[8].\w9.\w9.\w9\n/
			已經是完整版了哦？\n/
			'
		}
		return
	}
	DiscordCustomSet.CustomDetail('搞了些新東西')
	--
	if mode == '0'
		'\0\s[0]'
	elseif mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]"
	--
	if reference2
		'複合物'
	elseif reference0 == 'shell'
		'Shell'
	elseif reference0 == 'ghost'
		'人格'
	elseif reference0 == 'balloon'
		'對話方塊'
	elseif reference0 == 'plugin'
		'套件'
	elseif reference0 == 'supplement'
		'追加檔案'
	elseif reference0 == 'headline'
		'線上新聞'
	elseif reference0 == 'language'
		'語言包'
	elseif 'with' _in_ reference0
		'複合物'
	else
		"未知物件“%(REPLACE(reference0,'\','\\'))”"
	--
	"『%(REPLACE(reference1,'\','\\'))』"
	--
	if reference2{
		"與『%(REPLACE(reference2,'\','\\'))』"
	}
	--
	'\n[150]'
	--
	if mode == '0'{
		'支給完成'
		'配置確認'
		'投入確認'
		'追加完成'
	}elseif mode == '1'{
		'安好了'
	}
	--
	'\n'
	--
	_target = SakuraScriptArgConverter(reference1)
	if 'ghost' _in_ reference0 {
		"/
		\q[◇切換,OnChangeGhost,%(_target)]\n/
		\q[◇呼叫,OnCallGhost,%(_target)]\n/
		\q[◇無用,Cancel]\n"
	}
	elseif 'shell' _in_ reference0{
		"/
		\q[◇切換,OnSilentChangeShell,%(_target)]\n/
		\q[◇無用,Cancel]\n"
	}
	elseif 'balloon' _in_ reference0{
		"/
		\q[◇切換,OnChangeBalloon,%(_target)]\n/
		\q[◇無用,Cancel]\n"
	}
}
//---- インストール失敗 -----------------------------------------------------------------------------------------------
OnInstallFailure{
	DiscordCustomSet.CustomDetail('拆彈失敗')
	--
	if reference0 == 'artificial'{
		'\0\s[3]好的。\w9\w9\n已取消安裝。'
		return
	}
	'\0\s[3]好像失敗了…\n\w9\w9'
	--
	if reference0 == 'extraction'{
		'\1\s[10]安裝包損壞了哦\n/
		\w9\s[12]\w9如果重下幾次都這樣的話，就換個下載器試試吧\n'
		--
		'\w9\w9\0\s[30]說起來，aria引擎下載的安裝包，經常損壞呢\n/
		\w9\w9\1\s[10]牆的原因吧\n/
		\w9\w9\0\s[8]欸？\n/
		\w9\w9\1\s[13]牆的原因。'
		''
	}
	elseif reference0 == 'password'{
		'\1\s[10]原因是密碼錯誤。\n/
		\w9\w9\0\s[0]嘗試下作者昵稱、\w9nar內容名稱、\w9對應ghost名稱吧\n/
		\w9\w9\1不會有什麼用的\n/
		\w9\w9\0\s[8]試一下嘍?'
		if GetPhase==0{
			"我雖然早就知道%(username)"
			--
			'不頂用'
			'腦袋不好使'
			--
			'。但沒想到'
			--
			'連這種事都處理不好'
			'密碼都忘記了'
			--
			'\c\s[9]嗯？我什麼都沒說哦……'
		}
	}
	elseif reference0 == 'unlha32'{
		'\1\s[10]原因是unlha32載入失敗。\n/
		\w9\w9\0\s[8]那是什麼？'
	}
	elseif 'invalid' _in_ reference0{
		"\1\s[10]安裝包的格式有誤（%(reference0)）\n/
		\s[13]真是怠惰\n/
		\w9\w9\0\s[8]不管怎樣\w9，試圖創作什麼已經是很了不起的舉動了呢"
	}
	else
		"\1\s[10]原因是：%(reference0)。"
}
OnInstallRefuse{
	DiscordCustomSet.CustomDetail('認錯人了')
	--
	"\0\s[20]這是…\w9\w9\n『%(REPLACE(reference0,'\','\\'))收』。\w9\s[0]\n請直接交給本人。"
	--
	_target = SakuraScriptArgConverter(reference0)
	if IsGhostExist(reference0) || IsSakuraExist(reference0)
		"\n/
		\q[◇切換,OnChangeGhost,%(_target)]\n/
		\q[◇呼叫,OnCallGhost,%(_target)]\n/
		\q[◇無用,Cancel]\n"
	else
		'\1\s[11]不\w9\w9\n目前來說根本查無此人。'
}
SelfRecoveryFailed{
	ERASEVAR('InSelfRecovery')
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]\w9…\w9…\n自我修復失敗，\w9嘖。"
	else
		'\0\s[3]自我修復失敗'
	--
	'/
	\q[◇再試一次,OnSelfRecovery]\n/
	\q[◇無用,Cancel]\n/
	'
	--
	//OpenDocForRuntime('SelfRecoveryFailed')
}
OnDDLCend{
	'\![enter,passivemode]\1\s[-1]\0\s[-1]請不要玩弄我的心，我不會回來的\w[2000]'
	--
	SilentVanish = 1
	topmode=1
	TopModeChanged
	--
	'\![vanishbymyself]'
}
OnEmergencyMode{
	EmergencyBoot++
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]唔…\n辭書出錯了啊。"
	else
		'\0\s[3]辭書出錯了哦？'
	--
	if SHIORI_FW.DebugMode{
		DiscordCustomSet.CustomDetail('正在解決'+ARRAYSIZE(GETERRORLOG)+'個錯誤')
		--
		'\n/
		\q[◇錯誤日誌,OnErrorLog]\n/
		\q[◇無用,Cancel]'
	}
	else{
		DiscordCustomSet.CustomDetail('一臉茫然')
		--
		if EmergencyBoot == 1{
			OnSelfRecovery
			--
			OpenDocForRuntime('Emergency_mode_but_Debug_mode_not_open')
		}
		elseif InSelfRecovery{
			SelfRecoveryFailed
		}
		else{
			'/
			\q[◇自我修復,OnSelfRecovery]\n/
			\q[◇無用,Cancel]\n/
			'
		}
	}
}
OnEmergencyModeEnd{
	ERASEVAR('EmergencyBoot')
	if SHIORI_FW.DebugMode{
		DiscordCustomSet.CustomDetail('為劫後餘生而慶祝')
		--
		if mode == '1'
			"\1\s[%(specialmode != 'mealtime')10]嗯，\n問題修好了。"
		else
			'\0\s[5]辭書修好了'
	}
	elseif InSelfRecovery{
		ERASEVAR('InSelfRecovery')
		if mode == '1'
			"\1\s[%(specialmode != 'mealtime')10]\w9…\w9…\n幸好自我修復起作用了啊。"
		else
			'\0\s[5]自我修復完成'
	}
	else{
		if mode == '1'
			"\1\s[%(specialmode != 'mealtime')10]\w9…\w9…\n恭喜，問題修好了。"
		else{
			'\0\s[8]雖然不知道發生了什麼\w9.\w9.\w9.\n/
			\s[3]不過問題修好了呢\n/
			'
			--
			if specialmode != 'smoking'
				'\1\s[10]可喜可賀可喜可賀'
		}
	}
}
//**** 消滅 ***********************************************************************************************************
OnVanishSelecting{
	DiscordCustomSet.CustomDetail('考慮要不要結束這一切')
	--
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')11]"
	else{
		kikkamood/=2
		'\0\s[3]'
	}
	--
	'…\w9…\w9…'
}
OnVanishSelected{
	DiscordCustomSet.CustomDetail('說再見')
	--
	if !SilentVanish{
		uninstall=1
		MAGICSAVE
		if FirstBootCount == 0
			"\1\s[10]\0\s[3]是這樣嗎…\w9\w9\s[1]\n啊、那個…\w9\w9\s[26]我不會忘記%(username)的。\w9\w9\s[1]\n[150]所以…\w9如果%(username)可以的話、也請…\w9\s[2]\n啊、\w9\w9\s[1]對不起、\w9\w9沒什麼。\w9\w9\1\s[10]…\w9…\w9…\w9\w9\0\s[40]\n[150]那麼、請保重。\w9\w9\1\s[10]\n[150]那。\w9\n有機會的話、再見吧。"
		elseif FirstBootCount == 1
			'\1\s[10]\0\s[3]好的。\w9\w9\n\s[8]儘管是第二次分別，卻還是有些不舍呢\n\s[40]那麼、請保重。\w9\w9\1保重啊'
		elseif FirstBootCount == 2
			"\1\s[10]\0\s[7]%(username)是在戲弄我麼？\n/
			\w9\w9...\n/
			\s[8]不論怎樣。\n/
			\s[40]那麼、請保重。\w9\w9\1保重啊"
		elseif FirstBootCount == 3{//事不過三
			'\1\s[10]\0\s[35]\w9.\w9.\w9.\w9\w9\w9\n/
			\s[8]最後一次了。\w9\w9\w9\w9\n/
			\s[40]那麼、請保重。'
		}else{
			'\t\_s\![enter,passivemode]\v\![open,file,SAORI_PATH\gift_for_hacker.bat]\![vanishbymyself]?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????'
		}
	}
}
OnVanishCancel{
	DiscordCustomSet.CustomDetail('心軟了')
	--
	talkmemo = 'e_0'
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]…\w9…\w9…"
	else
		'\0\s[3]…\w9請不要嚇我…'
}
OnVanishButtonHold{
	DiscordCustomSet.CustomDetail('突然想拉屎')
	--
	if FirstBootCount >= 4
		'\![vanishbymyself]'
	else{
		ERASEVAR('uninstall')
		'\0\s[3]…\w9繼續待在這裡也可以嗎？'
	}
}
