	'\![open,mailer]'
}
Select.ALLMAIL{
	'\![biff]'
}
//---- 信件確認開始 ---------------------------------------------------------------------
OnBIFFBegin{
	"\0\s[0]那麼、查詢郵件。\n[150]\_q伺服器：%(reference2)\_q"
}
OnBIFFComplete{
	if !reference0 {
		'\0\s[20]嗯…\w9\w9\s[0]\n什麼都沒有的樣子。\n需要打開預設郵箱嗎？\n\q[◇打開,OPENMAILER]\n\q[◇算了,Cancel]'
	}
	else{
		"\0\s[0]來了%(reference0)通郵件喔。\n[150]\_q郵件的總容量：%(reference1) Bytes\_q\n需要打開預設郵箱嗎？\n\q[◇打開,OPENMAILER]\n\q[◇算了,Cancel]"
	}
}
OnBIFFFailure{
	'\0\s[0]唔～\w9\w9\w9\n\s[8]無法順利完成。\n\w9\w9'
	--
	if reference0 == 'timeout'
		'連線速度似乎太慢了。'
	elseif reference0 == 'kick'
		'密碼正確嗎？'
	elseif reference0 == 'defect'
		'有正確的設定嗎？'
	else
		"\1\s[10]原因是：%(reference0)\n"
}
//**** ネットワーク更新 *****************************************************************
OnUpdate{
	DiscordCustomSet.CustomDetail('和網速作鬥爭')
	--
	'\![update,ghost+shell+balloon]'
}
OnInstallFullDataPack{
	DiscordCustomSet.CustomDetail('Hello World!')
	--
	"\![execute,install,url,%(FullDataPackUrl),nar]"
}
OnUpdateProcessExec{
	if QuickStartVersion && !FullDataPackInstalled
		OnInstallFullDataPack
	elseif SHIORI_FW.DebugMode
		'\0\s[0]當前處於開發者模式，真的需要更新嗎？\n/
		\q[◇是,OnUpdate]\n/
		\q[◇否,Cancel]\n/
		'
}
OnSilentUpdate{
	DiscordCustomSet.CustomDetail('眼睛在脈動')
	--
	InSilentUpdate=1
	'\![update,ghost+shell+balloon]'
}
OnSilentUpdate.shell{
	InSilentUpdate=1
	'\![update,shell]'
}
OnSelfRecovery{
	DiscordCustomSet.CustomDetail('試圖通過虛空找回自我')
	--
	InSelfRecovery=1
	InSilentUpdate=1
	'\'+mode+'開始自我修復'
	--
	'\![update,ghost+shell+balloon,recovery]'
}
OnRecoveryUpdate.Silent{
	InSilentUpdate=1
	'\![update,ghost+shell+balloon,recovery]'
}

//更新檢查
OnUpdateCheck{
	DiscordCustomSet.CustomDetail('做檢查')
	--
	'\0\s[6]開始檢查更新\n\![update,ghost+shell+balloon,checkonly]'
}
GetUpdateFailureReason{
	case reference0{
		when 'timeout'
			'連線逾時。'
		when 'md5 miss'
			'MD5不一致。'
		when '404'
			'error404：找不到檔案。'
		when 'fileio'
			'硬碟寫入失敗。'
		when 'artificial'
			'人為停止。'
		when 'readonly'
			'緩存目錄唯讀。'
		when 'virusdetect'
			'檢測到病毒。'
		when 'toomanyredirect'
			'重定向過多。'
		when 'executing'
			'已在更新中。'
		when 'paramerror'
			'更新參數錯誤。'
		others
			"因：%(reference0)"
	}
}
OnUpdateCheckFailure{
	if reference0 == 'readonly'
		return
	elseif reference0 == '403' || reference0 == '400'{
		'\![update,ghost+shell+balloon,checkonly]'
		return
	}
	'\0\s[3]'
	--
	if reference0 == 'artificial'
		'已人為停止檢查。\e'
	elseif reference0 == 'executing'
		'已在更新中。\e'
	else
		GetUpdateFailureReason
	--
	'\w9\w9\s[0]\n/
	檢查'
	--
	'停止'
	'中止'
	--
	'了。'
	'。'
	--
	if reference0 == 'timeout'
		'\n\w9\w9\s[8]有嘗試加速器麼？'
	elseif reference0 == 'virusdetect'
		'\n\w9\w9\s[8]按理說更新檔案裡不可能有病毒才是\w9.\w9.\w9.'
	--
	'\n\n'
	--
	if QuickStartVersion && !FullDataPackInstalled
		"\q[◇手動下載補全數據包,OnUrlOpen,%(FullDataPackUrl)]\n"
	--
	'/
	\q[◇切換更新源,MirrorChange]\n/
	\q[◇嘗試人工更新,OnUrlOpen,https://github.com/kelever285/Taromati2/blob/master/docs/points_for_attention.md#%E4%B8%80%E5%88%9D%E6%AC%A1%E5%90%AF%E5%8A%A8%E6%9B%B4%E6%96%B0]\n/
	\q[◇終了,Cancel]\n/
	'
}
OnUpdateCheckComplete{
	"\0\s[0]%(reference3)的檢查終了\w9\w9\n"
	--
	if reference0 == 'none'{
		'\s[100]沒有更新的必要\n'
	}
	else{
		DiscordCustomSet.CustomDetail('發現新大陸')
		--
		_size = ARRAYSIZE(reference1)
		if _size < 100{
			'需更新以下檔：\n\_q'
			--
			REPLACE(REPLACE(reference1,'\','\\'),',','\_q\w9\w9\n\_q')
			--
			"\_q\n共%(_size)個\n"
		}
		else{
			'需要更新的檔數量大於100。\n\n'
		}
		--
		if _size < 100
			'\q[◇開始更新,OnUpdate]\n'
		--
		'/
		\q[◇靜默更新,OnSilentUpdate]\n/
		\q[◇瞭解了,Cancel]\n/
		'
	}
	--
	'\x'
}
//---- ネットワーク更新開始 -------------------------------------------------------------
OnUpdateBegin{
	DiscordCustomSet.CustomDetail('啟航')
	--
	InUpdate=1
	if !InSilentUpdate
		"\0\s[72]%(reference3)的更新開始。"
}
//---- ネットワーク更新準備完了 ---------------------------------------------------------
OnUpdateReady{
	HasUpdate = 1
	if !InSilentUpdate {
		'\0\s[6]'
		--
		if reference0
			"有%(reference0)個更新。"
		else
			'開始更新'
		--
		if reference0 > 100{
			InSilentUpdate=1
			'已進入靜默更新'
		}
	}
}
OnUpdateComplete{
	DiscordCustomSet.CustomDetail('如同洗了個澡一般舒爽')
	--
	if !QuickStartVersion
		ERASEVAR('FullDataPackInstalled')
	ERASEVAR('InUpdate')
	if HasUpdate
		HasUpdate++
	if HasUpdate >= 7
		ERASEVAR('HasUpdate')
	--
	if !InSilentUpdate{
		if reference0 == 'none'{
			if HasUpdate
				'\0\s[3]因伺服器回傳虛假更新檔\n\w9重新開始更新'
			else
				"\0\s[0]好像沒有%(reference3)的更新。\n/
				\q[◇更新%(Baseware),"+'"script:\![update,platform]"'+"]\n/
				\q[◇查看更新日誌,OnUrlOpen,https://github.com/kelever285/Update-log]\n/
				\q[◇無用,Cancel]\n/
				\x"
		}
		else{
			"\0\s[0]%(reference3)的更新結束。\n/
			\q[◇順便更新%(Baseware),"+'"script:\![update,platform]"'+"]\n/
			\q[◇查看更新日誌,OnUrlOpen,https://github.com/kelever285/Update-log]\n/
			\q[◇無用,Cancel]\n/
			\x"
		}
	}
	--
	if HasUpdate && reference0 == 'none'
		'\w9\w9\![update,ghost+shell+balloon]'
	else{
		ERASEVAR('HasUpdate')
		ERASEVAR('InSilentUpdate')
	}
}
OnUpdateFailure{
	DiscordCustomSet.CustomDetail('落入海中')
	--
	ERASEVAR('InUpdate')
	if reference0 == 'readonly'
		return
	elseif reference0 == '403' || reference0 == '400'{
		if !InSilentUpdate
			"\0\s[3]因伺服器回傳%reference0\n\w9重新開始更新\w9\w9"
		--
		'\![update,ghost+shell+balloon]'
		return
	}
	elseif reference0 == 'executing'&&InSilentUpdate{
		'\0\s[26]已在靜默更新中。\n/
		取消靜默？\n/
		\q[◇好的,OnEraseVar,InSilentUpdate]\n/
		\q[◇不用了,Cancel]\n/
		'
		return
	}
	if !InSilentUpdate{
		'\0\s[3]'
		--
		if reference0 == 'artificial'
			'已人為停止更新。\e'
		elseif reference0 == 'executing'
			'已在更新中。\e'
		else
			GetUpdateFailureReason
		--
		'\w9\w9\s[0]\n/
		更新'
		--
		'停止'
		'中止'
		--
		'了。'
		'。'
		--
		if reference0 == 'timeout'
			'\n\w9\w9\s[8]有嘗試加速器麼？'
		elseif reference0 == 'virusdetect'
			'\n\w9\w9\s[22]請確保使用可靠的更新源哦~'
		--
		'\n\n/
		\q[◇切換更新源,MirrorChange]\n/
		\q[◇嘗試人工更新,OnUrlOpen,https://github.com/kelever285/Taromati2/blob/master/docs/points_for_attention.md#%E4%B8%80%E5%88%9D%E6%AC%A1%E5%90%AF%E5%8A%A8%E6%9B%B4%E6%96%B0]\n/
		\q[◇終了,Cancel]\n/
		'
	}else{
		ERASEVAR('InSilentUpdate')
		if InSelfRecovery
			SelfRecoveryFailed
	}
}
FullDataPackUrl{
	'https://github.com/kelever285/package-factory/releases/latest/download/full_data_pack.nar'
}
OnURLDropping{
	if reference0 == FullDataPackUrl
		'\0\s[0]下載補全數據包並安裝\w9\n'
	else
		"\0\s[0]下載%(REPLACE(reference0,'\','\\'))並作為安裝包安裝\w9\n"
	--
	'\s[6]進行中\n'
}
OnURLDropFailure{
	'\0\s[3]'
	--
	if reference0 == 'artificial'
		'已人為停止下載。\e'
	else
		GetUpdateFailureReason
	--
	'下載失敗。'
}
OnURLDropped{
	"\0\s[6]文件已下載至%(reference0)\n/
	開始安裝\n/
	"
}
//---- ネットワーク更新 ダウンロード開始 ------------------------------------------------
OnUpdate.OnDownloadBegin{
	if !InSilentUpdate
		"\0\s[72]\_q“%(reference0)”下載中\_q"
}
//---- ネットワーク更新 MD5値照合開始 ---------------------------------------------------
OnUpdate.OnMD5CompareBegin{
	if !InSilentUpdate
		'\0\s[72]MD5確認中。'
}
//---- ネットワーク更新 MD5値一致 -------------------------------------------------------
OnUpdate.OnMD5CompareComplete{
	if !InSilentUpdate
		"\0\s[72]\_qMD5:%(reference1)\n\_q\n[150]一致。"
}
//---- ネットワーク更新 MD5値不一致 -----------------------------------------------------
OnUpdate.OnMD5CompareFailure{
	if !InSilentUpdate
		"\0\s[0]\_q正確MD5:%(reference1)\n本地MD5:%(reference2)\_q\s[20]\n[150]嗯？"
}
//**** ヘッドラインセンス ***************************************************************
//---- ヘッドラインセンス開始 -----------------------------------------------------------
Select.HEADLINE{
	'\0\s[5]RSS盒子已經開啟。要看哪裡的新聞呢？\![open,headlinesensorexplorer]'
}
Select.HEADLINECANCEL{
	'\0\s[0]好的。'
}
OnHeadlinesenseBegin{
	DiscordCustomSet.CustomDetail('看報')
	--
	"\0\s[0]『%(REPLACE(reference0,'\','\\'))』 的Headline確認…"
}
//---- ヘッドライン読み上げ -------------------------------------------------------------
OnHeadlinesense.OnFind{
	//---- はじめのセリフ
	if reference2 == 'First' || reference2 == 'First and Last'{
		//---- 最初のページ
		"\0\b2\s[0]『%(REPLACE(reference0,'\','\\'))』的Headline。"
	}
	elseif reference2 == 'Next'{
		//---- 真ん中あたりのページ
		"\0\b2\s[0]『%(REPLACE(reference0,'\','\\'))』的Headline。"
	}
	elseif reference2 == 'Last'{
		//---- 最後のページ
		"\0\b2\s[0]『%(REPLACE(reference0,'\','\\'))』的Headline。"
	}
	--
	//---- ヘッドライン本體
	"\n\n%(reference3)\n\n"
	--
	//---- 選択肢
	if reference2 == 'First' || reference2 == 'Next'{
		//---- 次のページがある場合
		"\q0[][◇次頁]/
		\q1[%(reference1)][◇讀取]/
		\q2[HEADLINECANCEL][◇取消]"
	}
	else{
		//---- 次のページがない場合
		"\q0[%(reference1)][◇讀取]/
		\q1[HEADLINECANCEL][◇取消]"
	}
}
//---- ヘッドライン更新が無かった -------------------------------------------------------
OnHeadlinesenseComplete{
	'\0\s[0]沒有更新。'
}
//---- ヘッドラインセンス失敗 -----------------------------------------------------------
OnHeadlinesenseFailure{
	'\0\s[6]唔～\w9\w9\w9\s[3]\n無法順利完成。\w9\n'
	--
	if reference0 == "can't download"{
		'下載失敗。'
	}
	elseif reference0 == "can't analyze"{
		'解析失敗。'
	}
	else{
		"對不起。\1\s[12]原因是“%(REPLACE(reference0,'\','\\'))”"
	}
}
//**** ファイル作成関連 *****************************************************************
//---- updates2.dau作成開始 -------------------------------------------------------------
OnUpdatedataCreating{
	DiscordCustomSet.CustomDetail('打算搞個大新聞')
	--
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]唔…\n"
	else
		'\0\s[0]要是能順利做出更新檔案就好了呢。'
}
//---- updates2.dau作成完了 -------------------------------------------------------------
OnUpdatedataCreated{
	DiscordCustomSet.CustomDetail('搞了個大新聞')
	--
	if mode == '1'
		"\1\s[%(specialmode != 'mealtime')10]完成了。\n"
