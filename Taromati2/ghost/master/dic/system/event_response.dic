OnEmbryoExist{
	'\0\s[0]以前的「偽春菜」起動了呢。'
}
//---- 起動時に貓どりふを検出 -----------------------------------------------------------
OnNekodorifExist{
	'\0\s[0]うわ、貓どりふが‥‥\w9\1\s[10]‥\w5‥\5！！'
}
//---- スクリーンセーバー実行開始 -------------------------------------------------------
OnScreenSaverStart{
	'\0\s[0]螢幕保護程式開始工作了'
}
//---- スクリーンセーバー実行終了 -------------------------------------------------------
OnScreenSaverEnd{
	'\![set,balloontimeout,180000]'
	--
	"\0\s[0]%(username)\w9\w9、歡迎回來。\n\x"
}
//待機
OnSysSuspendAsTime{
	InSystemSuspend = 1
	if !TimeErrorCheck
		CloseTime = _argv[0]
}
OnSysSuspend{
	OnSysSuspendAsTime(GETSECCOUNT)
}
//待機中恢復
OnSysResume.base{
	DiscordCustomSet.LargeImageKey('kikka_eye_open')
	--
	DiscordCustomSet.CustomDetail('從待機中恢復')
	--
	'\![set,balloontimeout,180000]'
	--
	case reference0{
		when 'critical'
			'\0\s[8]接上電了嗎？'
		others
			'\0\s[6]已從待機中恢復'
	}
	--
	'\w9\w9\w9\s[0]\n\x'
	--
	"\0\s[0]%(username)\w9\w9、歡迎回來。\n\x"
}
OnSysResume{
	ERASEVAR('InSystemSuspend')
	BaseGhostStart.aboutTime
	if !InMinimize{
		SHIORI_FW.PushNoBreakNotifyResult(OnSysResume.base)
		SHIORI_FW.PushNoBreakNotifyResult(OnAutoChangeShell.boot)
		SHIORI_FW.PushNoBreakNotifyResult(OnBoot.aboutTime)
		SHIORI_FW.PushNoBreakNotifyResult(OnWeatherUpdate.boot)
	}
}
