OnFileDrop{
	_file = reference0[0]
	_fileext = TOLOWER(SPLITPATH(_file)[3])
	_filename = SPLITPATH(_file)[2] + _fileext
	if eatfile==1{
		OnFileEatDrop(reference0)
	}elseif rename==1
		OnFileRenameDrop(reference0)
	elseif shortcut==1
		OnShortcutFileDrop
	elseif SHIORI_FW.DebugMode &&(_filename == 'aya.dll' || _filename == 'yaya.dll'){
		if mode=='0'
			'\0\s[0]'
		else
			'\1'
		--
		'更新aya？\n/
		\q[◇確定,OnUpdateSHIORICore,'+SakuraScriptArgConverter(reference0)+']\n/
		\q[◇無用,Cancel]'
	}
	elseif SHIORI_FW.DebugMode && _filename == 'tama.exe'{
		if mode=='0'
			'\0\s[0]'
		else
			'\1'
		--
		'更新tama？\n/
		\q[◇確定,OnUpdateTama,'+SakuraScriptArgConverter(reference0)+']\n/
		\q[◇無用,Cancel]'
	}	
	elseif ISDIR(_file){//若是資料夾
		if mode=='0'
			'\0\s[0]要'
		else{
			'\1'
		}
		--
		'怎麼做？\n'
		--
		if IsMusicDir(_file)
			"\q[◇作為音樂目錄添加,OnMusicFileDrop,%(SakuraScriptArgConverter(reference0))]\n"
		--
		"\q[◇創建快捷方式,OnShortcutFileDrop,%(SakuraScriptArgConverter(reference0))]\n/
		\q[◇直接吃掉,OnFileEatDrop,%(SakuraScriptArgConverter(reference0))]\n/
		\q[◇無用,Cancel]"
	}
	else{
		case _fileext {
			when '.m3u', '.m3u8', '.mid', '.wav', '.mp3', '.au', '.m4a', '.ogg', '.wma','.ape','.flac','.avi','.wmv','.rm','.rmvb','.mp4','.mkv','.flv','.mpg'{
				OnMusicFileDrop(reference0)
			}
			when '.exe','.lnk'{
				OnShortcutFileDrop
			}
			when '.png', '.jpg', '.jpeg', '.bmp'{
				Wallpaperfile = reference0
				"\1\s[11]\0\b[2]\s[2]影像檔\n\_q「%(_filename)」\n[150]\_q要把這個設定為壁紙嗎？\n[150]/
				\![*]\q[居中,OnSetWallpaper,0]\n/
				\![*]\q[並列,OnSetWallpaper,1]\n/
				\![*]\q[放大,OnSetWallpaper,2]\n[150]/
				\q[◇直接吃掉,OnFileEatDrop,%(SakuraScriptArgConverter(reference0))]\n/
				\q[◇取消,Cancel]"
			}
			when '.txt'{
				if SHIORI_FW.DebugMode{
					temp = reference0
					if mode=='0'
						'\0\s[0]要怎麼做？'
					else
						'\1怎麼做？'
					--
					"\n/
					\q[◇作為辭書打開,OnDicDrop]\n/
					\q[◇作為小說閱讀,OnOpenBook]\n/
					\q[◇直接吃掉,OnFileEatDrop,%(SakuraScriptArgConverter(reference0))]\n/
					"
				}
				else
					OnOpenBook(reference0)
			}
			when '.rncfg'{
				DialogFilesRenameOpenCon(reference0)
			}
			when '.sccfg'{
				LoadShortCutCfg(reference0)
				OnShortcutMenu
			}
			when '.scdat'{
				OnShortCutMenuAdd(reference0)
			}
			when '.dic','.ayc','.sat','.__1','.kis','.kiw'{
				OnDicDrop
			}
			others{
				"「%(_filename)」\n未知的檔案類型……"
				"\1\s[11]未知文件\n\_q「%(_filename)」\_q\0\s[3]…這是什麼？"
				--
				"\n\q[◇直接吃掉,OnFileEatDrop,%(SakuraScriptArgConverter(reference0))]"
			}
		}
	}
}
IsMusicFlie{
	if ISDIR(_argv[0]){
		0
		return
	}
	_file = _argv[0]
	_fileext = TOLOWER(SPLITPATH(_file)[3])
	case _fileext {
		when '.m3u', '.m3u8', '.mid', '.wav', '.mp3', '.au', '.m4a', '.ogg', '.wma','.ape','.flac','.avi','.wmv','.rm','.rmvb','.mp4','.mkv','.flv','.mpg'
			1
		others
			0
	}
}
IsMusicDir{//判斷是否是音樂目錄，不進行遞迴因為正常的音樂目錄都是一層下就有音樂檔
	_dir = _argv[0]
	_files = FENUM(_dir)
	foreach _files;_file{
		if IsMusicFlie(_file){
			1
			return
		}
	}
	0
}
GetSHIORInameFromDicExt{
	case _argv[0]{
		when '.dic','.ayc','.aym'
			'文'//aya
		when '.sat'
			'裡々'//satoriya
		when '.__1'
			'美阪'//misaka
		when '.kis','.kiw'
			'華和梨'//kawari
		when '.txt'
			'裡々/美阪'
	}
}
GetDicEncodedFromDicExt{
	case _argv[0]{
		when '.ayc','.sat','.__1','.kiw'
			1
		when '.dic','.kis','.txt','.aym'
			0
	}
}
OnDicDrop{
	if !reference0
		reference0 = temp
	_file = reference0[0]
	_fileext = TOLOWER(SPLITPATH(_file)[3])
	if SHIORI_FW.DebugMode{
		temp = reference0
		if mode=='0'
			'\0\s[0]'
		else
			'\1'
		"辭書所對應shiori：%(GetSHIORInameFromDicExt(_fileext))\n"
		--
		if mode=='0'
			'要怎麼做？'
		else
			'怎麼做？\b[2]'
		--
		'\n'
		--
		if GetDicEncodedFromDicExt(_fileext) && kikkawiz>=500{
			case GetSHIORInameFromDicExt(_fileext){
				when '文'
					'\q[◇解密為dic,ayccoder.file_drop,Decode,aya]\n'
				when '裡々'
					'\q[◇解密為txt,ayccoder.file_drop,Decode,satoriya]\n'
				when '美阪'
					'\q[◇解密為txt,ayccoder.file_drop,Decode,misaka]\n'
				when '華和梨'
					'\q[◇解密為kis,ayccoder.file_drop,Decode,kawari]\n'
			}
		}
		else{
			case GetSHIORInameFromDicExt(_fileext){
				when '文'
					'\q[◇dicforma格式化,dicforma.file_drop.run]\n/
					\q[◇dicforma格式化（激進）,dicforma.file_drop.run,radical]\n/
					\q[◇加密為ayc,ayccoder.file_drop,Encode,aya]\n'
				when '裡々/美阪'
					'\q[◇加密為sat（裡々）,ayccoder.file_drop,Encode,satoriya]\n/
					\q[◇加密為__1（美阪）,ayccoder.file_drop,Encode,misaka]\n'
				when '華和梨'
					'\q[◇加密為kiw,ayccoder.file_drop,Encode,kawari]\n/
					\q[◇當作kiw解密,ayccoder.file_drop,Decode,kawari]\n'
			}
		}
		--
		'\q[◇打開master目錄,OnOpenMasterMenu]\n/
		\q[◇無用,Cancel]\n/
		'
	}
	else{
		if mode=='0'
			'\0\s[0]'
		else
			'\1'
		--
		'這是'
		--
		_name=GetSHIORInameFromDicExt(_fileext)
		if _name != '文'
			_name+'shiori的'
		--
		'辭書檔，用於提供ghost機能\n'
		--
		'要怎麼做？\n/
		\q[◇連絡人格維護者，請求追加機能,OnUrlOpen,https://github.com/kelever285/Taromati2/issues/new?assignees=steve02081504&labels=enhancement&template=feature-request.yaml&title=a+feature+request]\n/
		\q[◇教練，我想學偽春菜,OnUrlOpen,https://github.com/kelever285/Taromati2/blob/master/docs/entry_guidance.md]\n/
		\q[◇我是老手，打開master目錄，我自己動,OnOpenMasterMenu]\n/
		'
	}
}
