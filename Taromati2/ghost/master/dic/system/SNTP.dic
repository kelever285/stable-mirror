OnSNTPmenu{
	if SNTPserver
		"\1\b[2]\s[10]\n現在的校準伺服器是\n\_q%(REPLACE(SNTPserver,'\','\\'))\_q\n要更換伺服器嗎？\n\n/
		\![*]\q[更改伺服器,OnSNTPServerChange]\n/
		\![*]\q[校準開始,OnSNTPexecute]\n"
	else
		OnSNTPServerChange
}
OnSNTPServerChange{
	'\1\s[11]請輸入'
	--
	if SNTPserver
		'新的'
	--
	'同步伺服器地址。\![open,inputbox,OnSNTPServerChange.input,-1,pool.ntp.org]'
}
OnSNTPServerChange.input{
	if !reference0
		'\0\s[8]請輸入伺服器位址呢？\![open,inputbox,OnSNTPServerChange.input,-1,pool.ntp.org]'
	else{
		SNTPserver=reference0
		OnSNTPexecute
	}
}
OnSNTPexecute{
	"\![executesntp,%(SNTPserver)]"
}
OnCheckTimeCorrect{
	CheckTimeCorrect=1
	OnSNTPexecute
}
OnSNTPBegin{
	if CheckTimeCorrect{
		DiscordCustomSet.CustomDetail('檢查沙漏')
		return
	}
	DiscordCustomSet.CustomDetail('調製人生')
	--
	"\0\s[5]連線到\_q%(REPLACE(reference0,'\','\\'))\_q伺服器了哦，時間同步開始。"
}
OnSNTPCompare{
	if CheckTimeCorrect{
		ERASEVAR('CheckTimeCorrect')
		if reference3
			OnTimeError
		else
			DiscordCustomSet.CustomDetail('錯看了一眼')
		ERASEVAR('InTimeError')
		return
	}
	'\0\s[6]'
	--
	if reference3 == 0{
		DiscordCustomSet.CustomDetail('精確、精細、精緻')
		--
		_nowtime = SPLIT(reference1,',')
		"沒有誤差。\n現在時刻：%(_nowtime[0])年%(_nowtime[1])月%(_nowtime[2])日 %(_nowtime[3]):%(_nowtime[4])\n"
		--
		if InTimeError{
			ERASEVAR('InTimeError')
			OnTimeErrorFixed
		}
	}
	else{
		_abs=ABS(reference3)
		if _abs<60{
			DiscordCustomSet.CustomDetail('有點偏差')
			--
			"誤差%(reference3)秒。"
		}
		elseif _abs<60*60{
			DiscordCustomSet.CustomDetail('有點偏差')
			--
			"誤差%(reference3/60)分鐘。"
		}
		elseif _abs<60*60*24{
			DiscordCustomSet.CustomDetail('不上班不上課')
			--
			"誤差%(reference3/(60*60))小時。"
		}
		elseif _abs<60*60*24*30{
			DiscordCustomSet.CustomDetail('從不過節')
			--
			"誤差%(reference3/(60*60*24))天。"
		}
		elseif _abs<60*60*24*365{
			DiscordCustomSet.CustomDetail('錯過一個季節')
			--
			"誤差%(reference3/(60*60*24*30))個月。"
		}
		else{
			DiscordCustomSet.CustomDetail('超時空救兵')
			--
			"誤差%(reference3/(60*60*24*365))年。\n/
			\1\s[10].\w9.\w9.\w9.\n/
			\s[13]就你媽離譜。\w9\0\s[8]\w9/
			"
		}
		--
		'\n/
		\q[◇校準,"script:\6"]\n/
		\q[◇無用,Cancel]\n/
		'
	}
}
OnSNTPCorrect{
	_abs=ABS(reference3)
	if _abs<60*60
		DiscordCustomSet.CustomDetail('做了些小調整')
	elseif _abs<60*60*24
		DiscordCustomSet.CustomDetail('洗心革面')
	elseif _abs<60*60*24*30
		DiscordCustomSet.CustomDetail('打算過節')
	elseif _abs<60*60*24*365
		DiscordCustomSet.CustomDetail('從冬眠中蘇醒')
	else
		DiscordCustomSet.CustomDetail('穿越成功')
	--
	_nowtime = SPLIT(reference1,',')
	"\0\s[5]同步完成了，很順利呢。\n現在時刻：%(_nowtime[0])年%(_nowtime[1])月%(_nowtime[2])日%(_nowtime[3])：%(_nowtime[4])\n"
	--
	if InTimeError{
		ERASEVAR('InTimeError')
		OnTimeErrorFixed
	}
}
OnSNTPFailure{
	DiscordCustomSet.CustomDetail('被時間拋棄')
	--
	if CheckTimeCorrect{
		ERASEVAR('CheckTimeCorrect')
		OnTimeError
		return
	}
	'\0\s[3]……失敗了？？嗚……\n/
	\q[◇重試,OnSNTPexecute]\n/
	\q[◇無用,Cancel]\n/
	'
}

//
TimeErrorCheck{
	if GETSECCOUNT{
		if year < LAST_BUILD_TIME.YEAR || (GETSECCOUNT - CloseTime) < 0
			1
		elseif year == LAST_BUILD_TIME.YEAR && month < LAST_BUILD_TIME.MONTH
			1
		else
			0
	}
	else
		1
}
OnTimeError{
	'\0\s[20]時間出錯了哦？\n/
	\q[◇校準,"script:\6"]\n/
	\q[◇無用,Cancel]\n/
	'
}
OnTimeErrorFixed{
	'\0\s[0]那麼，再一次：\x'
	--
	if !firstboottime
		firstboottime = "%(year),%(month),%(day),%(hour),%(minute)"
	--
	BaseGhostStart.aboutTime
	--
	OnBoot.aboutTime
	--
	if AutoUpdate
		OnSilentUpdate
}
