//**** 終了 ***********************************************************************************************************
ClearTempVar:void{
	_L= GETFUNCLIST
	_t= REQ.COMMAND
	foreach _L;_V{
		if RE_GREP(_V,'^Clear\S*Var$')&& _V != 'ClearTempVar'
			void EVAL(_V)
	}
	REQ.COMMAND = _t
	S_CHARSET = GETSETTING('charset.output')
}
OnClose.base:void{
	if reference0 == 'system'
		inshutdown=1
	if !TimeErrorCheck
		CloseTime = GETSECCOUNT
	--
	ClearTempVar
	--
	OnSQLSave
	OnAISave
	--
	MAGICSAVE
	--
	if autobackup
		OnAutoBackup
	--
	MAGICLOCK
}
OnClose{
	OnClose.base
	--
	OnClose.talk
	--
	'\-'
}
OnClose.talk{
	if mode == '1'{
		OnClose1
	}
	else{
		OnClose0
	}
}
OnClose0{
	_timeslot = GetTimeSlot
	'\1\s[10]\0\s[3]是這樣嗎…\w9\w9\s[0]\n如果有什麼事、\w9請再叫我喔。\1\s[10]再見啦。'
	'\1\s[10]\0\s[0]好的。\w9\w9\n那麼再見了。\1\s[10]再見啦。'
	{
		'\1\s[10]\0\s[0]要出門了嗎？\w9\w9\s[26]\n請把'
		--
		'彈夾確實的撿起來喔。'
		'請把指紋仔細的擦掉喔。'
		--
		'\w9\w9\1\s[10]要幹嘛啊…'
	}
	if !InTimeError{
		case _timeslot{
			when 'Earlymorning'{
			}
			when 'Morning'{
			}
			when 'Day'{
			}
			when 'Evening'{
				'\1\s[10]\0\s[0]因為是被稱為逢魔之刻的時間、\w9\n如果要出門的話請小心喔。\w9\w9\n那麼再見了。\1\s[10]再見啦。'
				'\1\s[117]早點回來，\w9人家等著呢。\w9\w9\0\s[26]這麼晚了，路上小心啊'
			}
			when 'Night'{
			}
			when 'Midnight'{
				"\1\s[10]\0\s[0]啊…\w9\w9已經這麼晚了。\w9\w9\n那麼%(username)、\w9\w9祝您有個好夢。"
			}
		}
	}
	--
	'\w9\w9'
}
//**** フェーズ *******************************************************************************************************
GetPhase{
	if intimacy >= 3600 && elapsedtime >= 691200{//徹底信任
		5
	}
	elseif intimacy >= 800 && elapsedtime >= 345600{//可h
		4
	}
	elseif intimacy >= 200 && elapsedtime >= 172800{//好感
		3
	}
	elseif intimacy >= 50 && elapsedtime >= 86400{//些微好感
		2
	}
	elseif intimacy >= -10{//普通
		1
	}
	elseif intimacy >= -100{//厭惡
		0
	}
	else{
		-1
	}
}
//**** 最小化 *********************************************************************************************************
OnWindowStateMinimize{
	DiscordCustomSet.LargeImageKey('kikka_eye_close')
	--
	DiscordCustomSet.CustomDetail('最小化中')
	--
	if playingmusic
		DiscordCustomSet.CustomState('但是放著歌')
	--
	minimizestarttime = systemuptime
	InMinimize = 1
	if mode != '1'{
		'\0\s[3]……'
		'\0\s[6]……知道了。'
		if nurturance.Dependency > 50
			'\0\s[9]請不要把我忘了哦？'
	}
	'\1又要被隱藏了麼？'
}
//**** 最小化から複帰 *************************************************************************************************
OnWindowStateRestore{
	'\t'
	--
	DiscordCustomSet.LargeImageKey('kikka_eye_open')
	--
	DiscordCustomSet.CustomDetail('從最小化中回來')
	--
	OnSurfaceRestore.base
	--
	ClassMonitor
	--
	if topmode/2
		topmode-=2
	TopModeChanged
	--
	if mode == '1'{
		OnWindowStateRestore1
	}
	else{
		if MinimizeTime >= 60*60*24{
			DiscordCustomSet.CustomDetail('讓人等了'+TOINT(MinimizeTime/(60*60*24))+'天的屑')
			--
			"\0\s[9]\w9.\w9.\w9.\w9\w9\w9我可是等了你整整%(TOINT(MinimizeTime/(60*60*24)))天哦？"
		}
		if MinimizeTime >= 60*60*5{
			DiscordCustomSet.CustomDetail('讓人等了'+TOINT(MinimizeTime/(60*60))+'小時的屑')
			--
			'\0\s[9]\w9.\w9.\w9.\w9\w9\w9\s[6]\n把我忘掉了吧?\w9\w9\w9\w9\n\s[35]絕對\w9.\w9.\w9.'
			"\0\s[9]\w9.\w9.\w9.\w9\w9\w9我可是等了你整整%(TOINT(MinimizeTime/(60*60)))小時哦？"
		}
		elseif MinimizeTime >= 60*60*2{
			'\0\s[7]\w9.\w9.\w9.\w9\w9\w9\s[0]\n我還以為被忘掉了呢…'
		}
		elseif MinimizeTime >= 60{
			'\0\s[6]幸好。\w9\w9\w9\s[0]\n我還以為被忘掉了呢…'
		}
		else{
			'\0…嗯。\w9\w9\w9\n有需要我的地方嗎？'
			if specialmode != 'smoking'
				'\1\s[10]呼。\w9\w9\n在做些什麼啊？'
		}
	}
	--
	"\_w[%(MAX(MIN(MinimizeTime/60*1000,9000),500))]"
	--
	ERASEVAR('minimizestarttime')
	ERASEVAR('InMinimize')
}
MinimizeTime{
	TOINT(systemuptime) - TOINT(minimizestarttime)
}
//**** ゴースト/シェル切り替え **********************************************************
//**** 他のゴーストに交代 *********************************************************************************************
OnGhostChanging{
	if mode == '1'{
		OnGhostChanging1
	}
	else{
		OnGhostChanging0
	}
}
OnGhostChanging0{
	if reference1 == 'manual'{
		//---- Taromati -------------------------------------------------------------------------------------------------------
		if reference0 == '橘花'{
			if reference3 && !GHOST.IsSelfPath(reference3){
				'\0\s[8]...那是誰啊？'
			}
			else{
				'\0\s[0]那麼、\w9\w9請稍微等一會喔。'
				'\0\s[0]那麼、\w9\w9我稍微離開一下喔。'
			}
		}
		//---- #　由加＋ダオにゅう　# -----------------------------------------------------------------------------------------
		elseif reference0 == '由加'{
			'\0\s[5]很有學習價值呢，\w9毒物方面。\w9\w9\1\s[10]學點其他的吧。'
		}
		//---- 10円 -----------------------------------------------------------------------------------------------------------
		elseif reference0 == '(・∀・)'{
			'\0\s[40]存錢的事，\w9還請加油。'
		}
		//---- Neo'n SIGN -----------------------------------------------------------------------------------------------------
		elseif reference0 == '誰か'{
			'\1\s[10]\0\s[0]サインさんは死んでいるんでいるんですよね。\w9\w0\1\s[10]そうらしいな。\0\s[0]\w9\w9\n[150]では…\w9『ねーやん』さんですか？\w9\w9\1\s[10]\n[150]コサインかもしれないぞ。\w9\w9\0\s[0]\n[150]…\w9先生、お願いします。\w9\w9\1\s[10]\n[150]…\w9…\w9…'
		}
		//---- NodePsimoon ----------------------------------------------------------------------------------------------------
		elseif reference0 == 'さい子'{
			'\1\s[10]\0\s[0]私が居なくなっても、\w9\n誰にも彼に手を出すことは出來ない。\w9\w9\n彼とその人生は、\w9全て私のものなのだ。\w9\w9\1日本語が、とても若干おかしいぞ。'
		}
		//---- THE TOXIC WALTZ ------------------------------------------------------------------------------------------------
		elseif reference0 == '毒子'{
			'\0\s[20]準備に時間がかかるでしょうから、\w9\w9\s[40]\nもう少し此処にいても良いですか？\w9\1\s[10]駄目に決まってるだろ。\w9\w9\w9\0\s[3]\n[150]そうですよね。\w9\w9\nごめんなさい。\w9\nそれではまた。\w9\1\s[10]じゃな。'
		}
		//---- たまちんゆうらゆら ---------------------------------------------------------------------------------------------
		elseif reference0 == '玉響'{
			'\0\s[5]イタリアは良い國ですね。\w9\w9\s[6]\n[150]『神は世界一美しい風景、世界一美味しい食べ物、\n　世界一過ごしやすい気候をイタリアに與えた。\w9\w9\s[0]\n[150]　神様、\w9これではあまりに恵まれすぎています。\w9\w9\s[26]\n[150]　心配するな。\w9\n　イタリア人を入れておいた』\w9\w9\1\s[11]…\w9おい。'
		}
		//---- まゆら＆黒うにゅう ---------------------------------------------------------------------------------------------
		elseif reference0 == 'まゆら'{
			'\0\s[6]それでは、\w9\w9\s[5]私も殺傷數を稼いできます。\w9\w9\1\s[10]お前が言うとヤバすぎるぞ。'
		}
		//---- 東方遊撃姫 -----------------------------------------------------------------------------------------------------
		elseif reference0 == '霊夢'{
			'\0\s[6]このさきには\w9\n暴力的で\w9\n鬼のような\w9\n殺戮兵器どもが\w9\nあなたをまっています\w9\w9\s[0]\n[150]そ\w9れ\w9で\w9も\w9プレイしますか？\w9\w9\1\s[10]ゲーム違うぞ。'
		}
