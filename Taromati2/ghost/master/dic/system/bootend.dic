/////////文　ゴーストテンプレート
/////////起動/終了/切り替えトーク辭書
/////////written by umeici.
BaseGhostStart{//改動於2020 by steve02081504
	VERSION_UPGRADE
	OnOptionSet
	OnDiscordPluginCustomEnd
	--
	FCHARSET(1)
	lastTalk = '\0\s[20]咦？分明才剛啟動的說…\1\s[10]喵，剛才什麼都沒說'
	if TimeErrorCheck
		InTimeError = 1
	if !InTimeError
		BaseGhostStart.aboutTime
	playingmusic = 0
	displaypowerstatus = 1
	infomode = 0
	OnSQLLoad
	OnAILoad
	--
	'\0\v'
	--
	if topmode != 2
		TopModeChanged
	--
	{
		if GHOST.INgit && !SHIORI_FW.DebugMode
			OpenDocForRuntime('ghost_in_git_but_Debug_mode_not_open')
		--
		if GHOST.INtempDir
			OpenDocForRuntime('ghost_in_temp_dir')
	}
}
BaseGhostStart.aboutTime{
	Lunar
	Lunartime
	elapsetime = GETSECCOUNT - CloseTime
	CloseTime = GETSECCOUNT
	if (lastbootdate != (year,month,day)){
		bootcount_inthisday=0
		lastbootdate=(year,month,day)
	}
	bootcount_inthisday++
}
OnInitialize{
	if reference0=='reload'{
		OnSQLLoad.Fixer//非中文環境編碼問題再修復
		SETTAMAHWND(TamaHwnd)
		if ReloadFromTerminal{
			if SHIORI_FW.EmergencyMode
				ShioriEcho.Special=ansi_red+'語法錯誤：使用'+ansi_reset+'errorlog'+ansi_red+'命令查看錯誤日誌'+ansi_reset
			else{
				ShioriEcho.Special='重載完成'
				if GHOST.IsGitPath
					ShioriEcho.Special+='\n'+GhostTerminal.GITinfo
			}
			ERASEVAR('ReloadFromTerminal')
		}
		if SHIORI_FW.LastBootInEmergencyMode
			return
		if mode == '1'{
			"\1\s[%(specialmode != 'mealtime')10]唔…\n重載完了。"
			return
		}
		if !SHIORI_FW.EmergencyMode{
			'\0\s[0]重載成功，沒有語法錯誤'
			'\0\s[0]重載完成'
			if GetPhase >= 2
				'\0\s[5]重載成功，沒有出錯哦'
		}
	}
}
//**** 初回起動 *******************************************************************************************************
OnFirstBoot{//改動於2020 by steve02081504
	MAGICLOCK
	VERSION_INIT
	BaseGhostStart
	CLEARERRORLOG//未進行變數值恢復錯誤忽略
	--
	if !ISVAR('FirstBootCount'){
		mode = '0'
		aitalkinterval = 180
		if !username
			username = 'お兄さん'
		mirror_url=default_mirror_url
		if !InTimeError
			firstboottime = "%(year),%(month),%(day),%(hour),%(minute)"
		elapsedtime = 0
		Goodevening = ''
		intimacy = 0
		stroke = 0
		mikireflag = 0
		KikkaTalkmode = 0
		KikkaAImode = 1
		KikkaAILogic = 1
		OnKikkaReset
		InitPassword
		--
		if ISINTEGER(reference0)
			FirstBootCount = reference0
		elseif ISINTEGER(_argv[0])
			FirstBootCount = _argv[0]
		else
			FirstBootCount = 0
		--
		if FirstBootCount >= 4{
			OnDDLCend
			return
		}
		--
		'\![create,shortcut]\![create,shortcut,startup]\![open,readme]\v'
		--
		if FirstBootCount == 0{
			'\1\s[10]\0\s[26]啊、\w9\w9那個…\w9\w9\w9'
		}else{
			intimacy = 5
			'\1\s[10]\0\s[7].\w9.\w9.\w9.\n\w9\w9\s[8]很遺憾\w9\w9\w9\n[150]\s[3]即使是再次見面\w9\w9，也記不起來曾經的事了。\w9\w9'
		}
		--
		'\n[150]暫時、\w9要在此處打擾您了。'
		--
		SHIORI_FW.PushNoBreakNotifyResult(DiscordCustomSet.CustomDetail('初次見面'))
		--
		SHIORI_FW.PushNoBreakNotifyResult(GetUsernameFirst)
		SHIORI_FW.PushNoBreakNotifyResult(GetPasswordFirst)
		if QuickStartVersion
			SHIORI_FW.PushNoBreakNotifyResult(UpdateFirst)
		--
		if InTimeError
			SHIORI_FW.PushNoBreakNotifyResult(OnCheckTimeCorrect)
	}else{
		OnBoot('FromFirstBoot')
	}
}
GetUsernameFirst{
	"\w9\w9\s[100]那麼、\w9\n可以告訴我名字嗎？\n/
	\q[◇跳過,Cancel,with_sakura,%(SakuraScriptArgConverter('\![close,inputbox,OnGetUsernameFirst]'))]/
	\![set,balloontimeout,0]\![open,inputbox,OnGetUsernameFirst,-1,%(SakuraScriptArgConverter(username))]"
}
GetPasswordFirst{
	HaveNotGetPassword = 1
	"\1\s[10]\0\s[26]那麼，保險起見，能和%(username)約定一個密碼麼？\w9\n（此密碼用於‘秘密服務’模組，若不填寫預設密碼將為'void'）\n/
	\q[◇跳過,Cancel,with_sakura,%(SakuraScriptArgConverter('\![close,inputbox,OnPasswordUpdate]'))]/
	\![set,balloontimeout,0]\![open,passwordinput,OnPasswordUpdate,-1]"
}
UpdateFirst{
	'\![close,inputbox,OnPasswordUpdate]'
	--
	ERASEVAR('HaveNotGetPassword')
	OpenDocForRuntime('welcome')
	--
	'\w9\w9\0\s[6]\c/
	現在開始初次啟動時的聯網補全\w9\n/
	現有人格功能在此期間仍然可用\w9\n/
	其餘功能在成功後會獲得補全\w9\n/
	可能會突然重啟人格\w9\n/
	請不必擔心\w9\w9'
	--
	MAGICSAVE
	--
	OnInstallFullDataPack
}
//**** 時間帯判定 *****************************************************************************************************
GetTimeSlot{
	case hour{
		when 4-6
			'Earlymorning'
		when 7-10
			'Morning'
		when 11-16
			'Day'
		when 17-18
			'Evening'
		when 19-23
			'Night'
		others
			'Midnight'
	}
}
Select.stoprm{
	HolidayRemindFlag = 1
	OpenMenu
}
//**** 起動 ***********************************************************************************************************
OnBoot{
	MAGICLOCK
	BaseGhostStart
	--
	SHIORI_FW.PushNoBreakNotifyResult(OnBoot.base(_argv))
	--
	if LOADED_FROM_MAGIC
		OnSilentChangeShell(shellID)
	else
		SHIORI_FW.PushNoBreakNotifyResult(OnAutoChangeShell.boot)
	--
	if AutoUpdate{
		if QuickStartVersion && !FullDataPackInstalled
			SHIORI_FW.PushNoBreakNotifyResult(OnInstallFullDataPack)
		else
			SHIORI_FW.PushNoBreakNotifyResult(OnSilentUpdate)
	}
}
OnBoot.base{
	if reference6 == 'halt'
		DiscordCustomSet.CustomDetail('Halt!')
	--
	if mode == '1'{
		if specialmode == 'mealtime'
			mealendtime=60
		"\0\s[-1]\1\s[%(specialmode != 'mealtime')10]呦。\w9\n"
		--
		if reference6 == 'halt' {
			if reference7 == 'Taromati2' 
				'電腦沒問題嗎？'
			elseif IsGhostExist(reference7)
				"不去找%(GetSakuraNameFromGhostName(reference7))它們聊聊？"
			else
				'那傢伙，\s[13]\w9見不到了啊。'
			--
			'\x'
		}
		return
	}
	if reference6 == 'halt' {
		'\0\s[8]'
		--
		if reference7 == 'Taromati2' 
			'電腦\w8沒問題嗎？'
		elseif IsGhostExist(reference[7])
			"\s[26]需要去找%(GetSakuraNameFromGhostName(reference[7]))聊聊嗎？"
		else
			'.\w9.\w9.\w9發生了什麼事呢？\n'
		--
		'\x'
	}
	--
	if elapsetime > 300 && specialmode == 'mealtime'{
		void Onmealfin
	}
	if uninstall || (_argv[0]=='FromFirstBoot' && elapsetime > 172800){
		ERASEVAR('uninstall')
		money = 0//重裝懲罰
		if elapsetime > 86400//卸載時長超過一天懲罰
			intimacy -= 3
		if elapsetime > 172800{//卸載時長超過兩天：有效卸載
			FirstBootCount++
			if FirstBootCount >= 4{//三次有效卸載後懲罰
				{//自我銷毀
					void DELDIR('PROFILE_PATH')//清除使用者資料
					ERASEALLVARBEGINAS('')//清除所有變數
					S_CHARSET = GETSETTING('charset.output')//保證輸出
					FirstBootCount=13//再也不見
					MAGICSAVE//永久生效
				}
				OnDDLCend
				return
			}elseif FirstBootCount == 3{//這是第三次重裝警告
				'\0\s[35]\w9.\w9.\w9.\w9\w9\w9\n\s[8]最後一次了。\w9\w9\w9\w9\n'
			}else{
				"\0\s[26]再次見面，%(username)。\s[8]\w9\1\s[10]\很過分啊，這種事不要再做了\w9\w9\w9\n"
			}
			--
			'\x'
		}else{
			MAGICSAVE
			"\0\s[26]再次見面，%(username)。"
			--
			if uninstall
				'\s[8]\w9\1\s[10]\什麼啊，虛驚一場麼\w9\w9\w9\n\x'
		}
	}
	elseif SHIORI_FW.InVarFileMiss{//完全失憶
		OnFirstBoot(1)
		return
	}
	elseif LOADED_FROM_MAGIC{//資料來自MAGICSAVE
		intimacy -= 1
		SHIORI_FW.PushNoBreakNotifyResultToTop('\0\s[35]\w9.\w9.\w9.\w9\w9\w9\n\s[0]啊\w9\w9\s[6]，很抱歉\n\w9\w9\w9我做了個惡夢\w9\w9\w9\n\x')
		return
	}
	--
	if !ISVAR('FirstBootCount'){
		OnFirstBoot(1)
		return
	}
	--
	if InTimeError
		SHIORI_FW.PushNoBreakNotifyResultToTop(OnCheckTimeCorrect)
	else
		OnBoot.aboutTime
	--
	if !TOINT(autobackup) && autobackupclosealert{
		_t = '○,●'
		"\C\_q\1\s[10]\0\s[40]■橘花提醒■\n為避免人格失憶，請設自動備份開關為On，當前自動備份功能關閉，請定期手動備份。\n/
		自動備份　　　\q[%(_t[TOINT(autobackup)]) ON,Onusage,autobackup,1]  ・  \q[%(_t[1 - TOINT(autobackup)]) OFF,Onusage,autobackup,0]\n/
		\q[◇不再提醒,Onusage,autobackupclosealert,0]\n/
		\x"
	}
	--
	OnWeatherUpdate.boot
}
OnBoot.aboutTime{
	_phase = GetPhase
	_timeslot = GetTimeSlot
	//-------------------------------------------------------------------
	if elapsetime >= 36000 && elapsetime < 86400{
		HolidayRemindFlag = 0
	}
	elseif elapsetime >= 86400 && elapsetime < 604800{
		HolidayRemindFlag = 0
		birthdaygiftmode = 0
		giftmode = 0
	}
	--
	BirthDay.BootRemind
	--
	if acjeachday{
		if (_t=Onautojeachday)!='' {
			_t
			--
			'\x'
		}
	}
	--
	//--------------------設置節日提醒--------------------
	Lunartime
	if lunardata[5] == '五' && lunardata[6] == '初五'{
		if giftmode!=1{
			"\1\s[10]\0\s[28]那個…\w9\w9\n我為%(username)買了點東西。\n[300]\q[◇打開看看,Ongift,2]"
		}
		else{
			"\1\s[10]\0\s[40]啊、\w9%(username)。\w9\w9那個…\w9\w9\n我包了一些粽子、\w9\w9\n如果可以的話請嘗嘗看。\x\s[20]不知%(username)喜歡甜的鹹的還是喜歡辣的，\w9\w9\s[5]所以橘花就做成又甜又鹹又辣的口味。\w9\w9\1\s[10]怪味？"
		}
		--
		'\n\x'
	}
	elseif lunardata[5] == '七' && lunardata[6] == '初七' && giftmode!=1{
		"\0\s[28]今天是七月初七，\w9\w9%(username)知道是什麼日子嗎？\w9\w9這是橘花特意為%(username)準備的。 \n\n\q[◇打開看看,Ongift,3]"
		--
		'\n\x'
	}
	elseif lunardata[5] == '八' && lunardata[6] == '十五'{
		if giftmode!=1
			"\0\s[28]啊，\w9%(username)，\w9\w9\s[5]中秋節快樂，\w9\w9橘花派發禮物了，\w9\w9看看這次是什麼？\n\n\q[◇打開看看,Ongift,4]"
		else{
			"\0\s[0]月亮代表誰的心，\w9\w9\s[1]每逢佳節倍思親，\w9\w9\s[5]%(username)，\w9\w9中秋快樂！！\w9\w9\1\s[10]中秋節快樂喵。"
			"\0\s[25]共賞一彎明月，\w5\w9灑紅牆，\w9\w9借杯烈酒，\w5\w9我醉倒，\w9\w9落葉沙沙，\w5\w9曉秋月明，\w9\w9西江邊聽你唱；\n\w9\w9\w9\w9唱完一彎明月，\w5\w9灑西樓，\w9\w9花好月圓，\w5\w9情字老，\w9\w9聽你輕輕，\w5\w9唱起了家，\w9\w9正月既望兩斷了情長。\n\w9\w9\w9\w9\1\s[10]初音ミク的歌啊，\w9\w9什麼時候學會的？\n\w9\w9\0\s[9]\n剛學的，\w9唱的不好吧？\n\w9\w9\w9\1\s[10]為了在%(username)面前唱這首歌，\w9實際上練了很久吧？\n\w9\w9\0\s[32]才、才不是呢。\w9\w9\s[26]%(username),\w9橘花準備了一些點心，\w9\w9來嘗嘗吧\w9\w9\1\s[10]有魚鬆月餅吃嗎"
		}
		--
		'\n\x'
	}
	elseif month == 1 && day == 1{
		if giftmode!=1{
			"\1\s[10]\0\s[28]今天是新年的第一天，橘花為%(username)包了禮物。\n[300]\q[◇打開看看,Ongift,0]"
		}
		else{
			'\1\s[10]\0\s[2]新年快樂！うれしい！\w8\w8\1\s[10]恭喜。\w8\w8\0\s[5]\n[150]今年也請多多指教。'
			'\1\s[10]\0\s[26]新年快樂。\w9\w9\1\s[10]恭喜。\w9\w9\0\s[5]\n[150]今年也請多多指教。'
		}
		--
		'\n\x'
	}
	elseif month == 2 && day == 14{
		if giftmode!=1{
			"\1\s[10]\0\s[28]那個…\w9\w9\n我為%(username)買了點東西。\n[300]\q[◇打開看看,Ongift,1]"
		}
		else{
			"\1\s[10]\0\s[40]啊、\w9%(username)。\w9\w9\n[150]\s[28]那個…\w9\w9\n我烤了一點餅乾、\w9\w9\n如果可以的話請嘗嘗看。"
		}
		--
		'\n\x'
	}
	elseif month == 10 && day == 31{
		if bootcount_inthisday == 1{
			'\0\s[27]\_sTrick Or Treat！\_s！\_s\n/
			\w7.\w7.\w7.\w9\n\_s/
			\1\_q沒有\0有\_q\_s糖果\_s\_q嗎？\1嗎\_q\w7.\w7.\w7.\w9\_s\n\_s/
			\0\s[5]不過我準備了點糖果哦，'
			--
			_candy_list=IARRAY
			_candy_exp_list=IARRAY
			if GetPhase>=3{
				if nurturance.Darkness > 72{
					_candy_list,='特製紅糖夾心巧克力'//其實摻了血
					_candy_exp_list,='love,blood,notfortowa'
				}
				else{
					_candy_list,='巧克力味'
					_candy_exp_list,='love'
				}
			}
			if nurturance.Darkness > 100{
				_candy_list,='鐵銹味'//摻了更多的血
				_candy_exp_list,='blood,bad'
			}
			if nurturance.Moeness > 10 && nurturance.Darkness > 10{
				_candy_list,='蒜蓉味'
				_candy_exp_list,='bad'
			}
			if nurturance.Moeness > 15 && nurturance.Darkness > 15{
				_candy_list,='五仁味'
				_candy_exp_list,='bad'
			}
			if nurturance.Moeness > 20 && nurturance.Darkness > 20{
				_candy_list,='芥末味'
				_candy_exp_list,=''
			}
			if nurturance.Moeness > 100 && nurturance.Darkness > 100{
				_candy_list,='魔鬼辣椒味'
				_candy_exp_list,='bad'
			}
			SETDELIM(_candy_list,'、\w7')
			if ARRAYSIZE(_candy_list)==0{
				'\s[8]雖然幾乎都是商店裡買的糖果\w9\n/
				\1\嘛，\w7也不錯吧。'
			}
			if ARRAYSIZE(_candy_list)==1{
				'\s[8]雖然幾乎都是'+TOSTR(_candy_list)
				--
				if 'love' _in_ _candy_exp_list[0]
					'，\s[1]但是請務必嘗嘗看'
				else
					'\w7.\w7.\w7.\w9\n/
					\1你本打算用這種東西招待鄰居嗎？？\n\x'
			}
			else{
				'有'+TOSTR(_candy_list)
				--
				if 'love' _in_ TOSTR(_candy_exp_list)
					'\n，\w9請 \w9 務\w9 必\w9 要\w9嘗嘗看哦!\n'
				else
					'。'
				--
				'\1'
				--
				if 'bad' _in_ TOSTR(_candy_exp_list){
					'\s[11]你打算用這種東西招待鄰居嗎？？'
					'啊，\s[13]\w7我今天肚子不好先算了'
				}
				if 'love' _in_ TOSTR(_candy_exp_list)
					'\s[13]年輕真好啊。\n/
					\0\s[8]欸？'
			}
			--
			'\n\x'
		}
	}
	elseif month == 11 && day == 1{
		if bootcount_inthisday == 1{
			'\1\s[10]\0\s[27]今天是萬聖節哦，\w9\s[5]萬聖節快樂！\w9\w9\n'
			--
			if nurturance.Darkness > 20
				'\s[27]來找我的鬼怪可能會比較多，我會妥善處理好的。\w9\n/
				\1.\w7.\w7.？'
			--
			'\n\x'
		}
	}
	elseif month == 11 && day == 11{
		if giftmode!=1{
			"\1\s[10]\0\s[28]那個…\w9\w9\n我為%(username)買了點東西。\n[300]\q[◇打開看看,Ongift,6]"
		}
		else{
			"\1\s[10]\0\s[40]啊、\w9%(username)。\w9\w9\n[150]\s[28]那個…\w9\w9\n我烤了一點餅乾、\w9\w9\n如果可以的話請嘗嘗看。"
		}
		--
		'\n\x'
	}
	elseif year-firstboottime[0]>0&&month == firstboottime[1] && day == firstboottime[2]{//周年日
		if giftmode!=1{
			"\1\s[10]\0\s[28]那個…\w9\w9\n我為%(username)買了點東西。\n[300]\q[◇打開看看,Ongift,7]"
		}
		else{
			"\1\s[10]\0\s[40]啊、\w9%(username)。\w9\w9\n[150]\s[28]那個…\w9\w9\n我烤了一點餅乾、\w9\w9\n如果可以的話請嘗嘗看。"
		}
		--
		'\n\x'
	}
	elseif month == 12 && day == 24{
		'\1\s[10]\0\s[27]Merry Christmas・Eve♪\w9\w9\1\s[10]'
		--
		'…\w9…\w9…'
		'…\w9根本沒有慶祝的意思是吧。'
		{
			'…\w9那是死掉的日子吧。'
			--
			'\w9\w9\0\s[27]\n[150]朗基努斯比較好嗎？\w9\w9\1\s[10]\n[150]不…\w9\w9我說啊…'
			''
		}
		'一點都不Merry啊…'
		--
		'\n\x'
	}
	elseif month == 12 && day == 25{
		if giftmode!=1{
			"\1\s[10]\0\s[28]%(username),\w9 Merry Christmas，\w9這是橘花為%(username)準備的禮物。\n/
			\n\n\q[◇打開看看,Ongift,5]"
		}
		else{
			'\1\s[10]\0\s[27]Merry Christmas♪\w9\w9\1\s[10]'
			--
			'…\w9…\w9…'
			'…\w9根本沒有慶祝的意思是吧。'
			{
				'…\w9那是死掉的日子吧。'
				--
				'\w9\w9\0\s[27]\n[150]朗基努斯比較好嗎？\w9\w9\1\s[10]\n[150]不…\w9\w9我說啊…'
				''
			}
			'一點都不Merry啊…'
		}
		--
		'\n\x'
	}
	--
	_inreboot=inreboot
	_inshutdown=inshutdown
	ERASEVAR('inreboot')
	ERASEVAR('inshutdown')
	//小於5min
	if elapsetime <= 300{
		if _inreboot || _inshutdown{
			'\1\s[10]\0\s[0]歡迎回來\x'
		}else{
			'\1\s[10]\0\s[2]怎麼了呢....？\x'
			'\1\s[10]\0\s[2]怎麼這麼快回來了呢....？\x'
			'\1\s[10]\0\s[0]還有需要到我們的地方嗎....？\x'
		}
	}
	//超過一周小於一月半
	elseif elapsetime > 604800 && elapsetime < 3628800{
		intimacy--
		HolidayRemindFlag = 0
		birthdaygiftmode = 0
		"\0\s[21]\w6\s[0]好久不見啊，%(username)。\1\s[10]至少有一個禮拜沒見了吧。\x"
		"\1\s[117]%(username)把我們給忘了嗎,\w9這麼久才回來。\w9\w9\0\s[0]%(username)，好久不見啊。\x"
		"\1\s[10]\0\s[21]\w6\s[5]%(username) ，好久不見\1\s[10]至少有一個禮拜沒見了吧。\x"
	}
	//超過一月半小於半年
	elseif elapsetime >= 3628800 && elapsetime < 15768000{
		intimacy-=5
		HolidayRemindFlag = 0
		birthdaygiftmode = 0
		"\0\s[21]\w6\s[0]好久不見啊，%(username)。\1\s[10]至少有一個月沒見了吧。\x"
		"\1\s[117]%(username)把我們給忘了嗎,\w9這麼久才回來。\w9\w9\0\s[0]%(username)，好久不見啊。\x"
		"\1\s[10]\0\s[21]\w6\s[5]%(username) ，好久不見\1\s[10]至少有一個月沒見了吧。\x"
	}
	//超過半年
	elseif elapsetime >= 15768000{
		intimacy -= 3
		HolidayRemindFlag = 0
		birthdaygiftmode = 0
		_years = TOINT(FLOOR(elapsetime / 31536000))
		if _years==0{
			"\0\s[21]\w6\s[0]好久不見啊，%(username)。\1\s[10]至少有半年沒見了吧。\x"
			"\1\s[117]%(username)把我們給忘了嗎,\w9這麼久才回來。\w9\w9\0\s[0]%(username)，好久不見啊。\x"
			"\1\s[10]\0\s[21]\w6\s[5]%(username) ，好久不見\1\s[10]至少有半年沒見了吧。\x"
		}else{
			"\0\s[3]%(username)\w8，%(_years)年未見\n\1\s[10]過得還好嗎？\w6\n小公主可是一直都在等你哦？\x"
		}
	}
	else{
		case _timeslot{
			when 'Earlymorning'{
				talkmemo = 'b_0'
				'\1\s[10]\0\s[0]'
				--
				if _phase >= 2
					'啊…\w9\w9\s[40]'
				--
				"早安、\w9%(username)。\w9\w9\1\s[10]…\w9…\w9…\w9\w9\w9"
				--
				'\0\s[0]\n[150]這麼早是怎麼了呢？\x'
				'\0\s[26]\n[150]今天很早呢。\x'
			}
			when 'Morning'{
				if _phase >= 2{
					"\1\s[10]\0\s[26]早安、\w9%(username)。\x"
					"\1\s[10]\0\s[40]早安、\w9%(username)。\w9\w9\w9\w9\s[26]\n今天一天也好好加油吧。\x"
					"\1\s[10]\0\s[26]%(username)、\w9早安。\w9\w9\1\s[10]喲。\x"
					'\1\s[10]\0\s[40]早安。\w9\w9\1\s[10]喲。\x'
				}
				else{
					"\1\s[10]\0\s[26]早安、\w9%(username)。\x"
					"\1\s[10]\0\s[0]早安、\w9%(username)。\w9\w9\w9\w9\s[26]\n今天一天也好好加油吧。\x"
					"\1\s[10]\0\s[26]%(username)、\w9早安。\w9\w9\1\s[10]喲。\x"
					'\1\s[10]\0\s[26]早安。\w9\w9\1\s[10]喲。\x'
				}
			}
			when 'Day'{
				if _phase >= 2{
					if weekday == '0'
						'\0\s[26]早安。\w9\w9\n…\w9嗯、\w9\s[8]已經中午了喔。\w9\w9\1\s[10]反正是禮拜天嘛。\w9\w9\n有好好休息嗎？\x'
					else{
						"\1\s[10]\0\s[2]啊。\w9\w9\s[40]\n午安、\w9%(username)。\x"
						"\1\s[10]\0\s[40]午安、\w9%(username)。\1\s[10]喲。\x"
						"\1\s[10]\0\s[26]%(username)、\w9午安。\x"
						'\1\s[10]\0\s[26]午安。\1\s[10]喲。\x'
					}
				}
				else{
					"\1\s[10]\0\s[0]午安、\w9%(username)。\x"
					"\1\s[10]\0\s[0]午安、\w9%(username)。\1\s[10]喲。\x"
					"\1\s[10]\0\s[26]%(username)、\w9午安。\x"
					'\1\s[10]\0\s[26]午安。\1\s[10]喲。\x'
				}
			}
			when 'Evening'{
				if Goodevening == ''{
					"\1\s[10]\0\s[26]啊、\w9%(username)…\w9\w9\w9\s[0]\n[150]嗯…\w9\w9\w9在這個時間帶問安、\w9\n應該用『午安』還是用『晚安』呢？\n[150]/
					\q[◇午安,Goodevening_0]\n/
					\q[◇晚安,Goodevening_1]\n/
					\q[◇傍晚好,Goodevening_2]\n/
					\q[◇都可以,Goodevening_3]\x"
				}
				else{
					"\1\s[10]\0\s[26]%(Goodevening)、\w9\w9%(username)。\x"
					"\1\s[10]\0\s[26]%(Goodevening)、\w9\w9%(username)。\w9\w9\n沒有被跟蹤吧？\w9\w9\1\s[10]…\w9…\w9…\x"
				}
			}
			when 'Night'{
				"\1\s[10]\0\s[26]晚安、\w9%(username)。\x"
				"\1\s[10]\0\s[0]晚安、\w9%(username)。\x"
				'\1\s[10]\0\s[26]晚安。\x'
				'\1\s[10]\0\s[0]晚安。\x'
				"\1\s[10]\0\s[26]%(username)、\w9\w9\w9晚安。\x"
			}
			when 'Midnight'{
				if weekday == '0'{
					"\1\s[10]\0\s[0]啊、\w9\w9\w9\s[26]晚安、\w9%(username)。\w9\w9\w9\w9\n就算是假日、\w9\n也不要太晚睡喔。\x"
				}
				else{
					talkmemo = 'b_1'
					"\1\s[10]\0\s[0]晚安、\w9%(username)。\w9\w9\w9\w9\s[26]\n這麼晚是怎麼了呢？\x"
					"\1\s[10]\0\s[0]晚安、\w9%(username)。\w9\w9\w9\w9\n半夜了呢。\x"
				}
			}
		}
	}
	--
	if HolidayRemindFlag != 1 && rmswitch == 0 && (lunartime[9] != NULL || lunartime[10] != NULL ){
		"\1\s[10]\0\s[40]\![raise,OnPlaySound,tinkle.wav]今天是%(lunartime[9]) %(lunartime[10])\n/
		\q[◇10小時內不再提醒,stoprm]\n\x"
	}
}
Select.Goodevening_0{
	Goodevening = '午安'
	"\1\s[10]\0\s[100]我知道了。\w9\w9\n那麼、\w9\s[26]%(Goodevening)、\w9%(username)。"
}
Select.Goodevening_1{
	Goodevening = '晚安'
	"\1\s[10]\0\s[100]我知道了。\w9\w9\n那麼、\w9\s[26]%(Goodevening)、\w9%(username)。"
}
Select.Goodevening_2{
	Goodevening = '傍晚好'
	"\1\s[10]\0\s[100]我知道了。\w9\w9\n那麼、\w9\s[26]%(Goodevening)、\w9%(username)。"
}
Select.Goodevening_3{
	Goodevening = ANY('午安','晚安','傍晚好')
	"\1\s[10]\0\s[100]…\w9…\w9…\w9\w9\w9\w9\n那麼、\w9\s[26]%(Goodevening)、\w9%(username)。"
}
