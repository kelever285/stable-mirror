Onaward{
	if award==1 && class=='D'{
		money+=TOINT(0.5*level*50*lvl)
		"\0\s[5]已領取D級任務獎勵，得到%(TOINT(0.5*level*50*lvl))金\x"
		award=0
	}
	elseif award==1 && class=='C'{
		money+=TOINT(1*level*50*lvl)
		"\0\s[5]已領取C級任務獎勵，得到%(TOINT(level*1*50*lvl))金\x"
		award=0
	}
	elseif award==1 && class=='B'{
		money+=TOINT(2*level*50*lvl)
		"\0\s[5]已領取B級任務獎勵，得到%(TOINT(level*2*50*lvl))金\x"
		award=0
	}
	elseif award==1 && class=='A'{
		money+=TOINT(4*level*50*lvl)
		"\0\s[5]已領取A級任務獎勵，得到%(TOINT(level*4*50*lvl))金\x"
		award=0
	}
	elseif award==1 && class=='S'{
		money+=TOINT(8*level*50*lvl)
		"\0\s[5]已領取S級任務獎勵，得到%(TOINT(level*8*50*lvl))金\x"
		award=0
	}
	else{
		'\0\s[8]未達到獎勵條件，領取失敗\x'
	}
	--
	--
	OpenRpgGameMenu(5)
}
Onmission{
	class=reference0
	level=reference1
	RpgGameVar
	mnum=0
	award=0
	if level==1{
		'橘花和鬥和來到了農場\x'
	}
	elseif level==1.1{
		'橘花和鬥和來到了平原\x'
	}
	elseif level==1.2{
		'橘花和鬥和來到了山地\x'
	}
	elseif level==1.3{
		'橘花和鬥和來到了河谷\x'
	}
	elseif level==1.4{
		'橘花和鬥和來到了山谷\x'
	}
	elseif level==1.5{
		'橘花和鬥和來到了濕地\x'
	}
	elseif level==1.6{
		'橘花和鬥和來到了地下封印區入口\x'
	}
	elseif level==1.7{
		'橘花和鬥和來到了在地下封印區上層\x'
	}
	elseif level==1.8{
		'橘花和鬥和來到了地下封印區中層\x'
	}
	elseif level==1.9{
		'橘花和鬥和來到了地下封印區下層\x'
	}
	elseif level==2{
		'橘花和鬥和來到了地下封印區核心\x'
	}
	--
	Onbattle
}
Onbattle{
	battlemode=2
	f=RAND(100)
	if f>15 && f<=50{
		'什麼也沒發現。\n/
		\q[◇繼續逛,Onbattle]\n/
		\q[◇休息一下,On休息]\n/
		\q[◇回去吧,back]'
	}
	elseif f>5 && f<=15{
		i=RAND(9)
		if i<5{
			"發現%(itemA[(mlv/18)%5][2])\n/
			\q[◇繼續逛,Onbattle]\n/
			\q[◇休息一下,On休息]\n/
			\q[◇回去吧,back]"
			itemAnum[(mlv/18)%5]=TOINT(itemAnum[(mlv/18)%5]+1)
		}
		elseif i>=5{
			"發現%(itemB[(mlv/18)%5][2])\n/
			\q[◇繼續逛,Onbattle]\n/
			\q[◇休息一下,On休息]\n/
			\q[◇回去吧,back]"
			itemBnum[(mlv/18)%5]=TOINT(itemBnum[(mlv/18)%5]+1)
		}
	}
	elseif f<=5{
		"發現%(5*mlv)金\n/
		\q[◇繼續逛,Onbattle]\n/
		\q[◇休息一下,On休息]\n/
		\q[◇回去吧,back]"
		money+=5*mlv
	}
	elseif f>50{
		if mnum==9{
			b=RAND(2)
			if b==1 && level==2{
				怪物名字='幻想樂曲複合體'
				"發現終級BOSS：%(怪物名字),要退卻嗎？\n/
				\q[◇退卻,Onbattle]\n/
				\q[◇迎戰,Onbossfight]"
			}
			else{
				怪物名字=monster
				"發現%(怪物名字),進入戰鬥\x"
				--
				Onbattleinter
			}
		}
		else{
			怪物名字=monster
			"發現%(怪物名字),進入戰鬥\x"
			--
			Onbattleinter
		}
	}
}
Onbattleinter{
	ANG=1
	STRADD=1
	DEFADD=1
	DEFMINUS=1
	IGN=1
	MIGN=1
	MANG=1
	MSTRADD=1
	MDEFADD=1
	MDEFMINUS=1
	SILENT=0
	bosslevel=1
	if _argc>0
		bosslevel=_argv[0]
	if class=='D'{
		怪物魔防=-2
		mlvx=RAND(3+mcircle)
		RpgGameVar
		battlebegin(bosslevel*level*mhpmaxD,mstrD,mdefD,matsD,madfD,1)
	}
	elseif class=='C'{
		怪物魔防=-1
		mlvx=RAND(6+2*mcircle)
		RpgGameVar
		battlebegin(bosslevel*level*mhpmaxC,mstrC,mdefC,matsC,madfC,2)
	}
	elseif class=='B'{
		怪物魔防=0
		mlvx=RAND(9+3*mcircle)
		RpgGameVar
		battlebegin(bosslevel*level*mhpmaxB,mstrB,mdefB,matsB,madfB,4)
	}
	elseif class=='A'{
		怪物魔防=1
		mlvx=RAND(12+4*mcircle)
		RpgGameVar
		battlebegin(bosslevel*level*mhpmaxA,mstrA,mdefA,matsA,madfA,8)
	}
	elseif class=='S'{
		怪物魔防=1
		mlvx=RAND(15+5*mcircle)
		RpgGameVar
		battlebegin(bosslevel*level*mhpmaxS,mstrS,mdefS,matsS,madfS,16)
	}
}
Onbossfight{
	if class=='D'
		level=4
	elseif class=='C'
		level=5
	elseif class=='B'
		level=6
	elseif class=='A'
		level=7
	elseif class=='S'
		level=8
	Onbattleinter(2)
}
monster{
	if level==1{
		'黃鼠狼怪'
		'田鼠怪'
		'鳳梨怪'
	}
	elseif level==1.1{
		'野豬怪'
		'黑熊怪'
		'大蜥蜴'
	}
	elseif level==1.2{
		'野狼怪'
		'劍齒獸'
		'食人怪'
	}
	elseif level==1.3{
		'剪刀蟹'
		'暴躁氣泡'
		'骸骨魚'
	}
	elseif level==1.4{
		'劍齒吸血魔'
		'烈炎草'
	}
	elseif level==1.5{
		'貪婪鍔魚'
		'兇暴巨鍔'
	}
	elseif level==1.6{
		'偵察飛行器'
		'機械守衛'
	}
	elseif level==1.7{
		'光子裁決'
		'高能裝甲'
	}
	elseif level==1.8{
		'毀滅者D型'
		'毀滅者S型'
		'毀滅者M型'
	}
	elseif level==1.9{
		'守護之臂R'
		'守護之臂L'
	}
	elseif level==2{
		'幻想樂曲'
		'幻想樂曲II'
		'幻想樂曲III'
	}
}
battleinfo{
	if cp0>200{
		cp0=200
	}
	if cp1>200{
		cp1=200
	}
	戰技0=('0,助威,輔助,複體,3,20,STR+50%','1,雙管齊下,攻擊,單體,15,20,-100,2','2,列波三連射,攻擊,單體,20,20,325,3','3,金剛擊,攻擊,單體,25,20,驅動解除,1','4,歡樂激發,回復,複體,26,20,3000','5,櫻花排擊炮,攻擊S,單體,3,100,1000,10','6,橘花排擊炮,攻擊S,單體,24,100,1200,12','7,真・雙管齊下,攻擊,單體,43,30,600,6','8,真・列波三連射,攻擊,單體,67,40,900,9','9,真・金剛擊,攻擊,單體,70,50,驅動解除,9','10,歡樂激發2,回復,複體,67,25,6000','11,真・櫻花排擊炮,攻擊S,單體,80,100,2800,28','13,真・橘花排擊炮,攻擊S,單體,100,100,3200,32','14,奧義・天下無雙,攻擊S,單體,120,100,4800,48')
	戰技1=('0,雙連擊,攻擊,單體,3,20,-100,2','1,烈火取栗,攻擊,單體,15,20,-100,3','2,愛的軌跡,攻擊,單體,26,20,325,3','3,安魂曲,攻擊S,單體,3,100,1000,10','4,女王之怒,攻擊S,單體,24,100,1200,12','5,真・烈火取栗,攻擊,單體,43,30,600,6','6,真・愛的軌跡,攻擊,單體,67,40,900,9','7,真・安魂曲,攻擊S,單體,80,100,2800,28','8,真・女王之怒,攻擊S,單體,100,100,3200,32','9,奧義・量子風暴,攻擊S,單體,120,100,4800,48')
	--
	"\![quicksession,true]\1\![set,choicetimeout,0]\_l[0,0]橘花%(kikka)\f[color,231,171,109]等級\f[color,default]%(lvl0) \f[color,231,171,109]Next\f[color,default]%(nextexp0) \_l[150,-]鬥和%(towa)\f[color,231,171,109]等級\f[color,default]%(lvl1) \f[color,231,171,109]Next\f[color,default]%(nextexp1)\n/
	\f[color,231,171,109]HP\f[color,default]\_l[30,-]%(hp0)/%(hpmax0) %(ColorBar(6,20,hp0,hpmax0)) \_l[150,-]\f[color,231,171,109]HP\f[color,default]\_l[180,-]%(hp1)/%(hpmax1) %(ColorBar(6,170,hp1,hpmax1))\n/
	\f[color,231,171,109]EP\f[color,default]\_l[30,-]%(ep0)/%(epmax0) %(ColorBar(3,20,ep0,epmax0)) \_l[150,-]\f[color,231,171,109]EP\f[color,default]\_l[180,-]%(ep1)/%(epmax1) %(ColorBar(3,170,ep1,epmax1))\n/
	\f[color,231,171,109]CP\f[color,default]\_l[30,-]%(cp0)/%(cpmax0) %(ColorBar(9,20,cp0,cpmax0)) \_l[150,-]\f[color,231,171,109]CP\f[color,default]\_l[180,-]%(cp1)/%(cpmax1) %(ColorBar(9,170,cp1,cpmax1))\n/
	\_l[0,-]\__q[OnMonsterInfo]Class%(class)怪物\__q  \f[color,231,171,109]Level \f[color,default]%(mlv)  \_l[150,-]\f[color,231,171,109]HP \f[color,default]  %(ColorBar(6,170,mhp,mhpmax)) \_l[180,-]%(mhp)/%(mhpmax)\n"
}
OnMonsterInfo{
	"\1%(怪物名字)屬性攻擊有效率：\n/
	水：%(TOINT(100*水有效率))\n/
	火：%(TOINT(100*火有效率))\n/
	土：%(TOINT(100*土有效率))\n/
	風：%(TOINT(100*風有效率))\_l[170,-]\q[◇返回,backtoinfo]"
}
Select.backtoinfo{
	if battlemode==1{
		if kikka==1 && towa==0&&hp0>0||hp1==0
			Onbattleselect0
		elseif kikka==0 && towa==1&&hp1>0||hp0==0
			Onbattleselect1
	}
	elseif battlemode==2
		Onbattle
	else
		OnRpgGame(5)
}
battlebegin{
	battlemode=1
	if hp0==0{
		hp0=TOINT(0.1*hpmax0)
	}
	if hp1==0{
		hp1=TOINT(0.1*hpmax1)
	}
	mhpmax=TOINT(_argv[0])
	mhp=mhpmax
	助威回合=-1
	嚎叫回合=-1
	示威回合=-1
	黑暗詛咒回合=-1
	噬血詛咒回合=-1
	威脅回合=-1
	挑逗回合=-1
	忽略回合=-1
	敵視回合=-1
	憤怒暴發回合=-1
	禁寂之音回合=-1
	mstr=_argv[1]
	mdef=_argv[2]
	mats=_argv[3]
	madf=_argv[4]
	bata =_argv[5]
	kikka=1
	towa=0
	battleturn=0
	magicready0=0
	magicready1=0
	mmagicready=-1
	kikkadefend=0
	towadefend=0
	mdefend=0
	if level==1{
		水有效率=1.3
		火有效率=1.3
		土有效率=1
		風有效率=1
	}
	elseif level==1.1{
		水有效率=1.3
		火有效率=1.3
		土有效率=1
		風有效率=1
	}
	elseif level==1.2{
		水有效率=1.3
		火有效率=1.3
		土有效率=1
		風有效率=1
	}
	elseif level==1.3{
		水有效率=0.6
		火有效率=1.4
		土有效率=1
		風有效率=1
	}
	elseif level==1.4{
		水有效率=1.5
		火有效率=0.6
		土有效率=1
		風有效率=1
	}
	elseif level==1.5{
		水有效率=0.5
		火有效率=1.5
		土有效率=1
		風有效率=1
	}
	elseif level==1.6{
		水有效率=1
		火有效率=1
		土有效率=1.2
		風有效率=0.8
	}
	elseif level==1.7{
		水有效率=1.2
		火有效率=1.2
		土有效率=1.2
		風有效率=1.2
	}
	else{
		水有效率=1
		火有效率=1
		土有效率=1
		風有效率=1
	}
	RpgGameVar
	--
	Onbattleselect
}
Onbattleselect{
	_txt=''
	if mhp <= 0{
		mhp = 0
	}
	if hp0<0{
		hp0=0
		losehpnum+=1
		magicready0=0
		_txt+='\0\s[35]橘花失去戰鬥能力\x'
	}
	if hp1<0{
		hp1=0
		losehpnum+=1
		magicready1=0
		_txt+='鬥和失去戰鬥能力\x'
	}
	if battleturn==0 && hp0>0  && mhp>0{
		kikka=1
		towa=0
		battleturn=(battleturn+1)%2
		_txt+=Onbattleselect0
	}
	elseif battleturn==0 && hp0==0 &&hp1>0 && mhp>0{
		kikka=0
		towa=1
		battleturn=(battleturn+1)%2
		_txt+=Onbattleselect1
	}
	elseif battleturn==1 && hp1>0  && mhp>0{
		_txt+=戰技回合判定
		kikka=0
		towa=1
		battleturn=(battleturn+1)%2
		_txt+=Onbattleselect1
	}
	elseif battleturn==1 && hp1==0&&hp0>0 && mhp>0{
		kikka=1
		towa=0
		battleturn=(battleturn+1)%2
		_txt+=Onbattleselect0
	}
	elseif hp0==0 && hp1==0 && mhp>0{
		_txt+='戰鬥失敗，回到主目錄\x'
		battlefailednum+=1
		battlemode=0
		_txt+=OpenRpgGameMenu(5)
	}
	elseif hp0+hp1>0 && mhp==0{
		_txt+='\t\0\s[5]戰鬥勝利了。\x'
		_txt+=戰鬥結束
	}
	_txt+=battleinfo
	_txt
}
Onbattleselect0{
	if magicready0==1{
		準備魔法0
	}
	else{
		'\0\s[26]橘花應該\n'
		--
		if SILENT==1
			'\f[color,192,192,192]攻擊\f[color,default]\n'
		else
			'\q[◇攻擊,attack0]\n'
		--
		'\q[◇魔法,Onmagic,0,targetmode]\n'
		--
		if SILENT==1
			'\f[color,192,192,192]戰技\f[color,default]\n'
		else
			'\q[◇戰技,spattack0]\n'
		--
		'\q[◇道具,item0]\n/
		\q[◇逃跑,escape]'
	}
	--
	battleinfo
}
Onbattleselect1{
	if magicready1==1{
		準備魔法1
	}
	else{
		if towashell==0{
			'\0\s[26]當前鬥和形態為人形態,鬥和應該\n'
			--
			if SILENT==1
				'\f[color,192,192,192]攻擊\f[color,default]\n'
			else
				'\q[◇攻擊,attack1]\n'
			--
			'\q[◇吸煙,smoke]\n/
			\q[◇魔法,Onmagic,1,targetmode]\n'
			--
			if SILENT==1
				'\f[color,192,192,192]戰技\f[color,default]\n'
			else
				'\q[◇戰技,spattack1]\n'
			--
			'\q[◇道具,item1]\n/
			\q[◇逃跑,escape]'
		}
		if towashell==1{
			'\0\s[26]當前鬥和形態為動物形態,鬥和應該\n'
			--
			if SILENT==1
				'\f[color,192,192,192]攻擊\f[color,default]\n'
			else
				'\q[◇攻擊,attack1]\n'
			--
			'\q[◇吸煙,smoke]\n'
			--
			if SILENT==1
				'\f[color,192,192,192]獸技\f[color,default]\n'
			else
				'\q[◇獸技,beastsp]\n'
			--
			'\q[◇道具,item1]\n/
			\q[◇逃跑,escape]'
		}
		if towashell==2{
			'\0\s[26]當前鬥和形態為半獸形態,鬥和應該\n'
			--
			if SILENT==1
				'\f[color,192,192,192]攻擊\f[color,default]\n'
			else
				'\q[◇攻擊,attack1]\n'
			--
			'\q[◇吸煙,smoke]\n/
			\q[◇魔法,Onmagic,1,targetmode]\n'
			--
			if SILENT==1
				'\f[color,192,192,192]戰技\f[color,default]\n'
			else
				'\q[◇戰技,spattack1]\n'
			--
			if SILENT==1
				'\f[color,192,192,192]獸技\f[color,default]\n'
			else
				'\q[◇獸技,beastsp]\n'
			--
			'\q[◇道具,item1]\n/
			\q[◇逃跑,escape]'
		}
	}
	--
	battleinfo
}
Select.smoke{
	if towashell==0{
		if smoke==NULL{
			smoke=1
			'鬥和正在抽煙，尼古丁含量上升中。\x'
		}
		elseif smoke==1{
			smoke=2
			"鬥和正在抽煙，尼古丁含量50%。\x"
		}
		elseif smoke==2{
			towashell=1
			smoke=NULL
			"鬥和正在抽煙，尼古丁含量100%。鬥和轉變形態,當前為動物形態。\x"
		}
	}
	elseif towashell==1{
		if smoke==NULL{
			smoke=1
			'鬥和正在抽煙，尼古丁含量上升中。\x'
		}
		elseif smoke==1{
			smoke=2
			"鬥和正在抽煙，尼古丁含量50%。\x"
		}
		elseif smoke==2{
			towashell=2
			smoke=NULL
			"鬥和正在抽煙，尼古丁含量100%。鬥和轉變形態，當前為半獸形態。\x"
		}
	}
	elseif towashell==2{
		if smoke==NULL{
			smoke=1
			'鬥和正在抽煙，尼古丁含量上升中。\x'
		}
		elseif smoke==1{
			smoke=2
			"鬥和正在抽煙，尼古丁含量50%。\x"
		}
		elseif smoke==2{
			towashell=0
			smoke=NULL
			"鬥和正在抽煙，尼古丁含量100%。鬥和轉變形態，當前為人形態\x"
		}
	}
	--
	if battlemode==1{
		怪物反擊
	}
	elseif battlemode==2{
		On休息
	}
}
Select.attack0{
	m=RAND(100)
	if m>=10{
		傷害 = TOINT(ANG*3.9*str0-2.82*mdef)
		if 傷害<0
			傷害=0
		if mdefend==1{
			傷害=0
			mdefend=0
		}
		mhp-=傷害
		"\0\s[32]橘花命中目標，%(怪物名字)損血%(傷害)\x"
	}
	else{
		傷害 = TOINT(1.5*ANG*(3.9*str0-2.82*mdef))
		if 傷害<0
			傷害=0
		if mdefend==1{
			傷害=0
			mdefend=0
		}
		mhp-=傷害
		"\0\s[32]橘花對目標發動會心一擊，%(怪物名字)損血%(傷害)\x"
	}
	--
	if 傷害>=TOINT(0.33*mhpmax){
		cp0+=3
	}
	else{
		cp0+=10
	}
	--
	if hp1>0{
		Onbattleselect
	}
	else{
		怪物反擊
	}
	--
	battleinfo
}
Select.attack1{
	m=RAND(100)
	if m>=10{
		傷害 = TOINT(3.9*ANG*str1-2.82*mdef)
		if 傷害<0
			傷害=0
		if mdefend==1{
			傷害=0
			mdefend=0
		}
		mhp-=傷害
		"\0\s[26]鬥和命中目標，%(怪物名字)損血%(傷害)\x"
	}
	else{
		傷害 = TOINT(1.5*ANG*(3.9*str1-2.82*mdef))
		if 傷害<0
			傷害=0
		if mdefend==1{
			傷害=0
			mdefend=0
		}
		mhp-=傷害
		"\0\s[26]鬥和對目標發動會心一擊，%(怪物名字)損血%(傷害)\x"
	}
	--
	if 傷害>=TOINT(0.33*mhpmax){
		cp1+=3
	}
	else{
		cp1+=10
	}
	--
	怪物反擊
	--
	battleinfo
}
Onmagic{
	magicinfo
	if reference1=='targetmode'
		target=reference0
	_txt='\![quicksession,true]\b[2]'
	_txt+=Magicmenu(target)
	if target==0
		_txt+='\n\q[◇返回,Onbattleselect0]'
	elseif target==1
		_txt+='\n\q[◇返回,Onbattleselect1]'
	_txt
	--
	battleinfo
}
Select.spattack0{
	_txt='\![quicksession,true]\b[2]\n'
	_txt+='\_l[0,-]戰技名稱     \_l[90,-]屬性    \_l[130,-]範圍     \_l[170,-]消耗CP     \_l[210,-]效果\n'
	foreach 戰技0; _i{
		if lvl0>=TOINT(_i[4]){
			_txt += "\_l[0,-]%(_i[1])     \_l[90,-]%(_i[2])   \_l[130,-]%(_i[3])   \_l[170,-]%(_i[5])  \_l[210,-]%(_i[6]) \_l[260,-]\q[◇使用,Onusesp0,%(_i[1]),%(_i[2]),%(_i[3]),%(_i[4]),%(_i[5]),%(_i[6]),%(_i[7])]\n"
		}
	}
	_txt+='\n[500]\q[◇返回,Onbattleselect0]'
	_txt
	--
	battleinfo
}
Select.spattack1{
	_txt='\![quicksession,true]\b[2]\n'
	_txt+='\_l[0,-]戰技名稱     \_l[90,-]屬性    \_l[130,-]範圍     \_l[170,-]消耗CP     \_l[210,-]效果\n'
	foreach 戰技1; _i {
		if lvl0>=TOINT(_i[4]){
			_txt += "\_l[0,-]%(_i[1])     \_l[90,-]%(_i[2])   \_l[130,-]%(_i[3])   \_l[170,-]%(_i[5])  \_l[210,-]%(_i[6]) \_l[260,-]\q[◇使用,Onusesp1,%(_i[1]),%(_i[2]),%(_i[3]),%(_i[4]),%(_i[5]),%(_i[6]),%(_i[7])]\n"
		}
	}
	_txt+='\n[500]\q[◇返回,Onbattleselect1]'
	_txt
	--
	battleinfo
}
Onusesp0{
	戰技名稱=reference0
	屬性=reference1
	效果數值=reference5
	NUMS=reference6
	CP消耗=TOINT(reference4)
	if cp0>=CP消耗{
		if 屬性=='輔助'{
			cp0-=CP消耗
			STRADD=1.5
			助威回合=3
			"橘花發動了%(戰技名稱)，橘花STR上升50%，鬥和STR上升50%。\x"
		}
		elseif 屬性=='回復'{
			效果數值=TOINT(效果數值)
			if hp1>0{
				if hp0+效果數值>=hpmax0 &&  hp1+效果數值>=hpmax1 && cp1>=CP消耗{
					"橘花發動了%(戰技名稱)，橘花HP回復%(hpmax0-hp0)，鬥和HP回復%(hpmax1-hp1)\x"
					hp0=hpmax0
					hp1=hpmax1
					cp0-=CP消耗
				}
				elseif hp0+效果數值<hpmax0 && hp1+效果數值<hpmax1 && cp1>=CP消耗{
					"橘花發動了%(戰技名稱)，橘花HP回復%(效果數值)，鬥和HP回復%(效果數值)\x"
					hp0+=效果數值
					hp1+=效果數值
					cp0-=CP消耗
				}
				elseif hp0+效果數值>=hpmax0 &&  hp1+效果數值<hpmax1 && cp1>=CP消耗{
					"橘花發動了%(戰技名稱)，橘花HP回復%(hpmax0-hp0)，鬥和HP回復%(效果數值)\x"
					hp0=hpmax0
					hp1+=效果數值
					cp0-=CP消耗
				}
				elseif hp0+效果數值<hpmax0 &&  hp1+效果數值>=hpmax1 && cp1>=CP消耗{
					"橘花發動了%(戰技名稱)，橘花HP回復%(效果數值)，鬥和HP回復%(hpmax1-hp1)\x"
					hp0+=效果數值
					hp1=hpmax1
					cp0-=CP消耗
				}
			}
			else{
				if hp0+效果數值>=hpmax0 && cp1>=CP消耗{
					"橘花發動了%(戰技名稱)，HP回復%(hpmax0-hp0)\x"
					hp0=hpmax0
					cp0-=CP消耗
				}
				elseif hp0+效果數值<hpmax0 && cp1>=CP消耗{
					"橘花發動了%(戰技名稱)，HP回復%(效果數值)\x"
					hp0+=效果數值
					cp0-=CP消耗
				}
			}
		}
		elseif 屬性=='攻擊'{
			if 效果數值=='驅動解除'{
				戰技傷害=TOINT(ANG*NUMS*(3.9*str0-2.82*mdef))
				if 戰技傷害<0{
					戰技傷害=0
				}
				if mdefend==1{
					戰技傷害=0
					mdefend=0
				}
				mhp-=戰技傷害
				cp0-=CP消耗
				if mmagicready!=-1{
					mmagicready=-1
					"橘花對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害),%(怪物名字)驅動的魔法解除\x"
				}
				else{
					"橘花對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害)\x"
				}
				--
				if 戰技傷害>=(1/3)*mhpmax{
					cp0+=3
				}
				else{
					cp0+=10
				}
			}
			else{
				戰技傷害=TOINT(ANG*NUMS*(3.9*str0-2.82*mdef+效果數值))
				if 戰技傷害<0{
					戰技傷害=0
				}
				if mdefend==1{
					戰技傷害=0
					mdefend=0
				}
				mhp-=戰技傷害
				cp0-=CP消耗
				"橘花對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害)\x"
				--
				if 戰技傷害>=(1/3)*mhpmax{
					cp0+=3
				}
				else{
					cp0+=10
				}
			}
		}
		elseif 屬性=='攻擊S'{
			if cp0>=100 && cp0<200{
				戰技傷害=TOINT(ANG*NUMS*(3.9*str0-2.82*mdef+效果數值))
				if 戰技傷害<0{
					戰技傷害=0
				}
				if mdefend==1{
					戰技傷害=0
					mdefend=0
				}
				mhp-=戰技傷害
				cp0-=CP消耗
				"橘花對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害)\x"
				--
				if 戰技傷害>=(1/3)*mhpmax{
					cp0+=3
				}
				else{
					cp0+=10
				}
			}
			elseif cp0==200{
				if 戰技名稱=='奧義・天下無雙'{
					戰技傷害=TOINT(ANG*3*NUMS*(3.9*str0-2.82*mdef+1.5*效果數值))
				}
				else{
					戰技傷害=TOINT(ANG*2*NUMS*(3.9*str0-2.82*mdef+1.5*效果數值))
				}
				if 戰技傷害<0{
					戰技傷害=0
				}
				if mdefend==1{
					戰技傷害=0
					mdefend=0
				}
				mhp-=戰技傷害
				cp0-=200
				"橘花對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害)\x"
				--
				if 戰技傷害>=(1/3)*mhpmax{
					cp0+=3
				}
				else{
					cp0+=10
				}
			}
		}
		--
		RpgGameVar
		--
		if hp1>0{
			Onbattleselect
		}
		else{
			怪物反擊
		}
	}
	else{
		'CP不足，不能發動戰技\x'
		--
		Onbattleselect0
	}
}
Onusesp1{
	戰技名稱=reference0
	屬性=reference1
	效果數值=reference5
	NUMS=reference6
	CP消耗=TOINT(reference4)
	if cp1>=CP消耗{
		if 屬性=='攻擊'{
			戰技傷害=TOINT(ANG*NUMS*(3.9*str1-2.82*mdef+效果數值))
			if 戰技傷害<0{
				戰技傷害=0
			}
			if mdefend==1{
				戰技傷害=0
				mdefend=0
			}
			mhp-=戰技傷害
			cp1-=CP消耗
			"鬥和對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害)\x"
			--
			if 戰技傷害>=(1/3)*mhpmax{
				cp1+=3
			}
			else{
				cp1+=10
			}
		}
		elseif 屬性=='攻擊S'{
			if cp1>=100 && cp1<200{
				戰技傷害=TOINT(ANG*NUMS*(3.9*str1-2.82*mdef+效果數值))
				if 戰技傷害<0{
					戰技傷害=0
				}
				if mdefend==1{
					戰技傷害=0
					mdefend=0
				}
				mhp-=戰技傷害
				cp1-=CP消耗
				"鬥和對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害)\x"
				--
				if 戰技傷害>=(1/3)*mhpmax{
					cp1+=3
				}
				else{
					cp1+=10
				}
			}
			elseif cp1==200{
				if 戰技名稱=='奧義・量子風暴'{
					戰技傷害=TOINT(ANG*3*NUMS*(3.9*str1-2.82*mdef+1.5*效果數值))
				}
				else{
					戰技傷害=TOINT(ANG*2*NUMS*(3.9*str1-2.82*mdef+1.5*效果數值))
				}
				if 戰技傷害<0{
					戰技傷害=0
				}
				if mdefend==1{
					戰技傷害=0
					mdefend=0
				}
				mhp-=戰技傷害
				cp1-=200
				"鬥和對%(怪物名字)使用了%(戰技名稱)，%(怪物名字)損血%(戰技傷害)\x"
				--
				if 戰技傷害>=(1/3)*mhpmax{
					cp1+=3
				}
				else{
					cp1+=10
				}
			}
		}
		--
		RpgGameVar
		--
		怪物反擊
	}
	else{
		'CP不足，不能發動戰技\x'
		--
		Onbattleselect1
	}
}
Select.beastsp{
	"\b[2]\![set,choicetimeout,0]\![quicksession,true]\__q[Onusebeastsp,0,25]貓爪三連擊：攻擊三次，消耗CP25\__q\n/
	\__q[Onusebeastsp,1,30]嚎叫：我方物理防禦提升50%，有效三回合，消耗CP30\__q\n/
	\__q[Onusebeastsp,2,20]示威：下一次攻擊時，無視對方防禦力，消耗CP20\__q\n/
	\__q[Onusebeastsp,3,30]黑暗詛咒：對方物理防禦減50%，有效三回合，消耗CP30\__q\n/
	\__q[Onusebeastsp,4,20]噬血詛咒：攻擊時給予對方的傷害翻倍，有效一回合，消耗CP20\__q\n/
	\__q[Onusebeastsp,5,100]犧牲：用自身HP的50%換取敵方HP的50%，消耗CP100\__q\n/
	\__q[Onusebeastsp,6,50]偷取：偷取對方20%的HP。消耗CP50\n/
	\n[400]\q[◇返回,Onbattleselect1]\n/
	"
}
Onusebeastsp{
	獸技ID=reference0
	消耗SP=TOINT(reference1)
	if cp1>=消耗SP{
		if 獸技ID==0{
			獸技傷害=TOINT(ANG*3*(3.9*str1-2.82*mdef))
			if 獸技傷害<0{
				獸技傷害=0
			}
			if mdefend==1{
				獸技傷害=0
				mdefend=0
			}
			mhp-=獸技傷害
			"鬥和對%(怪物名字)使用了貓爪三連擊，%(怪物名字)損血%(獸技傷害)\x"
		}
		elseif 獸技ID==1{
			DEFADD=1.5
			嚎叫回合=3
			"鬥和使用了嚎叫，DEF提升50%。\x"
		}
		elseif 獸技ID==2{
			IGN=0
			示威回合=1
			"鬥和使用了示威，%(怪物名字)DEF被無視了。\x"
		}
		elseif 獸技ID==3{
			MDEFMINUS=0.5
			黑暗詛咒回合=3
			"鬥和使用了黑暗詛咒，%(怪物名字)DEF降低50%。\x"
		}
		elseif 獸技ID==4{
			ANG=2
			噬血詛咒回合=1
			'鬥和使用了噬血詛咒\x'
		}
		elseif 獸技ID==5{
			hp1=TOINT(0.5*hp1)
			mhp=TOINT(0.5*mhp)
			"鬥和使用了犧牲，鬥和HP減少%(TOINT(0.5*hp1)),%(怪物名字)HP減少%(TOINT(0.5*mhp))\x"
		}
		elseif 獸技ID==6{
			if hp1+0.2*mhp>=hpmax1{
				"鬥和使用了偷取，鬥和HP增加%(TOINT(hpmax1-hp1)),%(怪物名字)HP減少%(TOINT(0.2*mhp))\x"
				--
				hp1=hpmax1
			}
			else{
				hp1+=0.2*mhp
				"鬥和使用了偷取，鬥和HP增加%(TOINT(0.2*mhp)),%(怪物名字)HP減少%(TOINT(0.2*mhp))\x"
			}
			--
			mhp=TOINT(0.8*mhp)
		}
		--
		cp1-=消耗SP
		RpgGameVar
		--
		if class=='D'{
			mdef=mdefD
		}
		elseif class=='C'{
			mdef=mdefC
		}
		elseif class=='B'{
			mdef=mdefB
		}
		elseif class=='A'{
			mdef=mdefA
		}
		elseif class=='S'{
			mdef=mdefS
		}
		--
		怪物反擊
	}
	else{
		'CP不足\x'
		--
		Onbattleselect1
	}
}
戰技回合判定{
	if 助威回合>0{
		助威回合--
	}
	elseif 助威回合==0{
		助威回合=-1
		--
		STRADD=1
		'橘花使用的助威技能失效了\x'
	}
	--
	if 嚎叫回合>0{
		嚎叫回合--
	}
	elseif 嚎叫回合==0{
		嚎叫回合=-1
		--
		DEFADD=1
		'鬥和使用的嚎叫技能失效了\x'
	}
	--
	if 示威回合>0{
		示威回合--
	}
	elseif 示威回合==0{
		示威回合=-1
		--
		IGN=1
		'鬥和使用的示威技能失效了\x'
	}
	--
	if 黑暗詛咒回合>0{
		黑暗詛咒回合--
	}
	elseif 黑暗詛咒回合==0{
		黑暗詛咒回合=-1
		--
		MDEFMINUS=1
		'鬥和使用的黑暗詛咒技能失效了\x'
	}
	--
	if 噬血詛咒回合>0{
		噬血詛咒回合--
	}
	elseif 噬血詛咒回合==0{
		噬血詛咒回合=-1
		--
		ANG=1
		'鬥和使用的噬血詛咒技能失效了\x'
	}
	--
	RpgGameVar
}
Select.item0{
	資訊參數
	_txt='\![quicksession,true]\b[2]\n'
	_txt+='\_l[0,-]名稱    \_l[80,-]效果   \_l[155,-]買入價格 \_l[210,-]已有數量  \n'
	foreach itemA; _i {
		if _i[3]>0{
			_txt += "\f[color,194,243,99]\_l[0,-]%(_i[2]) \_l[80,-]%(_i[5])\f[color,default]  \f[color,231,171,109]\_l[155,-]%(_i[4])\f[color,default]   \_l[210,-]%(_i[3]) \_l[260,-] \q[◇使用,Onuseitemselect0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[5])]\n"
		}
	}
	foreach itemB; _i{
		if _i[3]>0{
			_txt += "\f[color,165,203,214]\_l[0,-]%(_i[2]) \_l[80,-]%(_i[5])\f[color,default]  \f[color,231,171,109]\_l[155,-]%(_i[4])\f[color,default]   \_l[210,-]%(_i[3]) \_l[260,-] \q[◇使用,Onuseitemselect0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[5])]\n"
		}
	}
	_txt+='\n[400]\q[◇返回,Onbattleselect0]'
	_txt
	--
	battleinfo
}
Select.item1{
