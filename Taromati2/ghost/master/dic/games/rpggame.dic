Onmagicatk0{
	魔法種類=_argv[0]
	魔法名稱0=_argv[1]
	效果數值=TOINT(_argv[6])
	NUMS=_argv[7]
	EP消耗=TOINT(_argv[5])
	if ep0>=EP消耗{
		if 魔法種類=='水系魔法'{
			魔法傷害=TOINT(ANG*NUMS*水有效率*(4.10*ats0-2.80*madf+效果數值))
		}
		elseif 魔法種類=='火系魔法'{
			魔法傷害=TOINT(ANG*NUMS*火有效率*(4.10*ats0-2.80*madf+效果數值))
		}
		elseif 魔法種類=='土系魔法'{
			魔法傷害=TOINT(ANG*NUMS*土有效率*(4.10*ats0-2.80*madf+效果數值))
		}
		elseif 魔法種類=='風系魔法'{
			魔法傷害=TOINT(ANG*NUMS*風有效率*(4.10*ats0-2.80*madf+效果數值))
		}
		if 魔法傷害<0{
			魔法傷害=0
		}
		if mdefend==1{
			魔法傷害=0
			mdefend=0
		}
		magicready0=1
		魔法傷害0=魔法傷害
		'橘花正在準備魔法\x'
		--
		if hp1>0{
			Onbattleselect
		}
		else{
			怪物反擊
		}
	}
	else{
		'EP不足，不能驅動魔法\x'
		--
		Onbattleselect0
	}
}
