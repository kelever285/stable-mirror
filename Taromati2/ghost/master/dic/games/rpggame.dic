道具{
	battlemode=0
	On道具列表
}
On道具列表{
	資訊參數
	_txt='\b[2]\![quicksession,true]\n'
	_txt+='\_l[0,-]名稱    \_l[80,-]效果   \_l[160,-]買入價格 \_l[215,-]已有數量  \n'
	foreach itemA; _i {
		if _i[3]>0{
			_txt += "\f[color,194,243,99]\_l[0,-]%(_i[2])\f[color,default]    \f[color,194,243,99]\_l[80,-]%(_i[5])\f[color,default]     \f[color,231,171,109]\_l[160,-]%(_i[4])\f[color,default]   \_l[215,-]%(_i[3]) \_l[260,-] \q[◇使用,Onuseitemselect,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[5])]\n"
		}
	}
	foreach itemB; _i {
		if _i[3]>0{
			_txt += "\f[color,165,203,214]\_l[0,-]%(_i[2])\f[color,default]    \f[color,165,203,214]\_l[80,-]%(_i[5])\f[color,default]    \f[color,231,171,109]\_l[160,-]%(_i[4])\f[color,default]  \_l[215,-]%(_i[3]) \_l[260,-] \q[◇使用,Onuseitemselect,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[5])]\n"
		}
	}
	if battlemode==2{
		_txt+='\_l[-,300]\q[◇返回,On休息]'
	}
	_txt+=battleinfo
	_txt
}
Onuseitemselect{
	"給誰使用\n/
	\q[◇橘花,Onuseitem0,%(reference0),%(reference1),%(reference2),%(reference3)]\n/
	\q[◇鬥和,Onuseitem1,%(reference0),%(reference1),%(reference2),%(reference3)]\n/
	\n[half]\q[◇返回,OnRpgGame,3]"
}
Onuseitemselect0{
	"給誰使用\n/
	\q[◇橘花,Onkikkauseitem0,%(reference0),%(reference1),%(reference2),%(reference3)]\n/
	\q[◇鬥和,Onkikkauseitem1,%(reference0),%(reference1),%(reference2),%(reference3)]\n/
	\n[half]\q[◇返回,item0]"
}
Onuseitemselect1{
	"給誰使用\n/
	\q[◇橘花,Ontowauseitem0,%(reference0),%(reference1),%(reference2),%(reference3)]\n/
	\q[◇鬥和,Ontowauseitem1,%(reference0),%(reference1),%(reference2),%(reference3)]\n/
	\n[half]\q[◇返回,item1]"
}
Onuseitem0{
	道具類型=reference0
	道具代碼=reference1
	道具名稱=reference2
	效果數值=TOINT(reference3)
	if 道具類型=='itemA'{
		if reference3=='HP全回復'||reference3=='戰鬥不能解除'{
			"對橘花使用了%(道具名稱),HP回復%(hpmax0-hp0)\x"
			hp0=hpmax0
			itemAnum[道具代碼]-=1
		}
		elseif '經驗丹' _in_ 道具名稱{
			"當前橘花經驗為%(exp0)\n"
			--
			exp0+=效果數值
			exptotal0+=效果數值
			itemAnum[道具代碼]-=1
			"對橘花使用了%(道具名稱),橘花經驗增加%(效果數值)，橘花經驗為%(exp0)\n"
			--
			橘花升級+'\x'
		}
		elseif '轉生丹' _in_ 道具名稱{
			"當前橘花轉生修為為%(expcircle0)\n"
			--
			expcircle0+=效果數值
			itemAnum[道具代碼]-=1
			"對橘花使用了%(道具名稱),橘花轉生修為增加%(效果數值)，橘花轉生修為為%(expcircle0)\x"
		}
		elseif hp0+效果數值>=hpmax0{
			"對橘花使用了%(道具名稱),HP回復%(hpmax0-hp0)\x"
			hp0=hpmax0
			itemAnum[道具代碼]-=1
		}
		elseif hp0+效果數值<hpmax0{
			hp0+=效果數值
			"對橘花使用了%(道具名稱),HP回復%(效果數值)\x"
			itemAnum[道具代碼]-=1
		}
	}
	elseif 道具類型=='itemB'{
		if reference3=='EP全回復'{
			"對橘花使用了%(道具名稱),EP回復%(epmax0-ep0)\x"
			ep0=epmax0
			itemBnum[道具代碼]-=1
		}
		elseif ep0+效果數值>=epmax0{
			"對橘花使用了%(道具名稱),EP回復%(epmax0-ep0)\x"
			ep0=epmax0
			itemBnum[道具代碼]-=1
		}
		elseif ep0+效果數值<epmax0{
			ep0+=效果數值
			"對橘花使用了%(道具名稱),EP回復%(效果數值)\x"
			itemBnum[道具代碼]-=1
		}
	}
	--
	if battlemode==0{
		OpenRpgGameMenu(3)
	}
	elseif battlemode==2{
		On休息
	}
}
