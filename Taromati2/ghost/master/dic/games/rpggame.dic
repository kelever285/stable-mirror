準備魔法0{
	magicready0=0
	mhp-=魔法傷害0
	ep0-=EP消耗
	"橘花對%(怪物名字)使用了%(魔法名稱0)，%(怪物名字)損血%(魔法傷害0)\x"
	--
	if 魔法傷害1>=TOINT(0.33*mhpmax){
		cp0+=3
	}
	else{
		cp0+=10
	}
	--
	if hp1>0{
		Onbattleselect
	}
	else{
		怪物反擊
	}
}
準備魔法1{
