Onitembuy{
	if reference0<=0{
		'\0\s[40]請輸入大於0的數位\![open,inputbox,Onsell]'
	}
	else{
		購買數量=reference0
		if reference5==NULL && reference6==NULL{
			"確定以%(道具價格)的單價購買%(購買數量)件%(道具名稱)？\n/
			\q[◇是,Onitembuy,%(購買數量),%(道具種類),%(道具代碼),%(道具名稱),%(道具價格),＆,1]\n/
