On魔法列表{
	'\b[2]\![quicksession,true]'
	--
	magicinfo
	if magicMenu == 0{
		target=0
		'\n' + ColorText('\__q[OnmagicMenu,1]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]───────────橘花↓─────────\f[cursorstyle,default]\f[cursorfontcolor,default]\f[cursorfontcolor,default]\__q','color=160,160,200') + '\n'
		--
		Magicmenu(0)
	}
	elseif magicMenu == 1 {
		target=1
		'\n' + ColorText('\__q[OnmagicMenu,0]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]───────────鬥和↓─────────\f[cursorstyle,default]\f[cursorfontcolor,default]\__q','color=160,160,200') + '\n'
		--
		Magicmenu(1)
	}
	--
	battleinfo
}
OnmagicMenu{
	magicMenu = reference0
	if battlemode==0{
		OpenRpgGameMenu(2)
	}
	elseif battlemode==2{
		On魔法列表
	}
}
Magicmenu{
	_txt=''
	_txt+='\_l[0,-]魔法名稱     \_l[80,-]屬性    \_l[115,-]範圍     \_l[145,-]消耗EP     \_l[185,-]效果\n'
	//_txt+='\_l[120,-]\f[color,65,203,214]水系魔法\f[color,default]\n'
	_lvl=lvl0
	if target==1
		_lvl=lvl1
	_txt+='\f[color,160,160,200]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]\__q[On魔法菜單,0]──────────水系魔法──────────\__q\f[cursorstyle,default]\f[cursorfontcolor,default]\f[default]\n'
	if TOINT(magicmenu[0])==1{
		foreach 水系魔法; _i {
			if _lvl>=TOINT(_i[5]){
				if _i[3] == '回復'     {
					_txt += "\_l[0,-]\f[color,65,203,214]%(_i[2])      \_l[80,-]%(_i[3])  \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])     \_l[185,-]%(_i[7])\f[color,default]     \_l[260,-]\q[◇使用,Onusemagic,%(_i[0]),%(_i[2]),%(_i[3]),%(_i[4]),%(_i[5]),%(_i[6]),%(_i[7])]\n"
				}
				elseif _i[3] == '攻擊'  {
					if battlemode==1
						_txt += "\_l[0,-]\f[color,65,203,214]%(_i[2])      \_l[80,-]%(_i[3])  \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])     \_l[185,-]%(_i[7])\f[color,default]     \_l[260,-]\q[◇使用,Onusemagic,%(_i[0]),%(_i[2]),%(_i[3]),%(_i[4]),%(_i[5]),%(_i[6]),%(_i[7]),%(_i[8])]\n"
					else
						_txt += "\_l[0,-]\f[color,65,203,214]%(_i[2])      \_l[80,-]%(_i[3])   \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])   \_l[185,-]%(_i[7])\f[color,default]\n"
				}
			}
		}
	}
	//_txt+='\_l[120,-]\f[color,255,0,0]火系魔法\f[color,default]\n'
	_txt+='\f[color,160,160,200]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]\__q[On魔法菜單,1]──────────火系魔法──────────\__q\f[cursorstyle,default]\f[cursorfontcolor,default]\f[default]\n'
	if TOINT(magicmenu[1])==1{
		foreach 火系魔法; _i {
			if _lvl>=TOINT(_i[5]){
				if battlemode==1
					_txt += "\_l[0,-]\f[color,255,0,0]%(_i[2])      \_l[80,-]%(_i[3])  \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])     \_l[185,-]%(_i[7])\f[color,default]     \_l[260,-]\q[◇使用,Onusemagic,%(_i[0]),%(_i[2]),%(_i[3]),%(_i[4]),%(_i[5]),%(_i[6]),%(_i[7]),%(_i[8])]\n"
				else
					_txt += "\_l[0,-]\f[color,255,0,0]%(_i[2])     \_l[80,-]%(_i[3])    \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])  \_l[185,-]%(_i[7])\f[color,default] \n"
			}
		}
	}
	//_txt+='\_l[120,-]\f[color,231,171,109]土系魔法\f[color,default]\n'
	_txt+='\f[color,160,160,200]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]\__q[On魔法菜單,2]──────────土系魔法──────────\__q\f[cursorstyle,default]\f[cursorfontcolor,default]\f[default]\n'
	if TOINT(magicmenu[2])==1{
		foreach 土系魔法; _i {
			if _lvl>=TOINT(_i[5]){
				if battlemode==1
					_txt += "\_l[0,-]\f[color,231,171,109]%(_i[2])      \_l[80,-]%(_i[3])  \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])     \_l[185,-]%(_i[7])\f[color,default]     \_l[260,-]\q[◇使用,Onusemagic,%(_i[0]),%(_i[2]),%(_i[3]),%(_i[4]),%(_i[5]),%(_i[6]),%(_i[7]),%(_i[8])]\n"
				else
					_txt += "\_l[0,-]\f[color,231,171,109]%(_i[2])      \_l[80,-]%(_i[3])   \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])  \_l[185,-]%(_i[7])\f[color,default] \n"
			}
		}
	}
	//_txt+='\_l[120,-]\f[color,194,243,99]風系魔法\f[color,default]\n'
	_txt+='\f[color,160,160,200]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]\__q[On魔法菜單,3]──────────風系魔法──────────\__q\f[cursorstyle,default]\f[cursorfontcolor,default]\f[default]\n'
	if TOINT(magicmenu[3])==1{
		foreach 風系魔法; _i {
			if _lvl>=TOINT(_i[5]){
				if battlemode==1
					_txt += "\_l[0,-]\f[color,194,243,99]%(_i[2])      \_l[80,-]%(_i[3])  \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])     \_l[185,-]%(_i[7])\f[color,default]     \_l[260,-]\q[◇使用,Onusemagic,%(_i[0]),%(_i[2]),%(_i[3]),%(_i[4]),%(_i[5]),%(_i[6]),%(_i[7]),%(_i[8])]\n"
				else
					_txt += "\_l[0,-]\f[color,194,243,99]%(_i[2])      \_l[80,-]%(_i[3])    \_l[115,-]%(_i[4])   \_l[145,-]%(_i[6])  \_l[185,-]%(_i[7])\f[color,default] \n"
			}
		}
	}
	if battlemode==2{
		_txt+='\n\q[◇返回,On休息]'
	}
	_txt
}
On魔法菜單{
	magicmenu[reference0]=(TOINT(magicmenu[reference0])+1)%2
	if battlemode==0||battlemode==2{
		OpenRpgGameMenu(2)
	}
	else
		Onmagic(target)
}
Onusemagic{
	if (reference2=='回復'||reference2=='輔助') && reference3=='單體'{
		if !target
			"給誰使用\n/
			\q[◇橘花,Onkikka0,%(reference0),%(reference1),%(reference2),%(reference3),%(reference4),%(reference5),%(reference6)]\n/
			\q[◇鬥和,Ontowa0,%(reference0),%(reference1),%(reference2),%(reference3),%(reference4),%(reference5),%(reference6)]\n/
			\n[400]\q[◇返回,Onbackusemagic0]"
		else
			"給誰使用\n/
			\q[◇橘花,Onkikka1,%(reference0),%(reference1),%(reference2),%(reference3),%(reference4),%(reference5),%(reference6)]\n/
			\q[◇鬥和,Ontowa1,%(reference0),%(reference1),%(reference2),%(reference3),%(reference4),%(reference5),%(reference6)]\n/
			\n[400]\q[◇返回,Onbackusemagic1]"
	}
	elseif (reference2=='回復'||reference2=='輔助') && reference3=='複體'{
		if !target
			Ondouble0(reference0,reference1,reference2,reference3,reference4,reference5,reference6)
		else
			Ondouble1(reference0,reference1,reference2,reference3,reference4,reference5,reference6)
	}
	elseif reference2=='攻擊'{
		if !target
			Onmagicatk0(reference0,reference1,reference2,reference3,reference4,reference5,reference6,reference7)
		else
			Onmagicatk1(reference0,reference1,reference2,reference3,reference4,reference5,reference6,reference7)
	}
}
Onbackusemagic0{
	if battlemode==0{
		OpenRpgGameMenu(2)
	}
	elseif battlemode==2{
		On休息
	}
	else{
		Onbattleselect0
	}
}
Onbackusemagic1{
	if battlemode==0{
		OpenRpgGameMenu(2)
	}
	elseif battlemode==2{
		On休息
	}
	else{
		Onbattleselect1
	}
}
KikkaUsedMagic{
	if battlemode==0{
		OpenRpgGameMenu(2)
	}
	elseif battlemode==2{
		On休息
	}
	else{
		if hp1>0{
			Onbattleselect
		}
		else{
			怪物反擊
		}
	}
}
KikkaUsedFall{
	if battlemode==0{
		OpenRpgGameMenu(2)
	}
	elseif battlemode==2{
		On休息
	}
	else{
		Onbattleselect0
	}
}
TowaUsedMagic{
	if battlemode==0{
		OpenRpgGameMenu(2)
	}
	elseif battlemode==2{
		On休息
	}
	else{
		怪物反擊
	}
}
TowaUsedFall{
	if battlemode==0{
		OpenRpgGameMenu(2)
	}
	elseif battlemode==2{
		On休息
	}
	else{
		Onbattleselect1
	}
}
Onkikka0{
	魔法名稱=reference1
	效果數值=TOINT(reference6)
	EP消耗=TOINT(reference5)
	if reference6=='HP全回復' && ep0>=EP消耗{
		"橘花對自己使用了%(魔法名稱)，橘花HP回復%(hpmax0-hp0)\x"
		hp0=hpmax0
		ep0-=EP消耗
		--
		KikkaUsedMagic
	}
	elseif reference6=='戰鬥不能解除' && ep0>=EP消耗{
		"不能這樣使用%(魔法名稱)\x"
		--
		KikkaUsedFall
	}
	elseif reference6=='完全防禦一次' && ep0>=EP消耗{
		kikkadefend=1
		ep0-=EP消耗
		"橘花對自己使用了%(魔法名稱)\x"
		--
		KikkaUsedMagic
	}
	elseif ep0>=EP消耗{
		_hp=hp0
		hp0+=效果數值
		if hp0>hpmax0
			hp0=hpmax0
		ep0-=EP消耗
		"橘花對自己使用了%(魔法名稱)，橘花HP回復%(hp0-_hp)\x"
		--
		KikkaUsedMagic
	}
	else{
		'EP不足，不能驅動魔法\x'
		--
		KikkaUsedFall
	}
}
Onkikka1{
	魔法名稱=reference1
	效果數值=TOINT(reference6)
	EP消耗=TOINT(reference5)
	if hp0>0{
		if reference6=='HP全回復' && ep1>=EP消耗{
			"鬥和對橘花使用了%(魔法名稱)，橘花HP回復%(hpmax0-hp0)\x"
			hp0=hpmax0
			ep1-=EP消耗
			--
			TowaUsedMagic
		}
		elseif reference6=='戰鬥不能解除' && ep1>=EP消耗{
			"不能這樣使用%(魔法名稱)\x"
			--
			TowaUsedFall
		}
		elseif reference6=='完全防禦一次' && ep1>=EP消耗{
			kikkadefend=1
			"鬥和對橘花使用了%(魔法名稱)\x"
			ep1-=EP消耗
			--
			TowaUsedMagic
		}
		elseif ep1>=EP消耗{
			_hp=hp0
			hp0+=效果數值
			if hp0>hpmax0
				hp0=hpmax0
			ep1-=EP消耗
			"鬥和對橘花使用了%(魔法名稱)，橘花HP回復%(hp0-_hp)\x"
			--
			TowaUsedMagic
		}
		else{
			'EP不足，不能驅動魔法\x'
			--
			TowaUsedFall
		}
	}
	elseif hp0==0 && reference6=='戰鬥不能解除' && ep1>=EP消耗{
		"鬥和對橘花使用了%(魔法名稱)，橘花恢復戰鬥能力，橘花HP回復%(hpmax0-hp0)\x"
		hp0=hpmax0
		ep1-=EP消耗
		--
		怪物反擊
	}
	elseif ep1<EP消耗{
		'EP不足，不能驅動魔法\x'
		--
		TowaUsedFall
	}
	else{
		"不能對失去戰鬥能力的橘花使用%(魔法名稱)\x"
		--
		TowaUsedFall
	}
}
Ontowa0{
	魔法名稱=reference1
	效果數值=TOINT(reference6)
	EP消耗=TOINT(reference5)
	if hp1>0{
		if reference6=='HP全回復' && ep0>=EP消耗{
			"橘花對鬥和使用了%(魔法名稱)，鬥和HP回復%(hpmax1-hp1)\x"
			hp1=hpmax1
			ep0-=EP消耗
			--
			KikkaUsedMagic
		}
		elseif reference6=='戰鬥不能解除' && ep0>=EP消耗{
			"不能這樣使用%(魔法名稱)\x"
			--
			KikkaUsedFall
		}
		elseif reference6=='完全防禦一次' && ep0>=EP消耗{
			towadefend=1
			ep0-=EP消耗
			"橘花對鬥和使用了%(魔法名稱)\x"
			--
			KikkaUsedMagic
		}
		elseif ep0>=EP消耗{
			_hp=hp1
			hp1+=效果數值
			if hp1>hpmax1
				hp1=hpmax1
			ep0-=EP消耗
			"橘花對鬥和使用了%(魔法名稱)，鬥和HP回復%(hp1-_hp)\x"
			--
			KikkaUsedMagic
		}
		else{
			'EP不足，不能驅動魔法\x'
			--
			KikkaUsedFall
		}
	}
	elseif hp1==0 && reference6=='戰鬥不能解除' && ep0>=EP消耗{
		"橘花對鬥和使用了%(魔法名稱)，鬥和恢復戰鬥能力，鬥和HP回復%(hpmax1-hp1)\x"
		hp1=hpmax1
		ep0-=EP消耗
		--
		KikkaUsedMagic
	}
	elseif ep0<EP消耗{
		'EP不足，不能驅動魔法\x'
		--
		KikkaUsedFall
	}
	else{
		"不能對失去戰鬥能力的鬥和使用%(魔法名稱)\x"
		--
		KikkaUsedFall
	}
}
Ontowa1{
	魔法名稱=reference1
	效果數值=TOINT(reference6)
	EP消耗=TOINT(reference5)
	if reference6=='HP全回復' && ep1>=EP消耗{
		"鬥和對自己使用了%(魔法名稱)，鬥和HP回復%(hpmax1-hp1)\x"
		hp1=hpmax1
		ep1-=EP消耗
		--
		TowaUsedMagic
	}
	elseif reference6=='戰鬥不能解除' && ep1>=EP消耗{
		"不能這樣使用%(魔法名稱)\x"
		--
		TowaUsedFall
	}
	elseif reference6=='完全防禦一次' && ep1>=EP消耗{
		towadefend=1
		ep1-=EP消耗
		"鬥和對自己使用了%(魔法名稱)\x"
		--
		TowaUsedMagic
	}
	elseif ep1>=EP消耗{
		_hp=hp1
		hp1+=效果數值
		if hp1>hpmax1
			hp1=hpmax1
		ep1-=EP消耗
		"鬥和對自己使用了%(魔法名稱)，鬥和HP回復%(hp1-_hp)\x"
		--
		TowaUsedMagic
	}
	else{
		'EP不足，不能驅動魔法\x'
		--
		TowaUsedFall
	}
}
Ondouble0{
	魔法名稱=_argv[1]
	效果數值=TOINT(_argv[6])
	EP消耗=TOINT(_argv[5])
	if hp1>0{
		if _argv[6]=='HP全回復' && ep0>=EP消耗{
			"橘花使用了%(魔法名稱)，橘花HP回復%(hpmax0-hp0)，鬥和HP回復%(hpmax1-hp1)\x"
			hp0=hpmax0
			hp1=hpmax1
			ep0-=EP消耗
			--
			KikkaUsedMagic
		}
		elseif _argv[6]=='完全防禦一次' && ep0>=EP消耗{
			kikkadefend=1
			towadefend=1
			"橘花使用了%(魔法名稱)\x"
			ep0-=EP消耗
			--
			KikkaUsedMagic
		}
		elseif ep0>=EP消耗{
			_hp0=hp0
			_hp1=hp1
			hp0+=效果數值
			hp1+=效果數值
			if hp0>hpmax0
				hp0=hpmax0
			if hp1>hpmax1
				hp1=hpmax1
			ep0-=EP消耗
			"橘花使用了%(魔法名稱)，橘花HP回復%(hp0-_hp0)，鬥和HP回復%(hp1-_hp1)\x"
			--
			KikkaUsedMagic
		}
		else{
			'EP不足，不能驅動魔法\x'
			--
			KikkaUsedFall
		}
	}
	elseif hp1==0{
		if _argv[6]=='HP全回復' && ep0>=EP消耗{
			"橘花使用了%(魔法名稱)，橘花HP回復%(hpmax0-hp0)\x"
			hp0=hpmax0
			ep0-=EP消耗
			--
			KikkaUsedMagic
		}
		elseif ep0>=EP消耗{
			_hp=hp0
			hp0+=效果數值
			if hp0>hpmax0
				hp0=hpmax0
			ep0-=EP消耗
			"橘花使用了%(魔法名稱)，橘花HP回復%(hp0-_hp)\x"
			--
			KikkaUsedMagic
		}
		else{
			'EP不足，不能驅動魔法\x'
			--
			KikkaUsedFall
		}
	}
}
