Hotel{
	'\n\q[◇住宿,Onlodging]\n'
}
Circle{
	_circleinfo0=KikkaCircleInfo(lvl0,circle0)
	_circleinfo1=TowaCircleInfo(lvl1,circle1)
	_newcircleinfo0=KikkaCircleInfo(lvl0,circle0+1)
	_newcircleinfo1=TowaCircleInfo(lvl1,circle1+1)
	_txt= "\n\_l[80]橘花當前轉生等級：%(circle0)\n/
	%(lvl0)級時當前轉生屬性 \_l[160]%(lvl0)級時下階轉生屬性\n/
	物理攻擊：%(TOINT(_circleinfo0[3]))  \_l[160]物理攻擊：%(TOINT(_newcircleinfo0[3]))\n/
	魔法攻擊：%(TOINT(_circleinfo0[5])) \_l[160]魔法攻擊：%(TOINT(_newcircleinfo0[5]))\n/
	物理防禦：%(TOINT(_circleinfo0[4])) \_l[160]物理防禦：%(TOINT(_newcircleinfo0[4]))\n/
	魔法防禦：%(TOINT(_circleinfo0[6])) \_l[160]魔法防禦：%(TOINT(_newcircleinfo0[6]))\n/
	生命上限：%(TOINT(_circleinfo0[2])) \_l[160]生命上限：%(TOINT(_newcircleinfo0[2]))\n/
	\n[half]消耗修為：%(GetExp(20+10*circle0))    \_l[160]擁有修為：%(expcircle0)\n/
	\n\_l[80]鬥和當前轉生等級：%(circle1)\n/
	%(lvl1)級時當前轉生屬性 \_l[180]%(lvl1)級時下階轉生屬性\n/
	物理攻擊：%(TOINT(_circleinfo1[3]))  \_l[160]物理攻擊：%(TOINT(_newcircleinfo1[3]))\n/
	魔法攻擊：%(TOINT(_circleinfo1[5])) \_l[160]魔法攻擊：%(TOINT(_newcircleinfo1[5]))\n/
	物理防禦：%(TOINT(_circleinfo1[4])) \_l[160]物理防禦：%(TOINT(_newcircleinfo1[4]))\n/
	魔法防禦：%(TOINT(_circleinfo1[6])) \_l[160]魔法防禦：%(TOINT(_newcircleinfo1[6]))\n/
	生命上限：%(TOINT(_circleinfo1[2])) \_l[160]生命上限：%(TOINT(_newcircleinfo1[2]))\n/
	\n[half]消耗修為：%(GetExp(20+10*circle1))    \_l[160]擁有修為：%(expcircle1)\n/
	\n\q[◇轉生說明,OnCircleIntro]                  \q[◇轉生,OnCircle]                \q[◇恢復,OnCircleRecover]\n/
	"
	_txt=REPLACE(_txt,'物理攻擊',ColorText('物理攻擊',"color=%(ColorIdx(11))"))
	_txt=REPLACE(_txt,'魔法攻擊',ColorText('魔法攻擊',"color=%(ColorIdx(11))"))
	_txt=REPLACE(_txt,'物理防禦',ColorText('物理防禦',"color=%(ColorIdx(11))"))
	_txt=REPLACE(_txt,'魔法防禦',ColorText('魔法防禦',"color=%(ColorIdx(11))"))
	_txt=REPLACE(_txt,'生命上限',ColorText('生命上限',"color=%(ColorIdx(11))"))
	_txt=REPLACE(_txt,'消耗修為',ColorText('消耗修為',"color=%(ColorIdx(11))"))
	_txt=REPLACE(_txt,'擁有修為',ColorText('擁有修為',"color=%(ColorIdx(11))"))
	_txt=REPLACE(_txt,'當前轉生屬性 ',ColorText('當前轉生屬性',"color=%(ColorIdx(12))"))
	_txt=REPLACE(_txt,'下階轉生屬性',ColorText('下階轉生屬性',"color=%(ColorIdx(12))"))
	_txt=REPLACE(_txt,"%(lvl0)級時",ColorText("%(lvl0)級時","color=%(ColorIdx(12))"))
	_txt=REPLACE(_txt,"%(lvl1)級時",ColorText("%(lvl1)級時","color=%(ColorIdx(12))"))
	_txt=REPLACE(_txt,"橘花當前轉生等級：%(circle0)",ColorText("橘花當前轉生等級：%(circle0)","color=%(ColorIdx(13))"))
	_txt=REPLACE(_txt,"鬥和當前轉生等級：%(circle1)",ColorText("鬥和當前轉生等級：%(circle1)","color=%(ColorIdx(13))"))
	_txt
}
OnCircleIntro{
	'\_q當遊戲進行到後期因等級過高，傷害逐漸飽和很難進行一回和時，就得轉生了，轉生一次需要最低等級20級以上，轉生一次人物等級會降低，但相應屬性會比原有人物等級屬性更高，人物等級越高，轉生增加一級越容易，而轉生等級越高，轉生經驗所需就越高，但是轉生人物屬性提升越大,轉生不影響原有裝備，但怪物等級範圍也得到相應提升，轉生一次花費的金錢為10000，請酌情考慮是否轉生。\_q\x'
	--
	OpenRpgGameMenu(4)
}
OnCircle{
	_exp=exp0+GetExp(lvl0)
	_expcircle=GetExp(lvl0)-GetExp(lvl0-1)
	if TOINT(exptotaltemp0)==0
		_exp=exptotal0
	_expcircletemp=expcircle0//88250
	_circle=0
	_circle0=circle0
	if _expcircle>0&&_exp>TOINT(_circle){
		_expcircletemp+=_expcircle
		_circle=GetExp(20+10*_circle0)
		while _expcircletemp>_circle{
			_expcircletemp-=TOINT(_circle)
			_circle0++
			_circle=GetExp(20+10*_circle0)
		}
		_exp-=_expcircle
	}
	_level0=GetLevel(_exp)
	_expcircle0=_expcircle
	_exp=exp1+GetExp(lvl1)
	_expcircle=GetExp(lvl1)-GetExp(lvl1-1)
	if TOINT(expcircletotal1)==0
		_exp=exptotal1
	_expcircletemp=expcircle1
	_circle=0
	_circle0=circle0
	if _expcircle>0 && _exp>TOINT(_circle){
		_expcircletemp+=_expcircle
		_circle=GetExp(20+10*_circle0)
		while _expcircletemp>_circle{
			_expcircletemp-=TOINT(_circle)
			_circle0++
			_circle=GetExp(20+10*_circle0)
		}
		_exp-=_expcircle
	}
	_level1=GetLevel(_exp)
	_expcircle1=_expcircle
	"確定要轉生嗎？注意轉生後橘花等級會變成%(_level0)級，橘花可得修為%(_expcircle0)，鬥和等級會變成%(_level1)級，鬥和可得修為%(_expcircle1)\n/
	\q[◇是,OnCircleConfirm]\n/
	\q[◇否,OnCircleCancel]"
}
GetExpCircle{
	_circle=_argv[0]
	_exp=0
	while _circle>0{
		_exp+=GetExp(20+10*_circle)
		_circle--
	}
	_exp
}
OnCircleRecover{
	'確定要恢復嗎？注意轉生等級會置零。轉生丹帶來的效果將會消失（恢復為經驗），請慎重考慮！！！\n/
	\q[◇是,OnCircleRecoverConfirm]\n/
	\q[◇否,OnCircleCancel]'
}
Onlodging{
	"確定花%(100+5*(lvl0-1))金住宿？\n/
	\q[◇是,Onyeslodging]\n/
	\q[◇否,Onnotlodging]"
}
Onyeslodging{
	if money>=100+5*(lvl0-1){
		'橘花和鬥和休息了一晚上,體力和精力全恢復了\x'
		hp0=hpmax0
		ep0=epmax0
		hp1=hpmax1
		ep1=epmax1
		money-=100+5*(lvl0-1)
	}
	else
		'金額不足，不能住宿\x'
	--
	OpenRpgGameMenu(4)
}
Onnotlodging{
	OpenRpgGameMenu(4)
}
GetExp{
	_lvl=TOINT(_argv[0])
	_exp=0
	for _i=1;_i<_lvl;_i++{
		_exp+=10 * (_i + 1)*(_i + 1)
	}
	_exp
}
GetLevel{
	_i=0
	_exp=TOINT(_argv[0])
	_sum=0
	while _sum<_exp{
		_i++
		_sum+=10 * (_i + 1)*(_i + 1)
	}
	_i
}
OnCircleRecoverConfirm{
	if circle0>0{
		exptotal0+=expcircletotal0+expcircle0
		lvl0=GetLevel(exptotal0)
		expcircletotal0=0
		exptotaltemp0=0
		circle0=0
		expcircle0=0
		exp0=exptotal0%GetExp(lvl0)
		"恢復成功，當前橘花等級為%(lvl0)級\x"
	}
	else
		'橘花轉生等級為0，不能恢復\x'
	--
	if circle1>0{
		exptotal1+=expcircletotal1+expcircle1
		lvl1=GetLevel(exptotal1)
		expcircletotal1=0
		exptotaltemp1=0
		circle1=0
		expcircle1=0
		exp1=exptotal1%GetExp(lvl1)
		"恢復成功，當前鬥和等級為%(lvl1)級\x"
	}
	else
		'鬥和轉生等級為0，不能恢復\x'
	--
	OpenRpgGameMenu(4)
}
OnCircleTest{
	_exp=GetExp(_argv[0])
	_circle0=0
	while _exp>0{
		_exp-=GetExp(20+_circle0)
		_circle0++
	}
	_circle0
}
OnCircleConfirm{
	if TOINT(money)>=10000{
		if lvl0>=20{
			_expcircle=GetExp(lvl0)-GetExp(lvl0-1)
			_exp=exp0+GetExp(lvl0)
			_circle=0
			_n=0
			if _expcircle>0{
				expcircle0+=_expcircle
				_circle=GetExp(20+10*circle0)
				while expcircle0>TOINT(_circle){
					expcircle0-=TOINT(_circle)
					expcircletotal0=TOINT(expcircletotal0+_circle)
					circle0++
					_n=1
					_circle=GetExp(20+10*circle0)
				}
				_exp-=_expcircle
				expcircletotal0-=_expcircle
				money=TOINT(money-5000)
			}
			_expnext=_circle-expcircle0
			lvl0=GetLevel(_exp)
			exp0=_exp%GetExp(lvl0)
			if _n{
				"轉生成功，當前橘花轉生等級為%(circle0)級\x"
			}
			else
				"轉生失敗，還差%(_expnext)轉生修為繼續轉生，下級修為%(_circle)，當前橘花轉生等級為%(circle0)級\x"
		}
		else{
			'橘花轉生失敗，未達到20級，不能轉生\x'
		}
		--
		if lvl1>=20{
			_expcircle=GetExp(lvl1)-GetExp(lvl1-1)
			_exp=exp1+GetExp(lvl1)
			_circle=0
			_n=0
			if _expcircle>0{
				expcircle1+=_expcircle
				_circle=GetExp(20+10*circle1)
				while expcircle1>TOINT(_circle){
					expcircle1-=TOINT(_circle)
					expcircletotal1=TOINT(expcircletotal1+_circle)
					circle1++
					_n=1
					_circle=GetExp(20+10*circle1)
				}
				_exp-=_expcircle
				expcircletotal1-=_expcircle
				money=TOINT(money-5000)
			}
			_expnext=_circle-expcircle1
			lvl1=GetLevel(_exp)
			exp1=_exp%GetExp(lvl1)
			if _n{
				"轉生成功，鬥和轉生等級為%(circle1)級\x"
			}
			else
				"轉生失敗，還差%(_expnext)轉生修為繼續轉生，下級修為%(_circle)，鬥和轉生等級為%(circle1)級\x"
		}
		else{
			'鬥和轉生失敗，未達到20級，不能轉生\x'
		}
	}
	else{
		'轉生失敗，金錢不足，不能轉生，轉生一次花費的金錢為10000，請酌情考慮是否轉生。\x'
	}
	--
	OpenRpgGameMenu(4)
}
