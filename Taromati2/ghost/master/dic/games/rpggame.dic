On裝備菜單{
	equipmenu[reference0]=(TOINT(equipmenu[reference0])+1)%2
	OpenRpgGameMenu(1)
}
裝備{
	_txt = '\n'
	_txt+=資訊參數
	_txt+=RpgGameVar
	_txt+=超出反應
	_txt += "橘花                                    \_l[140,-]鬥和\n/
	武器：\q[%(weapon0),offweapon0]         \_l[140,-]武器：\q[%(weapon1),offweapon1]\n/
	防具（體）：\q[%(armor0),offarmor0]     \_l[140,-]防具（體）：\q[%(armor1),offarmor1]\n/
	防具（腳）：\q[%(boots0),offboots0]     \_l[140,-]防具（腳）：\q[%(boots1),offboots1]\n/
	"
	_weapon = (weaponA,weaponB)
	_armor = (armorA,armorB)
	_boots = (bootsA,bootsB)
	_txt+='\f[color,160,160,200]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]\__q[On裝備菜單,0]───────────武器───────────\__q\f[cursorstyle,default]\f[cursorfontcolor,default]\f[default]\n'
	if TOINT(equipmenu[0])==1{
		_txt += '名稱   \_l[65,-]數量    \_l[95,-]STR    \_l[125,-]ATS\n'
		foreach _weapon; _i{
			if _i[3] > 0{
				_txt += "\f[color,231,171,109]%(_i[2])\f[color,default]   \_l[65,-]%(_i[3])   \f[color,165,203,214]\_l[95,-]%(_i[6])  \_l[125,-]%(_i[7])    \f[color,default]"
				if !weapon0 {
					_txt += "\_l[160,-]\q[◇橘花未裝備,Onweapon0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7])]"
				}
				elseif weapon0 {
					if weaponID0==_i[1] && weaponsort0==_i[0]{
						_txt += "\_l[160,-]\f[color,231,171,109]\q[◇橘花已裝備,Onweapon0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7])]\f[color,default]"
					}
					else{
						_txt += "\_l[160,-]\q[◇橘花未裝備,Onweapon0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7])]"
					}
				}
				if !weapon1 {
					_txt += "\_l[230,-]\q[◇鬥和未裝備,Onweapon1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7])]\n"
				}
				elseif weapon1 {
					if weaponID1==_i[1] && weaponsort1==_i[0]{
						_txt += "\_l[230,-]\f[color,231,171,109]\q[◇鬥和已裝備,Onweapon1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7])]\f[color,default]\n"
					}
					else{
						_txt += "\_l[230,-]\q[◇鬥和未裝備,Onweapon1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7])]\n"
					}
				}
			}
		}
	}
	_txt+='\f[color,160,160,200]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]\__q[On裝備菜單,1]──────────防具（體）─────────\__q\f[cursorstyle,default]\f[cursorfontcolor,default]\f[default]\n'
	if TOINT(equipmenu[1])==1{
		_txt += '名稱   \_l[65,-]數量    \_l[95,-]DEF    \_l[125,-]ADF\n'
		foreach _armor; _i{
			if _i[3] > 0{
				_txt += "\f[color,231,171,109]%(_i[2])\f[color,default]   \_l[65,-]%(_i[3])   \f[color,165,203,214]\_l[95,-]%(_i[6])  \_l[125,-]%(_i[7])    \f[color,default]"
				if !armor0 {
					_txt += "\_l[160,-]\q[◇橘花未裝備,Onarmor0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]"
				}
				elseif armor0 {
					if armorID0==_i[1] && armorsort0==_i[0]{
						_txt += "\_l[160,-]\f[color,231,171,109]\q[◇橘花已裝備,Onarmor0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\f[color,default]"
					}
					else{
						_txt += "\_l[160,-]\q[◇橘花未裝備,Onarmor0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]"
					}
				}
				if !armor1 {
					_txt += "\_l[230,-]\q[◇鬥和未裝備,Onarmor1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\n"
				}
				elseif armor1 {
					if armorID1==_i[1] && armorsort1==_i[0]{
						_txt += "\_l[230,-]\f[color,231,171,109]\q[◇鬥和已裝備,Onarmor1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\f[color,default]\n"
					}
					else{
						_txt += "\_l[230,-]\q[◇鬥和未裝備,Onarmor1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\n"
					}
				}
			}
		}
	}
	_txt+='\f[color,160,160,200]\f[cursorstyle,none]\f[cursorfontcolor,65,203,214]\__q[On裝備菜單,2]──────────防具（腳）─────────\__q\f[cursorstyle,default]\f[cursorfontcolor,default]\f[default]\n'
	if TOINT(equipmenu[2])==1{
		_txt += '名稱   \_l[65,-]數量    \_l[95,-]DEF    \_l[125,-]ADF\n'
		foreach _boots; _i{
			if _i[3] > 0{
				_txt += "\f[color,231,171,109]%(_i[2])\f[color,default]   \_l[65,-]%(_i[3])   \f[color,165,203,214]\_l[95,-]%(_i[6])  \_l[125,-]%(_i[7])    \f[color,default]"
				if !boots0 {
					_txt += "\_l[160,-]\q[◇橘花未裝備,Onboots0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]"
				}
				elseif boots0 {
					if bootsID0==_i[1] && bootssort0==_i[0]{
						_txt += "\_l[160,-]\f[color,231,171,109]\q[◇橘花已裝備,Onboots0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\f[color,default]"
					}
					else{
						_txt += "\_l[160,-]\q[◇橘花未裝備,Onboots0,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]"
					}
				}
				if !boots1 {
					_txt += "\_l[230,-]\q[◇鬥和未裝備,Onboots1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\n"
				}
				elseif boots1 {
					if bootsID1==_i[1] && bootssort1==_i[0]{
						_txt += "\_l[230,-]\f[color,231,171,109]\q[◇鬥和已裝備,Onboots1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\f[color,default]\n"
					}
					else{
						_txt += "\_l[230,-]\q[◇鬥和未裝備,Onboots1,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[3]),%(_i[6]),%(_i[7]),%(_i[8]),%(_i[9])]\n"
					}
				}
			}
		}
	}
	_txt += '\n'
	_txt
}
Onweapon0{
	if weapon1==reference2 && reference3<=1
		"\0數量不足，先卸載，後裝備\x%(OpenRpgGameMenu(1))"
	else{
		weaponsort0=reference0
		weaponID0=reference1
		weapon0=reference2
		if weaponsort0=='weaponA'
			weaponequip_str0=TOINT(reference4)
		elseif weaponsort0=='weaponB'{
			weaponequip_str0=TOINT(1.2*reference4)
		}
		weaponequip_ats0=TOINT(reference5)
		OpenRpgGameMenu(1)
	}
}
Onweapon1{
	if weapon0==reference2 && reference3<=1
		"\0數量不足，先卸載，後裝備\x%(OpenRpgGameMenu(1))"
	else{
		weaponsort1=reference0
		weaponID1=reference1
		weapon1=reference2
		if weaponsort1=='weaponA'{
			weaponequip_ats1=TOINT(1.2*reference5)
		}
		elseif weaponsort1=='weaponB'{
			weaponequip_ats1=TOINT(reference5)
		}
		weaponequip_str1=TOINT(reference4)
		OpenRpgGameMenu(1)
	}
}
Onarmor0{
	if armor1==reference2 && reference3<=1
		"\0數量不足，先卸載，後裝備\x%(OpenRpgGameMenu(1))"
	else{
		armorsort0=reference0
		armorID0=reference1
		armor0=reference2
		armorequip_def0=reference4
		armorequip_adf0=reference5
		armorequip_str0=reference6
