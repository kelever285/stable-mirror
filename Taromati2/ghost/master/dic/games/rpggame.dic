				"%(怪物名字)正在準備魔法\x"
			}
			elseif c>=4 && c<=5{
				foreach 火系魔法; _i{
					if mlv>=TOINT(_i[5]){
						_mmagic,=_i
					}
				}
				_mmagic,=''
				x=ARRAYSIZE(_mmagic)-2
				if x>0{
					x=RAND(x)+1
				}
				反擊效果數值=_mmagic[x][7]
				反擊魔法名稱=_mmagic[x][2]
				MNUMS=_mmagic[x][8]
				反擊範圍=_mmagic[x][4]
				if _target==0
					mmagicready=0
				elseif _target==1
					mmagicready=1
				if 反擊範圍=='複體'&&hp0>0&&hp1>0
					mmagicready=2
				"%(怪物名字)正在準備魔法\x"
			}
			elseif c>=2 && c<=3{
				foreach 土系魔法; _i{
					if mlv>=TOINT(_i[5]){
						_mmagic,=_i
					}
				}
				_mmagic,=''
				x=ARRAYSIZE(_mmagic)-2
				if x>0{
					x=RAND(x)+1
				}
				反擊效果數值=_mmagic[x][7]
				反擊魔法名稱=_mmagic[x][2]
				MNUMS=_mmagic[x][8]
				反擊範圍=_mmagic[x][4]
				if 反擊效果數值=='完全防禦一次'{
					mdefend=1
					"%(怪物名字)發動了%(反擊魔法名稱)\x"
				}
				else{
					if _target==0
						mmagicready=0
					elseif _target==1
						mmagicready=1
					if 反擊範圍=='複體'&&hp0>0&&hp1>0
						mmagicready=2
					"%(怪物名字)正在準備魔法\x"
				}
			}
			elseif c>=0 && c<=1{
				foreach 風系魔法; _i{
					if mlv>=TOINT(_i[5]){
						_mmagic,=_i
					}
				}
				_mmagic,=''
				x=ARRAYSIZE(_mmagic)-2
				if x>0{
					x=RAND(x)+1
				}
				反擊效果數值=_mmagic[x][7]
				反擊魔法名稱=_mmagic[x][2]
				MNUMS=_mmagic[x][8]
				反擊範圍=_mmagic[x][4]
				if _target==0
					mmagicready=0
				elseif _target==1
					mmagicready=1
				if 反擊範圍=='複體'&&hp0>0&&hp1>0
					mmagicready=2
				"%(怪物名字)正在準備魔法\x"
			}
		}
	}
	elseif m>=40 && m<70 && (class=='S'||level>=2){
		if level==2&&class!='S'
			"\![raise,Onmspattack,1,%(_target)]"
		{
			if MANG!=2{
				"\![raise,Onmspattack,1,%(_target)]"
				"\![raise,Onmspattack,0,%(_target)]"
				"\![raise,Onmspattack,2,%(_target)]"
			}
			else{
				"\![raise,Onmspattack,1,%(_target)]"
			}
		}
		{
			if MANG!=2{
				"\![raise,Onmspattack,1,%(_target)]"
				"\![raise,Onmspattack,3,%(_target)]"
				"\![raise,Onmspattack,4,%(_target)]"
			}
			else{
				"\![raise,Onmspattack,1,%(_target)]"
			}
		}
		return
	}
	elseif m>=70 && m<80 && (class=='S'||level>=2)&&mhp<=0.3*mhpmax{
		if MANG!=2{
			"\![raise,Onmspattack,1,%(_target)]"
			"\![raise,Onmspattack,6,%(_target)]"
			"\![raise,Onmspattack,5,%(_target)]"
		}
		else{
			"\![raise,Onmspattack,1,%(_target)]"
		}
		return
	}
	elseif m>=0 && m<10 && mlv>=15&&_target==0{
		怪傷害0 = TOINT(1.5*MANG*(3.9*mstr-2.82*def0))
		if 怪傷害0<0{
			怪傷害0=0
		}
		if kikkadefend==1;{
			怪傷害0=0
			kikkadefend=0
		}
		hp0 -= 怪傷害0
		"\0\s[33]%(怪物名字)對橘花發動會心一擊，橘花損血%(怪傷害0)\x"
	}
	elseif m>=0 && m<10 && mlv>=15&&_target==1{
		怪傷害1 = TOINT(1.5*MANG*(3.9*mstr-2.82*def1))
		if 怪傷害1<0{
			怪傷害1=0
		}
		if towadefend==1;{
			怪傷害1=0
			towadefend=0
		}
		hp1 -= 怪傷害1
		"%(怪物名字)對鬥和發動會心一擊，鬥和損血%(怪傷害1)\x"
	}
	else{
		if _target==0{
			怪傷害0 = TOINT(MANG*(3.9*mstr-2.82*def0))
			if 怪傷害0<0{
				怪傷害0=0
			}
			if kikkadefend==1;{
				怪傷害0=0
				kikkadefend=0
			}
			hp0 -= 怪傷害0
			"\0\s[33]橘花被攻擊了，損血%(怪傷害0)\x"
		}
		elseif _target==1{
			怪傷害1 = TOINT(MANG*(3.9*mstr-2.82*def1))
			if 怪傷害1<0{
				怪傷害1=0
			}
			if towadefend==1;{
				怪傷害1=0
				towadefend=0
			}
			hp1 -= 怪傷害1
			"鬥和被攻擊了，損血%(怪傷害1)\x"
		}
	}
	--
	Onbattleselect
	--
	battleinfo
}
Onmspattack{
	戰技ID=reference0
	_target=TOINT(reference1)
	if hp0<=0
		指定人格='鬥和'
	elseif hp1<=0
		指定人格='橘花'
	else
		指定人格='橘花和鬥和'
	if 戰技ID==0{
		MSTRADD=1.5
		威脅回合=3
		"%(怪物名字)使用了威脅，%(怪物名字)STR提升50%。\x"
	}
	elseif 戰技ID==1{
		if _target==0{
			戰技傷害=TOINT(MANG*2*(3.9*mstr-2.82*def0))
			if 戰技傷害<0
				戰技傷害=0
			if kikkadefend==1;{
				戰技傷害=0
				kikkadefend=0
			}
			hp0-=戰技傷害
			指定人格='橘花'
		}
		elseif _target==1{
			戰技傷害=TOINT(MANG*2*(3.9*mstr-2.82*def1))
			if 戰技傷害<0
				戰技傷害=0
			if towadefend==1;{
				戰技傷害=0
				towadefend=0
			}
			hp1-=戰技傷害
			指定人格='鬥和'
		}
		"%(怪物名字)對%(指定人格)使用了雙連擊，%(指定人格)損血%(戰技傷害)\x"
	}
	elseif 戰技ID==2{
		MDEFADD=1.5
		挑逗回合=3
		"%(怪物名字)使用了挑逗，DEF提升50%。\x"
	}
	elseif 戰技ID==3{
		IGN=0
		忽略回合=1
		"%(怪物名字)使用了忽略，%(指定人格)DEF被無視了。\x"
	}
	elseif 戰技ID==4{
		DEFMINUS=0.5
		敵視回合=3
		"%(怪物名字)使用了敵視，%(指定人格)DEF降低50%。\x"
	}
	elseif 戰技ID==5{
		MANG=2
		憤怒暴發回合=1
		"%(怪物名字)使用了憤怒暴發\x"
	}
	elseif 戰技ID==6{
		禁寂之音回合=3
		SILENT=1
		"%(怪物名字)使用了禁寂之音，%(指定人格)被封技了\x"
	}
	--
	RpgGameVar
	怪物屬性
	--
	Onbattleselect
	--
	battleinfo
}
怪物屬性{
	if class=='D'{
		mstr=mstrD
		mdef=mdefD
	}
	elseif class=='C'{
		mstr=mstrC
		mdef=mdefC
	}
	elseif class=='B'{
		mstr=mstrB
		mdef=mdefB
	}
	elseif class=='A'{
		mstr=mstrA
		mdef=mdefA
	}
	elseif class=='S'{
		mstr=mstrS
		mdef=mdefS
	}
}
怪物戰技回合判定{
	if 威脅回合>0{
		威脅回合--
	}
	elseif 威脅回合==0{
		威脅回合=-1
		--
		MSTRADD=1
		"%(怪物名字)使用的威脅技能失效了\x"
	}
	--
	if 挑逗回合>0{
		挑逗回合--
	}
	elseif 挑逗回合==0{
		挑逗回合=-1
		--
		MDEFADD=1
		"%(怪物名字)使用的挑逗技能失效了\x"
	}
	--
	if 忽略回合>0{
		忽略回合--
	}
	elseif 忽略回合==0{
		忽略回合=-1
		--
		IGN=1
		"%(怪物名字)使用的忽略技能失效了\x"
	}
	--
	if 敵視回合>0{
		敵視回合--
	}
	elseif 敵視回合==0{
		敵視回合=-1
		--
		DEFMINUS=1
		"%(怪物名字)使用的敵視技能失效了\x"
	}
	--
	if 禁寂之音回合>0{
		禁寂之音回合--
	}
	elseif 禁寂之音回合==0{
		禁寂之音回合=-1
		--
		SILENT=0
		"%(怪物名字)使用的禁寂之音技能失效了\x"
	}
	--
	RpgGameVar
	怪物屬性
}
戰鬥結束{
	battlemode=2
	if mhp <= 0{
		mhp = 0
	}
	if hp0==0{
		hp0=TOINT(0.1*hpmax0)
	}
	if hp1==0{
		hp1=TOINT(0.1*hpmax1)
	}
	--
	intimacy+=1
	victorynum+=1
	mnum+=1
	_reward=bosslevel*level*mlv*bata
	money+=TOINT(4*_reward)
	exp0+=TOINT(2*_reward)
	exptotal0+=TOINT(2*_reward)
	exp1+=TOINT(2*_reward)
	exptotal1+=TOINT(2*_reward)
	_luck=nurturance.subvar.Luck
	if level==4{
		w=RAND(50)
	}
	elseif level==5{
		w=RAND(40)
	}
	elseif level==6{
		w=RAND(30)
	}
	elseif level==7{
		w=RAND(20)
	}
	else{
		_k=1
		if _luck<=-1{
			_k=-1
			_luck*=_k
		}
		if class=='D'
			j=400-_k*log(1.04,_luck+1)
		elseif class=='C'
			j=300-_k*log(1.05,_luck+1)
		elseif class=='B'
			j=200-_k*log(1.07,_luck+1)
		elseif class=='A'
			j=100-_k*log(1.16,_luck+1)
		elseif class=='S'
			j=50-_k*log(1.35,_luck+1)
		w=RAND(j/level)
	}
	--
	if w>10 && w<=20{
		i=RAND(10)
		if i>=5{
			if mlv<80{
				i=RAND(mlv/16)
				"獲得%(itemA[i][2])\n"
			}
			else{
				_a=ARRAYSIZE(itemA)
				if mlv<100
					_a=5
				i=RAND(_a)
				"獲得%(itemA[i][2])\n"
			}
			itemAnum[i]=TOINT(itemAnum[i]+1)
		}
		elseif i<5{
			if mlv<80{
				i=RAND(mlv/20)
				"獲得%(itemB[i][2])\n"
			}
			else{
				i=RAND(4)
				"獲得%(itemB[i][2])\n"
			}
			itemBnum[i]=TOINT(itemBnum[i]+1)
		}
	}
	elseif w>6 && w<=10{
		if mlv<130{
			i=RAND(2+mlv/10)
			"獲得%(bootsB[i][2])\n"
		}
		else{
			i=RAND(14)
			"獲得%(bootsB[i][2])\n"
		}
		bootsBnum[i]=TOINT(bootsBnum[i]+1)
	}
	elseif w>2 && w<=6{
		if mlv<130{
			i=RAND(2+mlv/5)
			"獲得%(weaponB[i][2])\n"
		}
		else{
			i=RAND(29)
			"獲得%(weaponB[i][2])\n"
		}
		weaponBnum[i]=TOINT(weaponBnum[i]+1)
	}
	elseif w<=2{
		if mlv<126{
			i=RAND(2+mlv/7)
			"獲得%(armorB[i][2])\n"
		}
		else{
			i=RAND(19)
			"獲得%(armorB[i][2])\n"
		}
		armorBnum[i]=TOINT(armorBnum[i]+1)
	}
	--
	"橘花獲得經驗%(TOINT(2*_reward))，鬥和獲得經驗%(TOINT(2*_reward))\n"
	--
	"獲得金錢%(TOINT(4*_reward))\n"
	--
	橘花升級+鬥和升級
	--
	if mnum<10{
		'\t\0\q[◇繼續逛,Onbattle]\n/
		\q[◇休息一下,On休息]\n/
		\q[◇回去吧,back]'
	}
	elseif mnum>=10{
		award=1
		'任務完成,回去領取獎勵？\n/
		\q[◇回去吧,back]\n/
		\q[◇繼續逛,Onbattle]'
	}
	--
	battleinfo
}
Select.back{
	OpenRpgGameMenu(5)
}
橘花升級{
	nextexp0 = expmax0 - exp0
	_txt=''
	while nextexp0<=0{
		nextexp_0=nextexp0
		lvl0 += 1
		exp0 = -nextexp_0
		RpgGameVar
		hp0=hpmax0
		ep0=epmax0
		_txt+="\0\s[5]橘花升級了！\n\w9目前等級：%(lvl0)\n"
		_魔法0 = (水系魔法,火系魔法,土系魔法,風系魔法)
		foreach _魔法0; _i{
			if lvl0==TOINT(_i[5]){
				_txt+="\0\s[5]橘花學得新魔法%(_i[2])\n"
			}
		}
		foreach 戰技0; _i{
			if lvl0==TOINT(_i[4]){
				_txt+="\0\s[5]橘花學得新戰技%(_i[1])\n"
			}
		}
		nextexp0 = expmax0 - exp0
	}
	_txt
}
鬥和升級{
	nextexp1 = expmax1 - exp1
	_txt=''
	while nextexp1<=0{
		nextexp_1=nextexp1
		lvl1 += 1
		exp1 = -nextexp_1
		RpgGameVar
		hp1=hpmax1
		ep1=epmax1
		_txt+="\0\s[5]鬥和升級了！\n\w9目前等級：%(lvl1)\n"
		_魔法1 = (水系魔法,火系魔法,土系魔法,風系魔法)
		foreach _魔法1; _i{
			if lvl1==TOINT(_i[5]){
				_txt+="鬥和學得新魔法%(_i[2])\n"
			}
		}
		foreach 戰技1; _i{
			if lvl1==TOINT(_i[4]){
				_txt+="\0\s[5]鬥和學得新戰技%(_i[1])\n"
			}
		}
		nextexp1 = expmax1 - exp1
	}
	_txt
}
Onesc{
	'\0\s[40]確定退出冒險嗎？\n/
	\q[◇是,yesesc]\n/
	\q[◇否,noesc]'
}
Select.yesesc{
	ClearRpgGameVar
	--
	OpenMenu(2)
}
Select.noesc{
	OpenRpgGameMenu(5)
}
On休息{
	battlemode=2
	'\0休息一下回復體力吧，接下來要做什麼呢？\n/
	\q[◇吸煙,smoke]\n/
	\q[◇使用道具,On道具列表]\n/
	\q[◇使用魔法,On魔法列表]\n/
	\q[◇繼續逛,Onbattle]\n/
	\q[◇回去吧,back]'
	--
	battleinfo
}
