Onbuy{
	if reference4==NULL && reference5==NULL{
		"\0\s[40]確定花%(reference3)購買%(reference2)？\n/
		\q[◇是,Onbuy,%(reference0),%(reference1),%(reference2),%(reference3),＆,1]\n/
		\q[◇否,Onbuy,%(reference0),%(reference1),%(reference2),%(reference3),＆,0]"
	}
	if reference4=='＆' && reference5==1{
		if money>=TOINT(reference3){
			if reference0=='weaponA'{
				weaponAnum[reference1]=TOINT(weaponAnum[reference1]+1)
				money-=TOINT(reference3)
				"\0\s[5]購買成功,花費%(TOINT(reference3))金\x"
			}
			elseif reference0=='armorA'{
				armorAnum[reference1]=TOINT(armorAnum[reference1]+1)
				money-=TOINT(reference3)
				"\0\s[5]購買成功,花費%(TOINT(reference3))金\x"
			}
			elseif reference0=='bootsA'{
				bootsAnum[reference1]=TOINT(bootsAnum[reference1]+1)
				money-=TOINT(reference3)
				"\0\s[5]購買成功,花費%(TOINT(reference3))金\x"
			}
		}
		else{
			'金錢不足，購買失敗\x'
		}
		--
		--
		OpenRpgGameMenu(4)
	}
	elseif reference4=='＆' && reference5==0{
		OpenRpgGameMenu(4)
	}
}
Onsellnum{
	物品種類=reference0
	物品代碼=reference1
	物品名稱=reference2
	物品價格=reference3
	if reference4==''&&(物品名稱==weapon0||物品名稱==armor0||物品名稱==boots0||物品名稱==weapon1||物品名稱==armor1||物品名稱==boots1){
		"當前%(物品名稱)正在裝備，確定要賣出嗎？\n/
		\q[◇是,Onsellnum,%(物品種類),%(物品代碼),%(物品名稱),%(物品價格),yes]\n/
		\q[◇不用了,Onsellnum,%(物品種類),%(物品代碼),%(物品名稱),%(物品價格),no]"
	}
	elseif reference4=='yes'
		'請輸入賣出數量\n\![open,inputbox,Onsell]\n[300]\q[◇取消,cancelshop]'
	elseif reference4=='no'
		OpenRpgGameMenu(4)
	else
		'請輸入賣出數量\n\![open,inputbox,Onsell]\n[300]\q[◇取消,cancelshop]'
}
Select.cancelshop{
	OpenRpgGameMenu(4)
}
Onsell{
	if reference0<=0{
		'請輸入大於0的數位\![open,inputbox,Onsell]'
	}
	else{
		賣出數量=reference0
		if reference5==NULL && reference6==NULL{
			"確定以%(物品價格)的單價賣出%(賣出數量)件%(物品名稱)？\n/
			\q[◇是,Onsell,%(賣出數量),%(物品種類),%(物品代碼),%(物品名稱),%(物品價格),＆,1]\n/
			\q[◇否,Onsell,%(賣出數量),%(物品種類),%(物品代碼),%(物品名稱),%(物品價格),＆,0]"
		}
		if reference5=='＆' && reference6==1{
			if reference1=='weaponA'{
				if weaponAnum[reference2]>=賣出數量{
					weaponAnum[reference2]=TOINT(weaponAnum[reference2]-賣出數量)
					"賣出成功,得到%(TOINT(物品價格*賣出數量))金\x"
					money+=TOINT(物品價格*賣出數量)
				}
				else{
					'數量不足,賣出失敗\x'
				}
			}
			elseif reference1=='weaponB'{
				if weaponBnum[reference2]>=賣出數量{
					weaponBnum[reference2]=TOINT(weaponBnum[reference2]-賣出數量)
					"賣出成功,得到%(TOINT(物品價格*賣出數量))金\x"
					money+=TOINT(物品價格*賣出數量)
				}
				else{
					"%(TOINT(reference2))數量不足,賣出失敗\x"
				}
			}
			if reference1=='armorA'{
				if armorAnum[reference2]>=賣出數量{
