Select.escape{
	escapenum+=1
	e=RAND(100)
	if e < 50{
		'\0\s[5]逃跑成功。\x'
		--
		OpenRpgGameMenu(5)
	}
	elseif e >= 50{
		'\0\s[9]逃跑失敗。\x'
		--
		怪物反擊
	}
}
怪物反擊{
	怪物戰技回合判定
	--
	if mhp>0{
		if mmagicready==0{
			怪物準備魔法0
		}
		elseif mmagicready==1{
			怪物準備魔法1
		}
		elseif mmagicready==2{
			怪物準備魔法2
		}
		else{
			_temp = RAND(100)
			if (_temp <= 50 && hp0>0) || hp1==0{
				反擊(0)
			}
			elseif (_temp > 50 && hp1>0) || hp0==0{
				反擊(1)
			}
		}
	}
	else{
		'\0\s[5]戰鬥勝利了\x'
		--
		戰鬥結束
	}
	--
	battleinfo
}
怪物準備魔法0{
	mmagicready=-1
	_魔法傷害=TOINT(MNUMS*MANG*(4.10*mats-2.80*adf0+反擊效果數值))
	if _魔法傷害<0{
		_魔法傷害=0
	}
	反擊魔法傷害=_魔法傷害
	if kikkadefend==1;{
		反擊魔法傷害=0
		kikkadefend=0
	}
	hp0-=反擊魔法傷害
	"\0\s[33]%(怪物名字)對橘花發動了%(反擊魔法名稱)，橘花損血%(反擊魔法傷害)\x"
	--
	Onbattleselect
}
怪物準備魔法1{
	mmagicready=-1
	_魔法傷害=TOINT(MNUMS*MANG*(4.10*mats-2.80*adf0+反擊效果數值))
	if _魔法傷害<0{
		_魔法傷害=0
	}
	反擊魔法傷害=_魔法傷害
	if towadefend==1;{
		反擊魔法傷害=0
		towadefend=0
	}
	hp1-=反擊魔法傷害
	"\0%(怪物名字)對鬥和發動了%(反擊魔法名稱)，鬥和損血%(反擊魔法傷害)\x"
	--
	Onbattleselect
}
怪物準備魔法2{
	mmagicready=-1
	"\0\s[33]%(怪物名字)發動了%(反擊魔法名稱)，"
	--
	_魔法傷害=TOINT(MNUMS*MANG*(4.10*mats-2.80*adf0+反擊效果數值))
	if _魔法傷害<0{
		_魔法傷害=0
	}
	反擊魔法傷害=_魔法傷害
	if kikkadefend==1;{
		反擊魔法傷害=0
		kikkadefend=0
	}
	hp0-=反擊魔法傷害
	"橘花損血%(反擊魔法傷害)，"
	--
	_魔法傷害=TOINT(MNUMS*MANG*(4.10*mats-2.80*adf1+反擊效果數值))
	if _魔法傷害<0{
		_魔法傷害=0
	}
	反擊魔法傷害=_魔法傷害
	if towadefend==1;{
		反擊魔法傷害=0
		towadefend=0
	}
	hp1-=反擊魔法傷害
	"鬥和損血%(反擊魔法傷害)\x"
	--
	Onbattleselect
}
反擊{
	_target=_argv[0]
	_mmagic=IARRAY
	m=RAND(100)
	if m>=10 && m<40 && mlv>=15{
		if level==1 || level==1.1 || level==1.2{
			c=RAND(9)
			if c>=5{
				foreach 土系魔法; _i{
					if mlv>=TOINT(_i[5]){
						_mmagic,=_i
					}
				}
				_mmagic,=''
				x=ARRAYSIZE(_mmagic)-2
				if x>0{
					x=RAND(x)+1
				}
				反擊效果數值=_mmagic[x][7]
				反擊魔法名稱=_mmagic[x][2]
				MNUMS=_mmagic[x][8]
				反擊範圍=_mmagic[x][4]
				if 反擊效果數值=='完全防禦一次'{
					mdefend=1
					"%(怪物名字)發動了%(反擊魔法名稱)\x"
				}
				else{
					if _target==0
						mmagicready=0
					elseif _target==1
						mmagicready=1
					if 反擊範圍=='複體'&&hp0>0&&hp1>0
						mmagicready=2
					"%(怪物名字)正在準備魔法\x"
				}
			}
			else{
				foreach 風系魔法; _i{
					if mlv>=TOINT(_i[5]){
						_mmagic,=_i
					}
				}
				_mmagic,=''
				x=ARRAYSIZE(_mmagic)-2
				if x>0{
					x=RAND(x)+1
				}
				反擊效果數值=_mmagic[x][7]
				反擊魔法名稱=_mmagic[x][2]
				MNUMS=_mmagic[x][8]
				反擊範圍=_mmagic[x][4]
				if _target==0
					mmagicready=0
				elseif _target==1
					mmagicready=1
				if 反擊範圍=='複體'&&hp0>0&&hp1>0
					mmagicready=2
				"%(怪物名字)正在準備魔法\x"
			}
		}
		elseif level==1.3 || level==1.5{
			foreach 水系魔法; _i{
				if mlv>=TOINT(_i[5]) && _i[3]=='攻擊'{
					_mmagic,=_i
				}
			}
			_mmagic,=''
			x=ARRAYSIZE(_mmagic)-2
			if x>0{
				x=RAND(x)+1
			}
			反擊效果數值=_mmagic[x][7]
			反擊魔法名稱=_mmagic[x][2]
			MNUMS=_mmagic[x][8]
			反擊範圍=_mmagic[x][4]
			if _target==0
				mmagicready=0
			elseif _target==1
				mmagicready=1
			if 反擊範圍=='複體'&&hp0>0&&hp1>0
				mmagicready=2
			"%(怪物名字)正在準備魔法\x"
		}
		elseif level==1.4{
			foreach 火系魔法; _i{
				if mlv>=TOINT(_i[5]){
					_mmagic,=_i
				}
			}
			_mmagic,=''
			x=ARRAYSIZE(_mmagic)-2
			if x>0{
				x=RAND(x)+1
			}
			反擊效果數值=_mmagic[x][7]
			反擊魔法名稱=_mmagic[x][2]
			MNUMS=_mmagic[x][8]
			反擊範圍=_mmagic[x][4]
			if _target==0
				mmagicready=0
			elseif _target==1
				mmagicready=1
			if 反擊範圍=='複體'&&hp0>0&&hp1>0
				mmagicready=2
			"%(怪物名字)正在準備魔法\x"
		}
		elseif level==1.6{
			foreach 風系魔法; _i{
				if mlv>=TOINT(_i[5]){
					_mmagic,=_i
				}
			}
			_mmagic,=''
			x=ARRAYSIZE(_mmagic)-2
			if x>0{
				x=RAND(x)+1
			}
			反擊效果數值=_mmagic[x][7]
			反擊魔法名稱=_mmagic[x][2]
			MNUMS=_mmagic[x][8]
			反擊範圍=_mmagic[x][4]
			if _target==0
				mmagicready=0
			elseif _target==1
				mmagicready=1
			if 反擊範圍=='複體'&&hp0>0&&hp1>0
				mmagicready=2
			"%(怪物名字)正在準備魔法\x"
		}
		else{
			c=RAND(9)
			if c>=8 && c<=9{
				foreach 水系魔法; _i{
					if mlv>=TOINT(_i[5]) && _i[3]=='回復'{
						_mmagic,=_i
					}
				}
				_mmagic,=''
				x=ARRAYSIZE(_mmagic)-2
				if x>0{
					x=RAND(x)+1
				}
				反擊效果數值=TOINT(_mmagic[x][7])
				if _mmagic[x][7]=='戰鬥不能解除' || _mmagic[x][7]=='HP全回復'{
					怪傷害0 = TOINT(3.9*mstr-2.82*def0)
					if 怪傷害0<0{
						怪傷害0=0
					}
					if kikkadefend==1;{
						怪傷害0=0
						kikkadefend=0
					}
					hp0 -= 怪傷害0
					"\0\s[33]橘花被攻擊了，損血%(怪傷害0)\x"
				}
				elseif mhp + 反擊效果數值>=mhpmax{
					mhp=mhpmax
					"%(怪物名字)發動了%(_mmagic[x][2])，HP回復%(mhpmax-mhp)\x"
				}
				elseif mhp + 反擊效果數值<mhpmax{
					mhp+=反擊效果數值
					"%(怪物名字)發動了%(_mmagic[x][2])，HP回復%(反擊效果數值)\x"
				}
			}
			elseif c>=6 && c<=7{
				foreach 水系魔法; _i{
					if mlv>=TOINT(_i[5]) && _i[3]=='攻擊'{
						_mmagic,=_i
					}
				}
				_mmagic,=''
				x=ARRAYSIZE(_mmagic)-2
				if x>0{
					x=RAND(x)+1
				}
				反擊效果數值=_mmagic[x][7]
				反擊魔法名稱=_mmagic[x][2]
				MNUMS=_mmagic[x][8]
				反擊範圍=_mmagic[x][4]
				if _target==0
					mmagicready=0
				elseif _target==1
					mmagicready=1
				if 反擊範圍=='複體'&&hp0>0&&hp1>0
