	foreach weaponA; _i {
		if lvl>=TOINT(_i[4]-10){
			_txt += "\f[color,231,171,109]\_l[0,-]%(_i[2])\f[color,default] \f[color,165,203,214]\_l[65,-]%(_i[6])   \_l[110,-]%(_i[7])\f[color,default]  \f[color,231,171,109]\_l[155,-]%(_i[5])\f[color,default]  \_l[210,-]%(_i[3]) \_l[260,-] \q[◇購買,Onbuy,%(_i[0]),%(_i[1]),%(_i[2]),%(_i[5])]\n"
