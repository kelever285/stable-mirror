				ep1+=效果數值
				"橘花對鬥和使用了%(道具名稱),EP回復%(效果數值)\x"
				itemBnum[道具代碼]-=1
			}
		}
	}
	elseif hp1==0{
		if 道具類型=='itemA'{
			if reference3=='戰鬥不能解除'{
				"橘花對鬥和使用了%(道具名稱),鬥和恢復戰鬥能力，並且HP回復%(hpmax1-hp1)\x"
				hp1=hpmax1
				itemAnum[道具代碼]-=1
			}
		}
		else{
			"不能對失去戰鬥能力鬥和使用%(道具名稱)\x"
			--
			Onbattleselect0
			return
		}
	}
	--
	if hp0>0{
		Onbattleselect
	}
	else{
		怪物反擊
	}
}
Ontowauseitem0{
	道具類型=reference0
	道具代碼=reference1
